<div class="d-flex flex-row">
  @if (Bool)
  {
    <RadzenIcon Icon="radio_button_checked" />
  }
  else
  {
    <RadzenIcon Icon="radio_button_unchecked" />
  }
  <span>@Label</span>
</div>
@code {
  [Parameter]
  public bool Bool { get; set; }

  [Parameter]
  public string Label { get; set; } = string.Empty;
}
