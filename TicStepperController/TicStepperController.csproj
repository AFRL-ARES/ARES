<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Proto\StepMode.proto" />
    <None Remove="Proto\StepperControllerConfig.proto" />
    <None Remove="Proto\StepperControllerRpc.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ares.Device.Serial.dll" Version="2024.6.14.134257" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\StepperControllerRpc.proto">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
    <Protobuf Include="Proto\StepMode.proto" GrpcServices="None">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
    <Protobuf Include="Proto\StepperControllerConfig.proto" GrpcServices="None">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

</Project>
