<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Proto\StepMode.proto" />
    <None Remove="Proto\StepperControllerConfig.proto" />
    <None Remove="Proto\StepperControllerRpc.proto" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="StepperController\BoolVisualizer.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="StepperController\SimpleDataDisplay.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="StepperController\StepperControllerConfigEditView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="StepperController\StepperControllerSettingsListView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="StepperController\StepperControllerSettingsView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="StepperController\StepperControllerWidgetView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ares.Device.Serial\AresSerial\Ares.Device.Serial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\StepperControllerRpc.proto">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
    <Protobuf Include="Proto\StepMode.proto" GrpcServices="None">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
    <Protobuf Include="Proto\StepperControllerConfig.proto" GrpcServices="None">
      <ProtoRoot>Proto</ProtoRoot>
    </Protobuf>
  </ItemGroup>

</Project>
