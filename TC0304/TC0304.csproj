<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyVersion>0.0.10</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Proto\DataModel.proto" />
    <None Remove="Proto\Services.proto" />
    <None Remove="Proto\Tc0304Config.proto" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tc0304\DataloggerSettingsList.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Tc0304\DataloggerSettingsView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Tc0304\Tc0304ConfigEditView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Tc0304\Tc0304ControlWidgetView.razor">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="UnitsNet" Version="5.75.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\Tc0304Config.proto" GrpcServices="None" />
    <Protobuf Include="Proto\DataModel.proto" GrpcServices="None" />
    <Protobuf Include="Proto\Services.proto" ProtoRoot="Proto" />
  </ItemGroup>

</Project>
