@using UI.Application.Notifications
@inherits ReactiveUI.Blazor.ReactiveComponentBase<VerdiLaserSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService


<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.LaserConfig.Name">
  <div>
    @if (ViewModel!.LaserConfig.Simulated)
    {
      <span> Simulated Verdi Laser -- </span>
    }

    <span>@ViewModel!.LaserConfig.Name</span>
    <span>@ViewModel!.LaserConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
    private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Verdi Laser", ds =>
      @<VerdiLaserConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.LaserConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

}


