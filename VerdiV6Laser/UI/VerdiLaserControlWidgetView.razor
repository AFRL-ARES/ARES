@using VerdiV6Laser.UI
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<VerdiLaserUnitControlViewModel>

<RadzenCard Class="rz-p-4 rz-mb-4 rz-border-radius-2" Style="max-width: 600px;">
  <RadzenText Text="@ViewModel!.DeviceName" TextAlign="TextAlign.Center" TextStyle="TextStyle.DisplayH6" Class="rz-mb-4 rz-color-primary" />

  <RadzenRow Gap="2rem">
    <RadzenColumn Size="12" SizeMD="6">
      <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="rz-mb-3 rz-color-secondary">Power Settings</RadzenText>

      <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" AlignItems="AlignItems.Stretch">
        <RadzenFormField Text="Laser Power" Variant="Variant.Outlined">
          <Start>
            <RadzenIcon Icon="bolt" />
          </Start>
          <ChildContent>
            <RadzenNumeric @bind-Value="ViewModel!.DesiredLaserPower" ShowUpDown="false" />
          </ChildContent>
        </RadzenFormField>

        <RadzenButton Icon="save"
                      BusyText="Saving..."
                      Text="Save Power Level"
                      IsBusy="@ViewModel!.IsSavingPowerLevel"
                      Click="@ViewModel!.SetLaserPower"
                      ButtonStyle="ButtonStyle.Primary" />
      </RadzenStack>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="6">
      <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" Class="rz-mb-3 rz-color-secondary">Laser Controls</RadzenText>

      <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" AlignItems="AlignItems.Stretch">
        <RadzenToggleButton Text="@(ViewModel!.LaserOn ? "Deactivate Laser" : "Activate Laser")"
                            Icon="power_settings_new"
                            ButtonStyle="ButtonStyle.Success"
                            ToggleButtonStyle="ButtonStyle.Danger"
                            @bind-Value="ViewModel!.LaserOn" />

        <RadzenToggleButton Text="@(ViewModel!.IsLaserShutterOn ? "Close Shutter" : "Open Shutter")"
                            Icon="camera"
                            ToggleIcon="camera"
                            ButtonStyle="ButtonStyle.Light"
                            ToggleButtonStyle="ButtonStyle.Warning"
                            @bind-Value="ViewModel!.IsLaserShutterOn" />
      </RadzenStack>
    </RadzenColumn>
  </RadzenRow>
</RadzenCard>