<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>true</GenerateDependencyFile>

		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ARES.Datamodel" Version="0.17.0-beta.27" />
		<PackageReference Include="Radzen.Blazor" Version="9.1.0" />
		<PackageReference Include="ReactiveUI.Blazor" Version="23.1.1" />
		<PackageReference Include="ReactiveUI.SourceGenerators" Version="2.6.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.IO.Ports" Version="10.0.3" />
		<PackageReference Include="System.Reactive" Version="6.1.0" />
		<PackageReference Include="UnitsNet" Version="5.75.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../Ares.Toolkit.Device/Ares.Toolkit.Device/Ares.Toolkit.Device.csproj" />
		<ProjectReference Include="../../Ares.Toolkit.Serial/Ares.Toolkit.Serial/Ares.Toolkit.Serial.csproj">
			<Private>true</Private>
			<CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
		</ProjectReference>
	</ItemGroup>

	<Target Name="PackageAresDriver" AfterTargets="Build">
		<PropertyGroup>
			<StagingFolder>$(ProjectDir)obj\AresStaging\</StagingFolder>
			<PackageName>$(ProjectDir)bin\$(Configuration)\$(AssemblyName).ares</PackageName>
		</PropertyGroup>

		<ItemGroup>
			<ScopedCssBundle Include="$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css" Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css')" />
		</ItemGroup>

		<Copy SourceFiles="@(ScopedCssBundle)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(ScopedCssBundle)' != ''" />

		<RemoveDir Directories="$(StagingFolder)" />
		<MakeDir Directories="$(StagingFolder);$(StagingFolder)bin" />

		<Copy SourceFiles="manifest.yaml" DestinationFolder="$(StagingFolder)" />

		<ItemGroup>
			<AllOutputFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)Ares.Device.dll;$(TargetDir)Ares.Datamodel.dll;$(TargetDir)obj\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(AllOutputFiles)" DestinationFiles="@(AllOutputFiles->'$(StagingFolder)bin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

		<ZipDirectory SourceDirectory="$(StagingFolder)" DestinationFile="$(PackageName)" Overwrite="true" />
		<RemoveDir Directories="$(StagingFolder)" />
	</Target>
</Project>
