@using AlicatMFCRemastered.Enums
@using AlicatMFCRemastered.UI
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<MfcUnitControlViewModel>

<div class="mfc-container m-0 p-0">
  <div class="mfc-id">
    [@ViewModel!.AlicatState.Id]
  </div>
  <div class="mfc-title">
    @ViewModel!.Device.Name
  </div>

  @if(ViewModel!.HasValidData)
  {
    <div class="mfc-gas">
      @(ViewModel!.AlicatState.ActiveGas)
    </div>
    <div class="mfc-state">
      <div class="field-descriptor">Temperature</div>
      <div>@($"{ViewModel!.AlicatState.LiveData.Temperature}")</div>
      @if(ViewModel!.AlicatState.LiveData.AbsolutePressure is not null)
      {
        <div></div> <div class="field-descriptor">Absolute Pressure</div>
        <div>@($"{ViewModel!.AlicatState.LiveData.AbsolutePressure}")</div>
        <RadzenButton Text="Tare" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click="@(() => ViewModel.TareAbsolutePressureWithBarometerCommand.Execute().Subscribe())" />
      }

      
      @if(ViewModel!.AlicatState.LiveData.VolumetricFlow is not null)
      {
        <div class="field-descriptor">Volumetric Flow</div>
        <div>@($"{ViewModel!.AlicatState.LiveData.VolumetricFlow}")</div>
      }
      <div></div>

      <div class="field-descriptor">Mass Flow</div>
      <div>@($"{ViewModel!.AlicatState.LiveData.MassFlow}")</div>
      <RadzenButton Text="Tare" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click="@(() => ViewModel.TareFlowCommand.Execute().Subscribe())" />
      
      @if(ViewModel!.AlicatState.LiveData.ValveDrive is not null)
      {
        <div class="field-descriptor">Valve Drive</div>
        <div>@($"{ViewModel!.AlicatState.LiveData.ValveDrive}")</div>
        <div></div> 
      }

      <div class="field-descriptor">Setpoint</div>
      <div>@($"{ViewModel!.AlicatState.LiveData.Setpoint}")</div>
      <div></div> <div class="field-descriptor">New Setpoint</div>
      <RadzenNumeric TValue="double?"
                     @bind-Value="@ViewModel!.TargetSetpoint"
                     Placeholder="@ViewModel!.AlicatState.LiveData.Setpoint.ToString()"
                     ShowUpDown="false"
                     class="mfc-setpoint-input text-center"
                     Style="width: 100%;" />
      <RadzenButton Text="Set"
                    ButtonStyle="ButtonStyle.Secondary"
                    Size="ButtonSize.Small"
                    Click="@ViewModel!.SetSetpoint" />
    </div>

    @if(ViewModel!.AlicatState.HasValve)
    {
      <fieldset class="valve-control p-1">
        <legend class="float-none w-auto valve-legend">Valve Hold Control</legend>
        <div class="valve-control-grid">
          <RadzenButton Text="Current"
                        Disabled="@(ValveHolding || ValveInteracting)"
                        IsBusy="@_waitingOnHoldCurrent"
                        Click="@HoldCurrentClicked"
                        ButtonStyle="ButtonStyle.Secondary" />

          <RadzenButton Text="Close"
                        Disabled="@(ValveHolding || ValveInteracting)"
                        IsBusy="@_waitingOnHoldClose"
                        Click="@HoldCloseClicked"
                        ButtonStyle="ButtonStyle.Secondary" />

          <RadzenButton Text="Cancel"
                        Disabled="@(!ValveHolding || ValveInteracting)"
                        IsBusy="@_cancellingHold"
                        Click="@CancelHoldClicked"
                        ButtonStyle="ButtonStyle.Secondary" />
        </div>
      </fieldset>
    }

    <div class="d-flex gap-2 status-codes mt-3">
      @foreach(var stat in ViewModel!.StatusCodes.Items)
      {
        <RadzenBadge BadgeStyle="BadgeStyle.Dark" Text="@stat.ToString().ToUpper()" class="px-2 py-1 rounded-3" />
      }
    </div>
  }
  else
  {
    <span>Loading MFC</span>
    <LoadingSpinner />
  }
</div>

@code {
  private bool _waitingOnHoldCurrent;
  private bool _waitingOnHoldClose;
  private bool _cancellingHold;

  private bool ValveInteracting => _cancellingHold || _waitingOnHoldClose || _waitingOnHoldCurrent;
  private bool ValveHolding => ViewModel!.AlicatState.LiveData.StatusCodes.Any(code => code == MfcStatusEnum.HLD.ToString());

  private async Task CancelHoldClicked()
  {
    _cancellingHold = true;
    ViewModel!.CancelValveHoldCommand.Execute().Subscribe();
    _cancellingHold = false;
    // StateHasChanged() might not be strictly necessary here if Radzen handles the event lifecycle, but safe to keep if ReactiveUI needs it
  }

  private async Task HoldCurrentClicked()
  {
    _waitingOnHoldCurrent = true;
    ViewModel!.HoldValvesAtCurrentPositionCommand.Execute().Subscribe();
    _waitingOnHoldCurrent = false;
  }

  private async Task HoldCloseClicked()
  {
    _waitingOnHoldClose = true;
    ViewModel!.HoldValvesClosedCommand.Execute().Subscribe();
    _waitingOnHoldClose = false;
  }
}