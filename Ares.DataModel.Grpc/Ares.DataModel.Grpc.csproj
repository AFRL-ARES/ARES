<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

  <Target Name="NugetPackAutoVersioning" AfterTargets="Build">
    <Exec Command="dotnet pack -p:PackageVersion=$([System.DateTime]::Now.ToString(&quot;yyyy.MM.dd.HHmmss&quot;)) --no-build --configuration $(Configuration) --output &quot;$(ProjectDir)..\nuget&quot;" />
  </Target>

  <ItemGroup Label="Nuget Packaging">
    <_Asset PackagePath="Proto/" Include="**\*.proto" />
    <None Include="@(_Asset)" Pack="true" Visible="False" />
  </ItemGroup>

  <PropertyGroup>
    <DataModelProtoPath>$(PkgAres_DataModel_dll)\Proto\</DataModelProtoPath>
  </PropertyGroup>
  <ItemGroup>
    <Protobuf Include="AresAutomation.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
      <Protobuf Include="AresDevices.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
		<Protobuf Include="AresNotification.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
			<Generator>MSBuild:Compile</Generator>
		</Protobuf>
      <Protobuf Include="AresPlanning.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
      <Protobuf Include="AresServerInfo.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
    <Protobuf Include="AresValidation.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
        <Generator>MSBuild:Compile</Generator>
      </Protobuf>
		<Protobuf Include="AresAnalyzerManagementService.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
			<Generator>MSBuild:Compile</Generator>
		</Protobuf>
		<Protobuf Include="AresAnalysisService.proto" GrpcServices="Both" AdditionalImportDirs="$(DataModelProtoPath)">
			<Generator>MSBuild:Compile</Generator>
		</Protobuf>
  </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Ares.DataModel.dll" Version="2025.8.5.92857" GeneratePathProperty="True" />
      <PackageReference Include="Grpc.Tools" Version="2.72.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>
