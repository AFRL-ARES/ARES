@page
@model LoginModel

@{
    ViewData["Title"] = "Log In";
}

<!DOCTYPE html>

<div class="col d-flex justify-content-center py-2" >
    <div class="card border-primary mb-3 py-2" style="width: 80rem;">
        <section>
            <form id="account" method="post">
                <div class="login-title">
                    <div class="login-title">
                        <img src="images/ARESLogo.png" alt="ARES OS" style="height: 150px"/>
                    </div>
                <!--
                <div class="login-title">
                    <h2 class="px-4 py-3">Log In</h2>
                </div>
                -->
                </div>
                <hr/>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="welcome-message">
                    <p>  Welcome to ARES OS </p>
                </div>
                <div class="form-group py-2 px-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email Address"/>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group py-2 px-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password"/>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div>
                    <div class="checkbox py-2 px-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe"/>
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div class="login-button justify-content-center">
                    <button id="login-submit" type="submit" class="w-100 btn btn-primary my-2">Log in</button>
                </div>

            </form>
        </section>
    </div>
</div>
<div class="col d-flex justify-content-center py-2" >
<div class="card border-secondary mb-3" style="width: 80rem;">
    <a id="forgot-password" asp-page="./ForgotPassword" class="btn btn-secondary my-2">Forgot your password?</a>
        <a asp-page="./Register" class="btn btn-secondary my-2" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
        <a id="resend-confirmation" class="btn btn-secondary my-2" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
