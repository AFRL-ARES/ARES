{
  "compilerOptions": {
    "module": "ES6",
    "moduleResolution": "bundler",
    "target": "ES6",
    "sourceMap": true,
    "outDir": "wwwroot/js",
    "rootDir": "Scripts",
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "Scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "wwwroot"
  ]
}
