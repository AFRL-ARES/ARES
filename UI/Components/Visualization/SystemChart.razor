@implements IAsyncDisposable
@inject IJSRuntime JS

<canvas id="@CanvasId" style="width: 100%; height: 100%;"></canvas>

@code {
  [Parameter] 
  public string CanvasId { get; set; } = $"chart-{Guid.NewGuid()}";
  
  [Parameter] 
  public object? Config { get; set; }

  private IJSObjectReference _module;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      // Import the module dynamically
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart-driver.js");

      // Initialize the chart with the passed Config
      await _module.InvokeVoidAsync("initializeChart", CanvasId, Config);
    }
  }

  // Method to allow parent components to push new data
  public async Task UpdateDataAsync(object newData)
  {
    if(_module != null)
    {
      await _module.InvokeVoidAsync("updateChartData", CanvasId, newData);
    }
  }

  public async ValueTask DisposeAsync()
  {
    if(_module != null)
    {
      try
      {
        await _module.InvokeVoidAsync("disposeChart", CanvasId);
        await _module.DisposeAsync();
      }
      catch(JSDisconnectedException)
      {
        // Ignored: The circuit is arguably already dead
      }
    }
  }
}