@using Ares.Datamodel.Device
@using Ares.Device
@using UI.Features.Components
@using UI.Features.Visualization

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<VisualizationSidebarViewModel>

<div class="vis-sidebar @(_isExpanded ? "extended" : "")">

  <!-- Button is now inside the main div, but positioned outside via CSS -->
  <div class="vis-toggle-btn" @onclick="ToggleSidebar">
    <span>@(_isExpanded ? ">>" : "<<")</span>
  </div>

  <RadzenCard class="rz-p-4 rz-h-100" style="min-height: 800px; display: flex; flex-direction: column;">
      <RadzenText TextStyle="TextStyle.H5" class="rz-mb-4">
          <RadzenIcon Icon="hub" class="rz-mr-2" /> Data Stream Explorer
      </RadzenText>

      <RadzenRow Gap="1rem" style="flex: 1;">
        
          @* LEFT COLUMN: Device Selection *@
          <RadzenColumn Size="12" SizeMD="5" style="display: flex; flex-direction: column;">
              <RadzenText TextStyle="TextStyle.Subtitle2">1. Select Device</RadzenText>
            
              <RadzenListBox @bind-Value="ViewModel.SelectedDevice"
                             Data="@ViewModel!.AvailableDevices"
                             TextProperty="Name"
                             Style="flex: 1; width: 100%; height: 100%; min-height: 400px;"
                             class="rz-shadow-1">
                  <Template Context="device">
                      <div style="display: flex; align-items: center;">
                          <RadzenIcon Icon="router" class="rz-mr-2 rz-color-primary" />
                          <span>@(((IAresDevice)device).Name)</span> 
                      </div>
                  </Template>
              </RadzenListBox>
          </RadzenColumn>

          @* RIGHT COLUMN: Data Path Selection *@
          <RadzenColumn Size="12" SizeMD="7" style="display: flex; flex-direction: column;">
            
              <div style="display: flex; justify-content: space-between; align-items: center;" class="rz-mb-2">
                  <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">2. Select Data Point</RadzenText>
                
                  @* The 'Show All' Toggle *@
                  <div style="display: flex; align-items: center;">
                      <RadzenLabel Text="Show All Data" Component="ShowAllSwitch" class="rz-mr-2 rz-color-text-secondary" Style="font-size: 0.85rem;" />
                      <RadzenSwitch @bind-Value="ViewModel!.ShowAllValues" Name="ShowAllSwitch" />
                  </div>
              </div>

              @if (ViewModel.SelectedDevice == null)
              {
                  <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                      Please select a device from the list to view its available telemetry.
                  </RadzenAlert>
              }
              else if (!ViewModel.VisiblePaths.Any())
              {
                  <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                      No graphable data points found for this device.
                  </RadzenAlert>
              }
              else
              {
                  <RadzenListBox TValue="VisualizationPath" 
                                 Data="@ViewModel.VisiblePaths"
                                 Style="flex: 1; width: 100%; height: 100%; min-height: 400px;"
                                 class="rz-shadow-1">
                      <Template Context="path">
                          @{
                              var vPath = (VisualizationPath)path;
                              // Make numbers pop with a primary color, fade strings into the background
                              var badgeStyle = vPath.IsPlottable ? BadgeStyle.Success : BadgeStyle.Light;
                              var icon = vPath.IsPlottable ? "timeline" : "text_snippet";
                          }
                          <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                              <div style="display: flex; align-items: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                  <RadzenIcon Icon="@icon" class="rz-mr-2 rz-color-text-disabled" Style="font-size: 1.2rem;" />
                                  <span title="@vPath.Path">@vPath.Path</span>
                              </div>
                              <RadzenBadge BadgeStyle="@badgeStyle" Text="@vPath.DataType.ToString()" IsPill="true" class="rz-ml-2" />
                          </div>
                      </Template>
                  </RadzenListBox>
              }
          </RadzenColumn>
      </RadzenRow>
  </RadzenCard>

</div>

@code {
  private bool _isExpanded = false;

  private void ToggleSidebar()
  {
    _isExpanded = !_isExpanded;
  }
}
