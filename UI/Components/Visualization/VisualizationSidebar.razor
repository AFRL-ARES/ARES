@using Ares.Datamodel.Device
@using UI.Backend.ViewModels.Components

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<VisualizationSidebarViewModel>

<div class="vis-sidebar @(_isExpanded ? "extended" : "")">

  <!-- Button is now inside the main div, but positioned outside via CSS -->
  <div class="vis-toggle-btn" @onclick="ToggleSidebar">
    <span>@(_isExpanded ? ">>" : "<<")</span>
  </div>

  <RadzenButton Variant="Variant.Outlined" Text="Add Chart" ButtonStyle="ButtonStyle.Primary" />
  <RadzenDropDown Data="ViewModel!.AvailableDevices" TValue="DeviceInfo" @bind-Value="ViewModel!.SelectedDevice" TextProperty="Name" Change="ViewModel!.UpdateSelectedDeviceStateInformation"/>

  @if(ViewModel!.SelectedDeviceStateSchema is not null)
  {
    <RadzenDropDown Data="ViewModel!.AvailableDeviceStateItems" TValue="string" />
  }
</div>

@code {
  private bool _isExpanded = false;

  private void ToggleSidebar()
  {
    _isExpanded = !_isExpanded;
  }
}
