<div class="ares-nav-menu border-end p-2 bg-dark vh-100 flex-column @(ExpandedMainNav ? "d-flex" : "hamburger-closed")">
    <a href="\">
        <img src="images/ARESLogo.png" alt="Ares Logo" class="img-fluid"/>
    </a>
    <div class="flex-grow-1">
        <ul class="nav nav-pills">
            @MainNavContent
        </ul>
    </div>
    <div class="d-flex flex-row justify-content-around">
        @FooterContent
    </div>
</div>

<div class="closed-ares-nav-menu border-end p-2 bg-dark vh-100 flex-column @(ExpandedMainNav ? "hamburger-closed" : "d-flex")">
    <div class="flex-grow-1">
        <ul class="nav nav-pills closed-nav-item">
            @CollapsedNavContent
        </ul>
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? MainNavContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    [Parameter]
    public RenderFragment? CollapsedNavContent { get; set; }

    [Parameter]
    public bool ExpandedMainNav { get; set; }
}
