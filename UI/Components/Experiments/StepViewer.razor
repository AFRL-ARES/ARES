@using Ares.Datamodel
@using Ares.Datamodel.Templates
@using UI.Features.CampaignEdit.ViewModels

<div class="d-flex flex-column border rounded p-2 my-2">
  <div class="container">
    <div class="row">
      <div class="col d-flex my-1 align-items-center">

          <button @onclick="() => CommandsExpanded = !CommandsExpanded" class="btn border-0">
              <RadzenIcon Icon="@(CommandsExpanded ? "expand_less" : "expand_more")"></RadzenIcon>
          </button>

          <RadzenIcon Icon="@(Parallel ? "view_week" : "view_stream")"/>
          <span class="flex-grow-1 px-2">@Name</span>
          <span class="badge">@CommandTemplates.Count</span>
      </div>
      <div class="col">
        @if(HasExperimentOutputs)
        {
          <ExperimentOutputIcon />
        }
      </div>
    </div>
  </div>
  @if (CommandsExpanded)
    {
        <ul class="mx-2 list-group ">
            @foreach (var template in CommandTemplates)
            {
                <li class="list-group-item d-flex align-items-center">

                        <RadzenIcon Icon="terminal"/>

                        <div class="flex-grow-1 px-2">
                            <CommandViewer CommandTemplate="@template"
                                           AvailableVariableReferences="@GetPriorVariableReferences(template)"
                                           AvailablePlannedParameters="@AvailablePlannedParameters" />
                        </div>
                </li>
            }
        </ul>
    }
</div>

@code {
  public bool CommandsExpanded { get; set; } = true;
  private StepTemplate? _stepTemplate;

  private string? Name { get; set; }
  private bool Parallel { get; set; }
  private int Index { get; set; }

  [Parameter]
  public StepTemplate? StepTemplate
  {
    private get => _stepTemplate;

    set
    {
      _stepTemplate = value;
      Init(value);
    }
  }

  [Parameter]
  public IEnumerable<ParameterMetadata> AvailablePlannedParameters { get; set; } = [];

  [Parameter]
  public IEnumerable<CommandOutputVariableReference> PriorVariableReferences { get; set; } = [];

  [Parameter]
  public IReadOnlyDictionary<string, AresValueSchema> CustomCommandOutputSchemas { get; set; }
    = new Dictionary<string, AresValueSchema>(StringComparer.OrdinalIgnoreCase);

  private bool HasExperimentOutputs { get; set; }

  public IList<CommandTemplate> CommandTemplates { get; private set; } = Array.Empty<CommandTemplate>();

  private void Init(StepTemplate? existingTemplate)
  {
    if (existingTemplate is null)
      return;

    Name = existingTemplate.Name;
    Parallel = existingTemplate.IsParallel;
    Index = Convert.ToInt32(existingTemplate.Index);
    CommandTemplates = existingTemplate.CommandTemplates.OrderBy(t => t.Index).ToList();
    HasExperimentOutputs = CommandTemplates.Any(ct => ct.HasOutputVarName);
  }

  private CommandOutputVariableReference[] GetPriorVariableReferences(CommandTemplate template)
  {
    var availableReferences = PriorVariableReferences.ToList();

    if(!Parallel)
    {
      availableReferences.AddRange(CommandTemplates
        .Where(command => command.Index < template.Index)
        .SelectMany(command => CommandOutputVariableReferenceBuilder.Build(command, CustomCommandOutputSchemas)));
    }

    return availableReferences.ToArray();
  }
}
