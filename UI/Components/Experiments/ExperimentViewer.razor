@inject DialogService DialogService
@using Ares.Datamodel.Templates
@using UI.Features.CampaignEdit.ViewModels

@if (CampaignTemplate is not null)
{
  <div class="d-flex h-100">
    <div class="d-flex flex-column flex-grow-1 overflow-auto">
      <div class="d-flex flex-column">
       @foreach(var startupStep in CampaignTemplate.StartupTemplate.StepTemplates.OrderBy(t => t.Index))
       {
          <div class="d-flex">
            <div class="flex-grow-1">
              <StepViewer StepTemplate="@startupStep"
                          AvailablePlannedParameters="@CampaignTemplate.PlannableParameters"
                          PriorVariableReferences="@GetPriorVariableReferences(CampaignTemplate.StartupTemplate, startupStep)" />
            </div>
          </div>
        }

        @foreach (var stepTemplate in CampaignTemplate.ExperimentTemplate.StepTemplates.OrderBy(t => t.Index))
        {
          <div class="d-flex" >
            <div class="flex-grow-1">
              
              <StepViewer StepTemplate="@stepTemplate"
                          AvailablePlannedParameters="@CampaignTemplate.PlannableParameters"
                          PriorVariableReferences="@GetPriorVariableReferences(CampaignTemplate.ExperimentTemplate, stepTemplate)" />
            </div>
          </div>
        }

        @foreach(var closeoutStep in CampaignTemplate.CloseoutTemplate.StepTemplates.OrderBy(t => t.Index))
        {
          <div class="d-flex">
            <div class="flex-grow-1">
              <StepViewer StepTemplate="@closeoutStep"
                          AvailablePlannedParameters="@CampaignTemplate.PlannableParameters"
                          PriorVariableReferences="@GetPriorVariableReferences(CampaignTemplate.CloseoutTemplate, closeoutStep)" />
            </div>
          </div>
        }
      </div>
    </div>
  </div>
}

@code {
  [Parameter]
  public CampaignTemplate? CampaignTemplate { get; set; }

  private static CommandOutputVariableReference[] GetPriorVariableReferences(
    ExperimentTemplate experimentTemplate,
    StepTemplate stepTemplate)
  {
    var references = new List<CommandOutputVariableReference>();

    foreach(var currentStep in experimentTemplate.StepTemplates.OrderBy(step => step.Index))
    {
      if(currentStep == stepTemplate)
        return references.ToArray();

      references.AddRange(currentStep.CommandTemplates.SelectMany(CommandOutputVariableReferenceBuilder.Build));
    }

    return references.ToArray();
  }
}
