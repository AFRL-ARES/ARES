    </div>
    @*     </Authorized>
          <NotAuthorized>
              <article class="content px-4">
                  <meta http-equiv="refresh" content="0.01; URL=Identity/Account/Login"/>
              </article>
          </NotAuthorized>
      </AuthorizeView> *@
