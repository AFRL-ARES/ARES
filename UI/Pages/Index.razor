@page "/"
@using Ares.Core.Settings
@using Ares.Toolkit.Device.UI
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.ComponentModel
@using UI.Application.Devices.Repos
@using UI.Features.CustomCommand
@using UI.Features.DeviceStateLogging
@using UI.Features.Devices.Remote

@inject IJSRuntime JS
@inject IDeviceControlViewModelRepo ViewModelRepo
@inject ISystemSettingsManager SettingsManager
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

<div class="d-flex flex-column gap-2">
  @if(_shouldDisplayManualWidget)
  {
    <div class="d-flex gap-2">
      <ManualDeviceLoggerWidget />
    </div>
  }

  <div class="grid-stack @(_isReady ? "dashboard-ready" : "")" id="my-dashboard">

    @if(_shouldDisplayCustomCommandWidget)
    {
      <div class="grid-stack-item" data-id="custom-command-runner" gs-w="20" gs-size-to-content="true">
        <div class="grid-stack-item-content">
          <CustomCommandDashboardWidget />
        </div>
      </div>
    }


    @foreach(var viewModel in ViewModelRepo.Items)
    {
      // Fallback Values
      var width = viewModel.DefaultWidth;

      <div class="grid-stack-item" @key="viewModel.DeviceId" data-id="@viewModel.DeviceId" gs-w="@width" gs-size-to-content="true">
        <div class="grid-stack-item-content">
          <DashboardWidget>
            <DynamicComponent Type="@viewModel.ViewType" Parameters="@GetOrCreateArgs(viewModel)" />
          </DashboardWidget>
        </div>
      </div>
    }
  </div>
</div>

@code {
  private IJSObjectReference? _module;
  private DotNetObjectReference<Index>? _objRef;
  private IDisposable? _repoSubscription;

  private bool _isReady = false;
  private Dictionary<string, Dictionary<string, object>> _cachedViewArgs = new();
  private Dictionary<string, int> _recommendedWidgetWidths = new();
  private Dictionary<string, (RemoteDeviceUnitViewModel ViewModel, PropertyChangedEventHandler Handler)> _widgetWidthSubscriptions = new();
  private bool _shouldDisplayManualWidget = true;
  private bool _shouldDisplayCustomCommandWidget = false;

  private Dictionary<string, object> GetOrCreateArgs(IDeviceUnitControlViewModel vm)
  {
    if(!_cachedViewArgs.TryGetValue(vm.DeviceId, out var args))
    {
      args = new Dictionary<string, object> { { "ViewModel", vm } };
      _cachedViewArgs[vm.DeviceId] = args;
    }
    return args;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      _objRef = DotNetObjectReference.Create(this);
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");
    }

    if(_module is not null)
    {
      if(!_isReady)
      {
        // Initialize the grid once
        await _module.InvokeVoidAsync("initDashboard", "my-dashboard", _objRef);
        _isReady = true;
        StateHasChanged(); // Triggers the dashboard-ready CSS class
      }
      else
      {
        await _module.InvokeVoidAsync("refreshGrid", "my-dashboard");
        await UpdateRecommendedWidgetWidths();
      }
    }

    await UpdateWidgetDisplaySetting();
  }

  private async Task UpdateRecommendedWidgetWidths()
  {
    foreach(var remoteDevice in ViewModelRepo.Items.OfType<RemoteDeviceUnitViewModel>())
    {
      if(_recommendedWidgetWidths.TryGetValue(remoteDevice.DeviceId, out var currentWidth) && currentWidth == remoteDevice.DefaultWidth)
        continue;

      _recommendedWidgetWidths[remoteDevice.DeviceId] = remoteDevice.DefaultWidth;
      await _module!.InvokeVoidAsync("updateWidgetWidth", "my-dashboard", remoteDevice.DeviceId, remoteDevice.DefaultWidth);
    }
  }

  private async Task UpdateWidgetDisplaySetting()
  {
    var currentSettings = await SettingsManager.GetAresGeneralSettings();
    var displayDataWidget = currentSettings?.DisplayDataCollectionWidget ?? true;
    var displayCustomCommandWidget = currentSettings?.DisplayCustomCommandWidget ?? true;

    if(_shouldDisplayManualWidget != displayDataWidget || _shouldDisplayCustomCommandWidget != displayCustomCommandWidget)
    {
      _shouldDisplayManualWidget = displayDataWidget;
      _shouldDisplayCustomCommandWidget = displayCustomCommandWidget;
      StateHasChanged();
    }
  }

  private void ViewModelsUpdated()
  {
    _ = InvokeAsync(() =>
    {
      UpdateWidgetWidthSubscriptions();
      StateHasChanged();
    });
  }

  private void UpdateWidgetWidthSubscriptions()
  {
    var remoteDevices = ViewModelRepo.Items.OfType<RemoteDeviceUnitViewModel>().ToDictionary(device => device.DeviceId);

    foreach(var subscription in _widgetWidthSubscriptions.Where(subscription => !remoteDevices.ContainsKey(subscription.Key)).ToArray())
    {
      subscription.Value.ViewModel.PropertyChanged -= subscription.Value.Handler;
      _widgetWidthSubscriptions.Remove(subscription.Key);
      _recommendedWidgetWidths.Remove(subscription.Key);
    }

    foreach(var remoteDevice in remoteDevices.Values.Where(device => !_widgetWidthSubscriptions.ContainsKey(device.DeviceId)))
    {
      PropertyChangedEventHandler handler = (_, args) =>
      {
        if(args.PropertyName == nameof(RemoteDeviceUnitViewModel.DefaultWidth))
          _ = InvokeAsync(StateHasChanged);
      };

      remoteDevice.PropertyChanged += handler;
      _widgetWidthSubscriptions[remoteDevice.DeviceId] = (remoteDevice, handler);
    }
  }

  protected override void OnInitialized()
  {
    UpdateWidgetWidthSubscriptions();
    _repoSubscription = ViewModelRepo.Connect().Subscribe(_ => ViewModelsUpdated());
  }

  [JSInvokable]
  public void OnDashboardUpdate(object updates)
  {
    //TODO: Save dashboard changes
  }

  public async ValueTask DisposeAsync()
  {
    try
    {
      _repoSubscription?.Dispose();

      foreach(var subscription in _widgetWidthSubscriptions.Values)
        subscription.ViewModel.PropertyChanged -= subscription.Handler;

      if(_module is not null)
      {
        await _module.DisposeAsync();
      }

      _objRef?.Dispose();
    }

    catch { }
  }
}
