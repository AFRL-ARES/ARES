@page "/"
@using UI.Backend.Devices
@using UI.Backend.ViewModels
@using UI.Pages.Shared.Devices.CM3Camera
@using UI.Pages.Shared.Devices.DataLogger
@using UI.Pages.Shared.Devices.LaserChiller
@using UI.Pages.Shared.Devices.Mfc
@using UI.Pages.Shared.Devices.Remote
@using UI.Pages.Shared.Devices.RestDevice
@using UI.Pages.Shared.Devices.SerialRestDevice
@using UI.Pages.Shared.Devices.SyringePump
@using UI.Pages.Shared.Devices.TubeFurnace
@using UI.Pages.Shared.Devices.StepperController
@using UI.Pages.Shared.Devices.ValveController
@using UI.Pages.Shared.Devices.Servo
@using UI.Pages.Shared.Devices.VerdiV6Laser
@using UI.Pages.Shared.Misc
@using UI.Pages.Shared.Sortable

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<IndexViewModel>
@inject IJSRuntime JS


<PageTitle>Dashboard</PageTitle>
<div class="d-flex flex-column gap-2">
  <div class="d-flex gap-2">
    <ManualExecutionWidget />
  </div>

  <div class="grid-stack" id="my-dashboard">
      @foreach(var deviceType in MultiViews)
      {
        //Fallback Values
        var width = 0;
        var height = 0;

        if(typeof(IDashboardControlWidget).IsAssignableFrom(deviceType))
        {
          var wProp = deviceType.GetProperty("DefaultWidth");
          var hProp = deviceType.GetProperty("DefaultHeight");

          // You might need Activator.CreateInstance if they are instance properties
          var instance = Activator.CreateInstance(deviceType) as IDashboardControlWidget;
          if (instance != null)
          {
            width = instance.DefaultWidth;
            height = instance.DefaultHeight;
          }
        }
     
        <div class="grid-stack-item" gs-w="@width" gs-h="@height">
          <div class="grid-stack-item-content">
            <div style="overflow-y: auto; height: 100%">
              <DynamicComponent Type="@deviceType" />
            </div>
          </div>
        </div>
      }
  </div>

</div>

@code {
  // This holds the reference to your specific JS file
  private IJSObjectReference? _module;
  private DotNetObjectReference<Index>? _objRef;

  public List<Type> MultiViews = new List<Type>() 
  { 
    typeof(RemoteDeviceDirectorView),
    typeof(DataLoggerMultiView), 
    typeof(MfcDirectorControl), 
    typeof(SyringePumpWorkspaceControl),
    typeof(TubeFurnaceMultiControl),
    typeof(ServoMultiView),
    typeof(StepperControllerMultiView),
    typeof(ValveControllerMultiView),
    typeof(CM3CameraMultiView),
    typeof(VerdiLaserMultiView),
    typeof(LaserChillerMultiView),
    typeof(RestDeviceMultiView),
    typeof(SerialRestDeviceMultiView)
  };

  private void SortList((int oldIndex, int newIndex) indices)
  {
    // deconstruct the tuple
    var (oldIndex, newIndex) = indices;

    var items = this.MultiViews;
    var itemToMove = items[oldIndex];
    items.RemoveAt(oldIndex);

    if(newIndex < items.Count)
    {
      items.Insert(newIndex, itemToMove);
    }
    else
    {
      items.Add(itemToMove);
    }

    StateHasChanged();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      _objRef = DotNetObjectReference.Create(this);

      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");

      await _module.InvokeVoidAsync("initDashboard", "my-dashboard", _objRef);
    }

    await base.OnAfterRenderAsync(firstRender);
  }

  [JSInvokable]
  public void OnDashboardUpdate(object updates)
  {
    Console.WriteLine("Dashboard Updated vis JS!");
  }

  async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      await _module.DisposeAsync();
    }
    _objRef?.Dispose();
  }

  public async Task RefreshWidgetSize(string componentId)
  {
    if (_module != null)
    {
      await _module.InvokeVoidAsync("resizeWidget", componentId);
    }
  }
}