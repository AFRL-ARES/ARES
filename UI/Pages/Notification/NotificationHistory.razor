@page "/notifications"
@using Ares.Messaging
@using UI.Backend.Notifications
@inject ContextMenuService ContextMenuService
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<UI.Backend.ViewModels.NotificationHistoryViewModel>

<div style="border-bottom: 2px solid #444">
  <RadzenText Text="Event History" TextStyle="TextStyle.H4" TextAlign="TextAlign.Left" />
</div>

<div class="hr"></div>

<div class="m-1 d-flex overflow-auto flex-fill">
  <div class="d-flex">
    <div class="overflow-auto">
      <div class="nav nav-pills d-flex flex-column flex-sm-column" style="padding-right: 1rem; padding-top: 0.5rem;">
        <RadzenStack Orientation="Orientation.Vertical">
          <RadzenText Text="Filters" TextStyle="TextStyle.H5" TextAlign="TextAlign.Justify" />
          <RadzenToggleButton Text="Show All Notifications" @bind-Value="ViewModel!.DisplayAllNotifications" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Secondary" />
          <RadzenToggleButton Text="@ErrorToggleText()" Icon="error" @bind-Value="ViewModel!.DisplayErrorNotifications" Disabled="@ViewModel!.DisplayAllNotifications" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Danger" ToggleShade="Shade.Dark" />
          <RadzenToggleButton Text="@WarningToggleText()" Icon="warning" @bind-Value="ViewModel!.DisplayWarningNotifications" Disabled="@ViewModel!.DisplayAllNotifications" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Warning" ToggleShade="Shade.Dark" />
          <RadzenToggleButton Text="@InfoToggleText()" Icon="info" @bind-Value="ViewModel!.DisplayInfoNotifications" Disabled="@ViewModel!.DisplayAllNotifications" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Info" ToggleShade="Shade.Dark" />
          <RadzenToggleButton Text="@SuccessToggleText()" Icon="check" @bind-Value="ViewModel!.DisplaySuccessNotifications" Disabled="@ViewModel!.DisplayAllNotifications" ButtonStyle="ButtonStyle.Light" ToggleButtonStyle="ButtonStyle.Success" ToggleShade="Shade.Dark" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Style="padding-top: 1rem">
          <RadzenText Text="Sort" TextStyle="TextStyle.H5" TextAlign="TextAlign.Justify" />
          <RadzenRadioButtonList TValue="int" Orientation="Orientation.Vertical" @bind-Value="ViewModel!.NotificationSortMethod">
            <Items>
              <RadzenRadioButtonListItem Value="0" Text="Time Received"/>
              <RadzenRadioButtonListItem Value="1" Text="Severity" />
            </Items>
          </RadzenRadioButtonList>
        </RadzenStack>
      </div>
    </div>
    <div class="vr">
    </div>
  </div>

  <div class="m-1 overflow-auto flex-fill">
    @if(!ViewModel!.NotificationRepo.Any())
    {
      <RadzenCard class="rz-background-color-info-lighter rz-color-on-info-lighter ares-notification" Style="border: solid 3px #444; margin: 1rem;">
        <RadzenRow Style="width: 100%; overflow: hidden">
          <div style="width: 100%; align-content: center">
            <div> No Event History to Display </div>
          </div>
        </RadzenRow>
      </RadzenCard>
    }

    @foreach(var notification in OrderItems(ViewModel!.NotificationRepo))
    {
      <RadzenCard Visible="ViewModel!.ShouldDisplayNotification(notification)" 
      class="@(ViewModel!.ConvertSeverityToCssClass(notification.NotificationSeverity))"
      Style="border: solid 3px #444; margin: 1rem;">
        <RadzenRow Style="width: 100%; overflow: hidden;">
          <div style="width: 20%; align-content: center;">
            <div> @notification.Title </div>
          </div>

          <div style="width: 50%; align-content: center;">
            <div> @notification.Message </div>
          </div>

          <div style="width: 20%; align-content: center; text-align-last: end">
            <div>@notification.Timestamp.ToDateTime().ToString("hh:mm tt")</div>
          </div>
        </RadzenRow>
      </RadzenCard>
    }
  </div>
</div>


@code {
  private string FormatTimeStamp(DateTime timeStamp) => timeStamp.ToString("hh:mm tt");
  
  private string ErrorToggleText()
  {
    if(ViewModel!.DisplayErrorNotifications)
      return "Hide Errors";

    return "Show Errors";
  }

  private string WarningToggleText()
  {
    if(ViewModel!.DisplayWarningNotifications)
      return "Hide Warnings";

    return "Show Warnings";
  }

  private string InfoToggleText()
  {
    if(ViewModel!.DisplayInfoNotifications)
      return "Hide Info";

    return "Show Info";
  }

  private string SuccessToggleText()
  {
    if(ViewModel!.DisplaySuccessNotifications)
      return "Hide Success";

    return "Show Success";
  }

  private List<AresNotification> OrderItems(INotificationRepository aresNotifications)
  {
    if(ViewModel!.NotificationSortMethod == 0)
      return aresNotifications.OrderByDescending(n => n.Timestamp).ToList();

    else
      return aresNotifications.OrderBy(n => n.NotificationSeverity).ToList();
  }
}