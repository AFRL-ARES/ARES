<div class="vis-sidebar @(_isExpanded ? "extended" : "")">

  <div class="vis-toggle-btn" @onclick="ToggleSidebar">
    <span>@(_isExpanded ? ">>" : "<<")</span>
  </div>

  <nav class="vis-nav-list">
    <a href="/" class="vis-nav-item">
      <span class="vis-icon">🏠</span>
      <span class="text">Home</span>
    </a>
    <a href="/counter" class="vis-nav-item">
      <span class="vis-icon">🔢</span>
      <span class="text">Counter</span>
    </a>
    <a href="/settings" class="vis-nav-item">
      <span class="vis-icon">⚙️</span>
      <span class="text">Settings</span>
    </a>
  </nav>
</div>

@code {
  private bool _isExpanded = false;

  private void ToggleSidebar()
  {
    _isExpanded = !_isExpanded;
  }
}