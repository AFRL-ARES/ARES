@inject DialogService DialogService
@using Ares.Messaging
@using UI.Backend.ViewModels.Automation.CampaignEdit

@if (ExperimentTemplate is not null)
{
  <div class="d-flex h-100">
    <div class="d-flex flex-column flex-grow-1 overflow-auto">
      <div class="d-flex flex-column">
        @foreach(var startupStep in ExperimentTemplate.StartupStepTemplates.OrderBy(t => t.Index))
        {
          <div class="d-flex">
            <div class="flex-grow-1">
              
              <StepViewer StepTemplate="@startupStep" />
            </div>
          </div>
        }

        @foreach (var stepTemplate in ExperimentTemplate.StepTemplates.OrderBy(t => t.Index))
        {
          <div class="d-flex" >
            <div class="flex-grow-1">
              
              <StepViewer StepTemplate="@stepTemplate"/>
            </div>
          </div>
        }

        @foreach(var closeoutStep in ExperimentTemplate.CloseoutStepTemplates.OrderBy(t => t.Index))
        {
          <div class="d-flex">
            <div class="flex-grow-1">
              <StepViewer StepTemplate="@closeoutStep" />
            </div>
          </div>
        }
      </div>
    </div>
  </div>
}

@code {
  [Parameter]
  public ExperimentTemplate? ExperimentTemplate { get; set; }
}
