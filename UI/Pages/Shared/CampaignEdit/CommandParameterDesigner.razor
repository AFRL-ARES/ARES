@using Ares.Tools
@using Google.Protobuf.WellKnownTypes
@using Radzen;
@using Ares.Messaging
@using Microsoft.AspNetCore.WebUtilities
@using UI.Backend.ViewModels.Automation;
@using UI.Backend.ViewModels.Automation.CampaignEdit
@inherits ReactiveUI.Blazor.ReactiveComponentBase<CommandParameterDesignerViewModel>

<div class="d-flex flex-column">
  <div class="input-group mb-3">
    @if (ViewModel!.IsPlanned || ViewModel!.IsEnvironmentBased)
    {
      if(ViewModel!.IsPlanned)
      {
        <select @bind="ViewModel.SelectedPlannedParameterMetadataId" class="form-select align-self-stretch">
          @if (ViewModel!.SelectedPlannedParameterMetadataId is null)
          {
            <option value="" selected disabled>Select a Command</option>
          }
          @foreach (var metadata in ViewModel!.PlannedParameters)
          {
            <option value="@metadata.UniqueId">
              @metadata.Name (@metadata.Unit)
            </option>
          }
        </select>
      }

      else
      {
        <select @bind="ViewModel.SelectedVariableType" class="form-select align-self-stretch">
          @if (ViewModel!.SelectedVariableType is null)
          {
            <option value="" selected disabled>Select a Command</option>
          }
          @foreach (var variable in ViewModel!.VariableTypes)
          {
            <option value="@variable">
              @variable.ToString()
            </option>
          }
        </select>
      }
    }

    else
    {
      <AresValueDesigner ValueEditCallback="ValueEditCallback" Schema="ViewModel!.Schema" Value="@ViewModel!.Value?.Value" Unit="@ViewModel!.Unit" Name="@ViewModel!.Name" />
    }
  </div>

  @if (ViewModel!.IsEnvironmentBased && ViewModel!.SelectedVariableType == VariableType.PreviousExperimentPath)
  {
    <div class="mb-2">
      <label class="form-label" for="pastExperimentNumeric">
        Experiment Offset:
      </label>
      <RadzenNumeric ShowUpDown="false" @bind-Value="ViewModel!.PastExperimentNumber" id="pastExperimentNumeric" />
    </div>
  }

  <div class="mb-2">
    <RadzenCheckBox @bind-Value="ViewModel!.IsPlanned" id="flexCheckDefault" Disabled="ViewModel!.IsEnvironmentBased"/>
    <label class="form-check-label" for="flexCheckDefault">
      Planned
    </label>
  </div>


  <div class="mb-2">
    <RadzenCheckBox @bind-Value="ViewModel!.IsEnvironmentBased" id="flexCheckDefault" Disabled="ViewModel!.IsPlanned"/>
    <label class="form-check-label" for="flexCheckDefault">
      Environment Variable
    </label>
  </div>
</div>

@code {



  private Task ValueEditCallback(AresValue value)
  {
    //Not sure what scenario this would be to be honest
    if(ViewModel!.Value is null)
      return Task.CompletedTask;

    ViewModel!.Value.Value = value;
    return Task.CompletedTask;
  }
}