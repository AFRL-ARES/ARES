@using Ares.Messaging;

@if (CommandTemplate is not null)
{
    if (CommandTemplate.Metadata?.Name is not null)
    {
        <div class="d-flex align-items-center">
          <div class="border border-2 border-primary rounded px-2 py-1 mx-2">
                @CommandTemplate.Metadata.DeviceName
            </div>
          <div class="border border-2 border-primary rounded px-2 py-1 mx-2">
        @CommandTemplate.Metadata.Name
      </div>
          @if (CommandTemplate.Parameters.Any())
          {
            <RadzenIcon Icon="arrow_back"/>
          }
          @foreach (var argument in CommandTemplate.Parameters)
            {
                @if (argument.PlanningMetadata is not null)
                {
                    <div class="border border-2 border-warning rounded px-2 py-1 mx-2">
                        @argument.PlanningMetadata.Name
                    </div>
                }
                else
                {
                    <div class="border border-2 rounded px-2 py-1 mx-2">
                        @argument.Value.Value @argument.Metadata.Unit
                    </div>
                }
            }
        </div>
    }
    else
    {
        <span>Undefined Command :^(</span>
    }
}
@code {
  [Parameter]
  public CommandTemplate? CommandTemplate { get; set; }
}
