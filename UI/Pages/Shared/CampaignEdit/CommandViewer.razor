@using Ares.Datamodel.Templates

@if (CommandTemplate is not null)
{
    if (CommandTemplate.Metadata?.Name is not null)
    {
        <div class="d-flex align-items-center">
          <div class="border border-2 border-primary rounded px-2 py-1 mx-2">
                @CommandTemplate.Metadata.DeviceName
            </div>
          <div class="border border-2 border-primary rounded px-2 py-1 mx-2">
        @CommandTemplate.Metadata.Name
      </div>
          @if (CommandTemplate.Parameters.Any())
          {
            <RadzenIcon Icon="arrow_back"/>
          }
          @foreach (var argument in CommandTemplate.Parameters)
            {
                @if (argument.PlanningMetadata is not null)
                {
                  <div class="border border-2 border-warning rounded px-2 py-1 mx-2">
                      @argument.PlanningMetadata.Name
                  </div>
                }

                else if(argument.VariableType > 0)
                {
                  <div class="border border-2 border-secondary rounded px-2 py-1 mx-2">
                    @argument.VariableType.ToString()
                  </div>
                }
                else
                {
                  if (argument.Value is null)
                  {
                    <div class="border border-2 border-danger rounded px-2 py-1 mx-2">
                      Error! Parameter Deleted!
                    </div>
                  }

                  else
                  {
                    <div class="border border-2 rounded px-2 py-1 mx-2">
                      @TryUnpackDisplayData(argument)
                    </div>
                  }
                }
            }
        </div>
    }
    else
    {
        <span>Undefined Command :^(</span>
    }
}
@code {
  [Parameter]
  public CommandTemplate? CommandTemplate { get; set; }

  public object TryUnpackDisplayData(Parameter argument)
  {
    var aresStruct = argument.Value.Value;
    if(aresStruct.HasNumberValue)
      return $"{argument.Metadata.Name}: {aresStruct.NumberValue} {argument.Metadata.Unit}";

    else if(aresStruct.HasStringValue)
      return $"{argument.Metadata.Name}: {aresStruct.StringValue} {argument.Metadata.Unit}";

    else
      return $"{argument.Metadata.Name}: Custom Data";
  }
}
