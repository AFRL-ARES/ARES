@if (ParameterValue is not null)
{
  <input placeholder="@Unit" @bind="ParameterValue.Value" type="text" class="form-control" aria-label="Default" aria-describedby="inputGroup-sizing-default">
}
@code {
  [Parameter]
  public Ares.Messaging.ParameterValue? ParameterValue { get; set; }

  [Parameter]
  public string? Unit { get; set; }
}
