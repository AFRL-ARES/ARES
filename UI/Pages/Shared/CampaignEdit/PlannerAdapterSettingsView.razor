@using UI.Backend.ViewModels.Automation.CampaignEdit

@inherits ReactiveUI.Blazor.ReactiveComponentBase<PlannerAllocationEditorViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
    <RadzenText Text="@($"{ViewModel!.SelectedService!.Name} Settings")"/>

    @foreach(var setting in ViewModel!.PlannerSettings.Fields)
    {
      <RadzenFormField Text="@setting.Key" Variant="Variant.Flat">
        @if(setting.Value.HasStringValue)
        {
          <RadzenTextBox @bind-Value="setting.Value.StringValue" />
        }

        @if(setting.Value.HasNumberValue)
        {
          <RadzenNumeric @bind-Value="setting.Value.NumberValue" />
        }

        @if(setting.Value.HasBoolValue)
        {
          <RadzenSwitch @bind-Value="setting.Value.BoolValue"/>
        }

      </RadzenFormField>
    }

    <button @onclick="OnValidSubmit" class="btn btn-primary">Save</button>
  </RadzenStack>
</EditForm>

@code {
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate { };
}
