@using UI.Backend.ViewModels.Automation.CampaignEdit
@inherits ReactiveUI.Blazor.ReactiveComponentBase<CommandDesignerViewModel>

<MetadataPicker ViewModel="@ViewModel!.MetadataPickerViewModel" @bind-CommandMetadata="ViewModel!.CommandMetadata"  />

@foreach (var argumentDesigner in ViewModel!.ArgumentDesigners)
{
  <CommandParameterDesigner DisablePlanning=@DisablePlanningAndOutputCheck ViewModel="@argumentDesigner" />
}

@if(!DisablePlanningAndOutputCheck)
{
  <div class="mb-2">
	  <RadzenCheckBox @bind-Value="ViewModel!.ExperimentOutputProvider" id="experiment-output-check"/>
	  <label for="experiment-output-check">Provides Experiment Output</label>
  </div>  
}


<div hidden="@(!ViewModel!.ExperimentOutputProvider)">
  <RadzenDataGrid TItem="UserOutputSelection" Data="@ViewModel.OutputKeyMap" Editable="true" EditMode="DataGridEditMode.Single" RowUpdate="@OnRowUpdate" ColumnWidth="200px">
      <Columns>
          <RadzenDataGridColumn Property="@(nameof(UserOutputSelection.DeviceOutputName))" Title="Device Output Name" />
          <RadzenDataGridColumn Property="@(nameof(UserOutputSelection.CustomName))" Title="Experiment Output Name">
              <Template Context="item">
                  <RadzenTextBox Style="width:100%" @bind-Value="item.CustomName" />
              </Template>
          </RadzenDataGridColumn>
      </Columns>
  </RadzenDataGrid>
</div>

@code {
  [Parameter]
  public bool DisablePlanningAndOutputCheck { get; set; }

  public void OnRowUpdate()
  {
    Console.WriteLine("Ayylmao");
  }
}