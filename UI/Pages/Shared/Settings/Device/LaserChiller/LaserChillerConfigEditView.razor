@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.LaserChiller.LaserChillerConfigEditViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <div class="d-flex flex-column">
    <input type="text" class="form-control" disabled="@(!ViewModel!.NewConfig)" placeholder="Name" @bind="@ViewModel!.Name" />
    <input type="text" placeholder="@(ViewModel!.Port is null ? "Port" : ViewModel!.Port)" @bind="@ViewModel!.Port" list="port-list" class="form-select" />
    <datalist id="port-list">
      @if (ViewModel!.AvailablePorts is not null)
      {
        @foreach (var port in ViewModel!.AvailablePorts)
        {
          <option value="@port">@port</option>
        }
      }
    </datalist>
    <div class="align-self-start d-flex">
      <label class="flex-fill" for="simulated-switch">Simulated</label>
      <RadzenSwitch id="simulated-switch" @bind-Value="@ViewModel!.Simulated">Simulated</RadzenSwitch>
    </div>
  </div>
  <ValidationSummary />
  <DataAnnotationsValidator />
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>
@code {

  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate
  {
  };

  private void PortChanged(ChangeEventArgs obj)
  {
    if (obj.Value is not string stringValue)
      throw new InvalidOperationException($"{obj.Value} is not a string and cannot be used as a port name.");

    ViewModel!.Port = stringValue;
  }
}