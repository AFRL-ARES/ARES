@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.LaserChiller.LaserChillerSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService


<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.ChillerConfig.Name">
  <div>
    @if (ViewModel!.ChillerConfig.Simulated)
    {
      <span> Simulated Laser Chiller-- </span>
    }

    <span>@ViewModel!.ChillerConfig.Name</span>
    <span>@ViewModel!.ChillerConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
    private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Laser Chiller", ds =>
      @<LaserChillerConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.ChillerConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

}
