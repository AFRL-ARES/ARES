@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.CM3Camera.CM3CameraSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService

<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.FlirCM3Config.Name">
  <div>
    @if (ViewModel!.FlirCM3Config.Simulated)
    {
      <span> Simulated Flir CM3 Camera </span>
    }

    <span>@ViewModel!.FlirCM3Config.Name</span>
    <span>@ViewModel!.FlirCM3Config.Id</span>
  </div>
</DeviceSettingsContainer>

@code {
	private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Camera", ds =>
      @<CM3CameraConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    await ViewModel!.Save();
    NotificationService.Success("Config has been saved");
 
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.FlirCM3Config.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}
