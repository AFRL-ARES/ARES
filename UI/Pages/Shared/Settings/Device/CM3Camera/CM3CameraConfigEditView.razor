@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.CM3Camera.FlirCM3ConfigEditViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <input type="text" class="form-control" disabled="@(!ViewModel!.NewConfig)" placeholder="Name" @bind="@ViewModel!.Name" />

  <RadzenRow Gap="1rem" Style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
    <RadzenLabel Text="Simulated" Component="simulated-switch"/>
    <RadzenSwitch id="simulated-switch" @bind-Value="@ViewModel!.Simulated">Simulated</RadzenSwitch>
  </RadzenRow>

  <RadzenRow Gap="1rem">
    <RadzenColumn Size="12" SizeSM="6">
      <RadzenFormField Text="Exposure Compensation" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.ExposureCompensation TValue="double"/>
      </RadzenFormField>

      <RadzenFormField Text="Gain" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.Gain Placeholder="0" TValue="double" />
      </RadzenFormField>

      <RadzenFormField Text="Red Balance Ratio" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.RedBalanceRatio TValue="double" />
      </RadzenFormField>

      <RadzenFormField Text="Width" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.Width TValue="int" />
      </RadzenFormField>

      <RadzenFormField Text="X-Offset" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.OffsetX TValue="int" />
      </RadzenFormField>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeSM="6">
      <RadzenFormField Text="Exposure Time" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.ExposureTime TValue="int"/>
      </RadzenFormField>

      <RadzenFormField Text="Black Level" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.BlackLevel TValue="double" />
      </RadzenFormField>

      <RadzenFormField Text="Blue Balance Ratio" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.BlueBalanceRatio TValue="double" />
      </RadzenFormField>

      <RadzenFormField Text="Height" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.Height TValue="int" />
      </RadzenFormField>

      <RadzenFormField Text="Y-Offset" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.OffsetY TValue="int" />
      </RadzenFormField>
    </RadzenColumn>
  </RadzenRow>



  <ValidationSummary />
  <DataAnnotationsValidator />
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>
@code {
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate
  {
  };
}