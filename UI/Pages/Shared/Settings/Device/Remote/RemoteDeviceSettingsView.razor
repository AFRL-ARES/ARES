@using System.Reactive.Linq
@using System.Reactive.Threading.Tasks
@using UI.Backend.ViewModels.Settings.Device.Remote
@inherits ReactiveUI.Blazor.ReactiveComponentBase<RemoteDeviceSettingsViewModel>
@inject DialogService DialogService

<DeviceSettingsContainer 
  EditCallback="EditCallback"
  SettingsCallback="SettingCallback"
  RemoveCallback="RemoveCallback"
  ShowDeviceInfoCallback="DisplayDeviceInfoCallback"
  Name="@ViewModel!.Name" 
  DeviceOperationalStatusGetter="@ViewModel!.GetOperationalStatus">
  <div style="display: flex; flex-direction: column">
    <span>Address: @ViewModel.Address</span>
    <span>Type: @ViewModel.Type</span>
    <span>Version: @ViewModel.Version</span>
    <span>@ViewModel.Description</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Device", ds => @<RemoteDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if(result is true && viewModel.Modified)
    {
      await ViewModel.SaveCommand.Execute();
    }
  }

  private async Task SettingCallback()
  {
    await DialogService.OpenAsync("Device Settings", ds => @<RemoteDeviceSettingsEditorView ViewModel="@ViewModel" OnValidSubmit="() => ds.Close(true)"/>);    
    await ViewModel!.PushSettingsCommand.Execute();
    StateHasChanged();
   }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Name}?");
    if (result is true)
    {
      await ViewModel!.RemoveCommand.Execute();
    }
  }

  private async Task DisplayDeviceInfoCallback()
  {
    var status = await ViewModel!.GetOperationalStatus();
    var options = new DialogOptions() { Width = "800px" };
    await DialogService.OpenAsync("Device Capabilities", ds => @<DeviceInfoContainer DeviceName="@ViewModel!.Name" DeviceCommands="@ViewModel!.DeviceCommands" OperationalState="@status.OperationalState"/>, options);
  }

  private async Task RefreshCallback()
  {
    await ViewModel!.UpdateInfoCommand.Execute().ToTask();
    await ViewModel!.UpdateStateCommand.Execute().ToTask();
    await ViewModel!.FetchSettingsCommand.Execute().ToTask();
  }

  protected override Task OnInitializedAsync()
  {
    return RefreshCallback();
  }
}
