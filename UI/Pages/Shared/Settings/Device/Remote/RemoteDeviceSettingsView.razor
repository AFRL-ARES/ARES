@using System.Reactive.Linq
@using System.Reactive.Threading.Tasks
@using Ares.Datamodel
@using Ares.Services
@using UI.Backend.ViewModels.Settings.Device.Remote
@inherits ReactiveUI.Blazor.ReactiveComponentBase<RemoteDeviceSettingsViewModel>
@inject DialogService DialogService

<DeviceSettingsContainer 
  EditCallback="EditCallback"
  SettingsCallback="SettingCallback"
  RemoveCallback="RemoveCallback" 
  Name="@ViewModel!.Name" 
  DeviceOperationalStatusGetter="@ViewModel!.GetOperationalStatus">
  <div style="display: flex; flex-direction: column">
    <span>Address: @ViewModel.Address</span>
    <span>Type: @ViewModel.Type</span>
    <span>Version: @ViewModel.Version</span>
    <span>@ViewModel.Description</span>
  </div>
</DeviceSettingsContainer>

@code {
  async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Device", ds =>
      @<RemoteDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel.SaveCommand.Execute();
    }
  }

  private async Task SettingCallback()
  {
    var viewModel = ViewModel!.SettingsEditorViewModel;
    var result = await DialogService.OpenAsync("Device Settings", ds => @<RemoteDeviceSettingsEditorView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);
    
    if(result is true && viewModel!.Modified)
    {
      await ViewModel!.SaveAsync();
      StateHasChanged();
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Name}?");
    if (result is true)
    {
      await ViewModel!.RemoveCommand.Execute();
    }
  }

  private async Task RefreshCallback()
  {
    await ViewModel!.UpdateInfoCommand.Execute().ToTask();
    await ViewModel!.UpdateStateCommand.Execute().ToTask();
  }

  protected override Task OnInitializedAsync()
  {
    return RefreshCallback();
  }
}
