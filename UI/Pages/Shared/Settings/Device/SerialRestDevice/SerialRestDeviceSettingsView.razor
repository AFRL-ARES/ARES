@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.SerialRestDevice.SerialRestDeviceSettingsViewModel>
@inject DialogService DialogService
@inject NotificationService NotificationService


<DeviceSettingsContainer DeviceStatusGetter="ViewModel!.GetDeviceStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.Config.Name">
  <div>
    @if (ViewModel!.Config.Simulated)
    {
      <span> Simulated Rest Serial Device -- </span>
    }

    <span>@ViewModel!.Config.Name</span>
    <span>@ViewModel!.Config.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
    private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Rest Serial Device", ds =>
      @<SerialRestDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Notify(NotificationSeverity.Success, "Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Config.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

}
