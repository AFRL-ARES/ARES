@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.RestDevice.RestDeviceSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService


<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.Config.Name">
  <div>
    @if(ViewModel!.Config.Simulated)
    {
      <span> Simulated Rest Device -- </span>
    }

    <span>@ViewModel!.Config.Name</span>
    <span>@ViewModel!.Config.Address</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Rest Device", ds =>
      @<RestDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Config.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}
