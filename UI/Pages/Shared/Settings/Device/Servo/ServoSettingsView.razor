@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.Servo.ServoSettingsViewModel>
@inject DialogService DialogService
@inject NotificationService NotificationService


<DeviceSettingsContainer DeviceStatusGetter="ViewModel!.GetDeviceStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.ServoConfig.Name">
  <div>
    @if (ViewModel!.ServoConfig.Simulated)
    {
      <span> Simulated Servo -- </span>
    }

    <span>@ViewModel!.ServoConfig.Name</span>
    <span>@ViewModel!.ServoConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
    private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Servo", ds =>
      @<ServoConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Notify(NotificationSeverity.Success, "Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.ServoConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

}
