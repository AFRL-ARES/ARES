@using Ares.Alicat.Mfc.Config
@using UI.Backend.ViewModels.Settings.Device.Mfc
@using Ares.Alicat.Mfc.Messaging
@inherits ReactiveUI.Blazor.ReactiveComponentBase<MfcSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService

<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus"
                         EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="@ViewModel.Activate" Name="@Name">
  <div class="d-flex flex-column">
    <div>
      <span>Port - </span>
      <span>@ViewModel!.MfcConfig.PortName</span>
    </div>

    @if (ViewModel!.DeviceActive)
    {
      <div class="">
        @if (_changing)
        {
          <div class="disabled-overlay d-flex align-items-center justify-content-center">
            <div>
              <LoadingSpinner SpinnerSize="SpinnerSize.Small" />
            </div>
          </div>
        }
        <div class="mfc-settings-col1">
          <span class="flex-fill">Current Gas</span>
          <span class="flex-fill">@ViewModel!.CurrentGas</span>
          @if (ViewModel!.AvailableGases is not null)
          {
            <select disabled="@_changing" class="form-select-sm" @bind="ViewModel!.TargetGas">
              @foreach (var gas in ViewModel!.AvailableGases)
              {
                <option selected="@ViewModel!.CurrentGas?.Equals(gas, StringComparison.InvariantCultureIgnoreCase)">
                  @gas
                </option>
              }
            </select>
            <button disabled="@_changing" class="btn btn-sm" @onclick="ChangeGasClicked">Submit</button>
          }

          <span class="flex-fill">Current Id</span>
          <span class="flex-fill">@ViewModel!.CurrentId</span>
          @if (ViewModel!.AvailableIds is not null)
          {
            <select disabled="@_changing" class="form-select-sm" @bind="ViewModel!.TargetId">
              <option disabled>@ViewModel!.CurrentId</option>
              @foreach (var id in ViewModel!.AvailableIds)
              {
                <option>@id</option>
              }
            </select>
            <button disabled="@_changing" class="btn btn-sm" @onclick="ChangeIdClicked">Submit</button>
          }
          @if (ViewModel!.MfcConfig.MfcType == MfcType.Basis2)
          {
            <span class="flex-fill">Setpoint Source</span>
            <span class="flex-fill">@ViewModel!.SelectedSetpointSource</span>
            <select class="form-select-sm"                    
                    disabled="@(_changing || ViewModel!.SetpointSourceUpdating)"
                    @bind="SelectedSetpointSourceValue">
              <option value="@SetpointSource.UnknownSource" disabled hidden>Select a source</option>
              @foreach (var source in ViewModel!.AvailableSetpointSources)
              {
                <option value="@source">@source</option>
              }
            </select>
            @if (ViewModel!.SetpointSourceUpdating)
            {
              <span class="ms-2 d-flex align-items-center">
                <LoadingSpinner SpinnerSize="SpinnerSize.Small" />
              </span>
            }
          }
        </div>
      </div>
    }
    else if(_initActive)
    {
      <LoadingSpinner />
    }
  </div>
</DeviceSettingsContainer>

@code {
  private bool _initActive;
  private bool _changing;

  private string Name => ViewModel!.MfcConfig.Name + (ViewModel!.MfcConfig.Simulated ? " -- (Simulated)" : "");

  protected override async Task OnInitializedAsync()
  {
    _initActive = true;
    StateHasChanged();
    await ViewModel!.Init();
    _initActive = false;
    StateHasChanged();
  }

  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit MFC", ds =>
      @<MfcConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.MfcConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

  private async Task ChangeIdClicked()
  {
    _changing = true;
    await ViewModel!.ChangeId();
    await ViewModel!.Init();
    _changing = false;
    StateHasChanged();
  }

  private async Task ChangeGasClicked()
  {
    _changing = true;
    try
    {
      await ViewModel!.ChangeGas();
    }
    catch(TimeoutException)
    {
      NotificationService.Error("Gas change command timed out.");
    }
    await ViewModel!.Init();
    _changing = false;
    StateHasChanged();
  }

  private string SelectedSetpointSourceValue
  {
    get => ViewModel?.SelectedSetpointSource.ToString() ?? SetpointSource.UnknownSource.ToString();
    set
    {
      if (ViewModel is null)
        return;

      if (!Enum.TryParse<SetpointSource>(value, out var parsed))
        return;

      if (ViewModel.SetpointSourceUpdating || ViewModel.SelectedSetpointSource == parsed)
        return;

      _ = InvokeAsync(() => ChangeSetpointSourceAsync(parsed));
    }
  }

  private async Task ChangeSetpointSourceAsync(SetpointSource source)
  {
    await ViewModel!.UpdateSetpointSource(source);
    StateHasChanged();
  }
}