@using UI.Backend.ViewModels.Settings.Device.Mfc
@using System.Diagnostics
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inherits ReactiveUI.Blazor.ReactiveComponentBase<MfcSettingsViewModel>
@inject DialogService DialogService
@inject NotificationService NotificationService

<DeviceSettingsContainer DeviceStatusGetter="ViewModel!.GetDeviceStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="@ViewModel.Activate" Name="@Name">
  <div class="d-flex flex-column">
    <div>
      <span>Port - </span>
      <span>@ViewModel!.MfcConfig.PortName</span>
    </div>
    
    @if (ViewModel!.DeviceActive)
    {
      <div class="mfc-settings-grid">
        @if (_changing)
        {
          <div class="disabled-overlay d-flex align-items-center justify-content-center">
            <div><LoadingSpinner SpinnerSize="SpinnerSize.Small"/></div>
          </div>
        }
        <div class="mfc-settings-col1">
          <span class="flex-fill">Current Gas</span>
          <span class="flex-fill">@ViewModel!.CurrentGas</span>
          @if (ViewModel!.AvailableGases is not null)
          {
            <select disabled="@_changing" class="form-select-sm" @bind="ViewModel!.TargetGas">
              @foreach (var gas in ViewModel!.AvailableGases)
              {
                <option selected="@ViewModel!.CurrentGas?.Equals(gas, StringComparison.InvariantCultureIgnoreCase)">@gas</option>
              }
            </select>
            <button disabled="@_changing" class="btn btn-sm" @onclick="ChangeGasClicked">Submit</button>
          }

          <span class="flex-fill">Current Id</span>
          <span class="flex-fill">@ViewModel!.CurrentId</span>
          @if (ViewModel!.AvailableIds is not null)
          {
            <select disabled="@_changing" class="form-select-sm" @bind="ViewModel!.TargetId">
              <option disabled>@ViewModel!.CurrentId</option>
              @foreach (var id in ViewModel!.AvailableIds)
              {
                <option>@id</option>
              }
            </select>
            <button disabled="@_changing" class="btn btn-sm" @onclick="ChangeIdClicked">Submit</button>
          }
        </div>
      </div>
    }else if (_initActive)
    {
      <LoadingSpinner />
    }
  </div>
</DeviceSettingsContainer>

@code {
  private bool _initActive;
  private bool _changing;

  private string Name => ViewModel!.MfcConfig.Name + (ViewModel!.MfcConfig.Simulated ? " -- (Simulated)" : "");

  protected override async Task OnInitializedAsync()
  {
    _initActive = true;
    StateHasChanged();
    await ViewModel!.Init();
    _initActive = false;
    StateHasChanged();
  }

  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit MFC", ds =>
      @<MfcConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Notify(NotificationSeverity.Success, "Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.MfcConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

  private async Task ChangeIdClicked()
  {
    _changing = true;
    await ViewModel!.ChangeId();
    await ViewModel!.Init();
    _changing = false;
    StateHasChanged();
  }

  private async Task ChangeGasClicked()
  {
    _changing = true;
    try 
    {
      await ViewModel!.ChangeGas();
    }
    catch(TimeoutException)
    {
      NotificationService.Notify(NotificationSeverity.Error, "Gas change command timed out.");
    }
    await ViewModel!.Init();
    _changing = false;
    StateHasChanged();
  }
}