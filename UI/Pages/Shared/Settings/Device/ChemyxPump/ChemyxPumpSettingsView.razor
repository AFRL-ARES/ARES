@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.ChemyxPump.ChemyxPumpSettingsViewModel>
@inject DialogService DialogService
@inject NotificationService NotificationService


<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.PumpConfig.Name">
  <div>
    @if (ViewModel!.PumpConfig.Simulated)
    {
      <span> Simulated Chemyx Pump -- </span>
    }

    <span>@ViewModel!.PumpConfig.Name</span>
    <span>@ViewModel!.PumpConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
    private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Chemyx Pump", ds =>
      @<ChemyxPumpConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if(result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Notify(NotificationSeverity.Success, "Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.PumpConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

}
