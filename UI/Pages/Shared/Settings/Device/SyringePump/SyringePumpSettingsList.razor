@page "/settings/device/syringe-pump"
@layout DeviceSettingsLayout
@using UI.Backend.ViewModels.Settings.Device.SyringePump
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<SyringePumpSettingsListViewModel>

@inject DialogService DialogService
@inject NotificationService NotificationService

@if (ViewModel!.SettingsViewModels is null)
{
  <LoadingSpinner />
}
else
{
  <div class="d-flex flex-column">
    @foreach (var pumpSettingsViewModel in ViewModel!.SettingsViewModels)
    {
      <div class="m-2">
        <SyringePumpSettingsView ViewModel="pumpSettingsViewModel"/>
      </div>
    }
    <button class="m-2 align-self-end btn btn-outline-light" disabled="@SavingInProgress" @onclick="AddConfigClick">
      @if (SavingInProgress)
      {
        <LoadingSpinner SpinnerSize="SpinnerSize.Small" />
      }
      else
      {
        <RadzenIcon Icon="add"/> 
      }
    </button>
  </div>
}

@code {
  private async Task AddConfigClick()
  {
    var viewModel = ViewModel!.GetNewConfigEditViewModel();
    var result = await DialogService.OpenAsync("New Syringe Pump", ds =>
      @<SyringePumpConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    if (result is true)
    {
      SavingInProgress = true;
      StateHasChanged();
      try
      {
        await ViewModel!.AddNewConfig(viewModel.Save());
        NotificationService.Notify(NotificationSeverity.Success, $"Successfully added MFC {viewModel.Name}");
      }
      catch (Grpc.Core.RpcException e)
      {
        NotificationService.Notify(NotificationSeverity.Error, e.InnerException?.Message ?? e.Message);
      }
      finally
      {
        SavingInProgress = false;
        StateHasChanged();
      }
    }
  }

  private bool SavingInProgress { get; set; }
}
