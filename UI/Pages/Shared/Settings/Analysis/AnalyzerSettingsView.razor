@using Ares.Datamodel
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using UI.Pages.Shared.Settings.Analysis.Layout
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Analysis.AnalyzerSettingsViewModel>
@inject DialogService DialogService

<AnalyzerSettingsContainer EditCallback="EditCallback" RemoveCallback="RemoveCallback" StateUpdateCallback="UpdateStateCallback" Name="@ViewModel!.Name" State="@ViewModel!.AnalyzerState" StateMessage="@ViewModel!.StateMessage" UpdatingInProgress="@UpdateInProgress">
  <div style="display: flex; flex-direction: column">
    <span>Address: @ViewModel!.Address</span>
    <span>Type: @ViewModel!.Type</span>
    <span>Version: @ViewModel!.Version</span>
    <span>@ViewModel!.Description</span>
    <div style="display: flex; flex-direction: column">
      @foreach (var settingField in ViewModel!.Settings.Fields)
      {
        <AresValueDesigner Name="@settingField.Key" Value="@settingField.Value" Schema="@ViewModel!.SettingsSchema.Fields[settingField.Key]" ValueEditCallback="@(value => ValueEditCallback(settingField.Key, value))" />
      }
    </div>
  </div>
</AnalyzerSettingsContainer>

@code {
  public bool UpdateInProgress { get; private set; }
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Analyzer", ds =>
      @<AnalyzerConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      // var notification = new AresNotification();
      // notification.Message = $"ARES successfully added the analyzer {viewModel.Name} utilizing the address {viewModel.Address}.";
      // notification.Title = $"Successfully Added Analyzer {viewModel.Name}!";
      // notification.NotificationSeverity = Severity.Success;
      // notification.Timestamp = DateTime.UtcNow.ToTimestamp();
      // ViewModel!.PushNotification(notification);
      StateHasChanged();
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

  private Task UpdateStateCallback()
  {
    return Update();
  }

  private async Task Update() {
    UpdateInProgress = true;
    await ViewModel!.UpdateState();
    await ViewModel!.UpdateInfo();
    await ViewModel!.FetchSettings();
    UpdateInProgress = false;
    StateHasChanged();
  }

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    _ = Update();
  }

  private Task ValueEditCallback(string name, AresValue value)
  {
    ViewModel!.Settings.Fields[name] = value;
    return ViewModel!.PushSettings();
  }
}
