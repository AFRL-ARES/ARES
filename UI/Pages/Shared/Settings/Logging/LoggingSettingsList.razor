@page "/settings/logging"
@using ReactiveUI.Blazor
@using UI.Backend.ViewModels.Settings.Logging
@layout SettingsLayout
@inherits ReactiveInjectableComponentBase<LoggingSettingsListViewModel>

@if (ViewModel!.LoggingSettingsViewModels is null)
{
  <LoadingSpinner />
}
else
{
  <div class="d-flex flex-column">
    @foreach (var vm in ViewModel.LoggingSettingsViewModels)
    {
      <div class="m-2">
        <LoggingSettingsEdit ViewModel="@vm" />
      </div>
    }
  </div>
}

@code {
  protected override async Task OnInitializedAsync()
  {
    await ViewModel!.FetchLoggers();
  }
}