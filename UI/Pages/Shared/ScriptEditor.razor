@using UI.JsInterops
@inject IJSRuntime JSRuntime

<StandaloneCodeEditor CssClass="h-100" @ref="_editor" Id="ares-editor" ConstructionOptions="EditorConstructionOptions" />

@code {
  private StandaloneCodeEditor _editor;

  [Parameter]
  public MonacoCompletionProvider? CompletionProvider { get; set; }

  [Parameter]
  public MonacoDiagnosticsProvider? DiagnosticsProvider { get; set; }

  public Task<string> GetScript() => _editor.GetValue();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      // Import the setup script as a JS Module
      // Ensure the path matches your actual file structure in wwwroot
      var setupModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/monaco/ares-setup.js");

      // Register the language with Monaco
      await setupModule.InvokeVoidAsync("registerAresLanguage");

      if(CompletionProvider is not null)
      {
        var completionModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/monaco/ares-autocomplete-setup.js");

        var reference = DotNetObjectReference.Create(CompletionProvider);

        await completionModule.InvokeVoidAsync("setupAutoComplete", reference);
      }

      if(DiagnosticsProvider is not null)
      {
        var diagnosticsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/monaco/ares-diagnostics-setup.js");

        var reference = DotNetObjectReference.Create(DiagnosticsProvider);

        await diagnosticsModule.InvokeVoidAsync("setupDiagnostics", reference);
      }
    }
  }

  private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
  {
    return new StandaloneEditorConstructionOptions
    {
      Language = "ares",
      AutomaticLayout = true,
      Value = "# Welcome to ARES\ndef main():\n    return True\n"
    };
  }
}
