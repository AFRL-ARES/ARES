<NavLink type="button" class="px-4 py-2 btn btn-outline-light" href="@Path">
    <RadzenIcon Icon="@Icon" />
</NavLink>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Path { get; set; }
}
