@using UI.Backend.ViewModels.StepperController
@using DynamicData.Binding

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<StepperControllerMultiViewModel>

@foreach (var device in ViewModel!.ConnectedSerialDeviceUnitControlVms)
{
  <div class="m-2 d-flex flex-wrap">
    <DashboardWidget>
      <StepperControllerWidgetView ViewModel="@device" />
    </DashboardWidget>
  </div>
}

@code {
  protected override Task OnInitializedAsync()
  {
    ViewModel!.ConnectedSerialDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }
}
