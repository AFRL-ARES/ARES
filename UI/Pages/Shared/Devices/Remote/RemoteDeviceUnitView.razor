@using UI.Backend.Devices
@using UI.Backend.ViewModels.Devices.Remote
@inject TooltipService TooltipService
@inherits ReactiveUI.Blazor.ReactiveComponentBase<RemoteDeviceUnitViewModel>

<RadzenFieldset class="device-fieldset">
  <HeaderTemplate>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
      <RadzenText Text="@ViewModel.DeviceName" TItem="string" />
      @if (ViewModel.ConnectionStatus == ConnectionStatus.ConnectedToDevice)
      {
        <RadzenIcon @ref="_connectedIcon" Icon="link" class="rz-color-success"
          @onmouseenter="@(args => ShowTooltip(_connectedIcon.Element, "Connected to Service and Device"))" />
      }
      else if (ViewModel!.ConnectionStatus == ConnectionStatus.ConnectedToService)
      {
        <RadzenIcon @ref="_serviceConnectedIcon" Icon="link" class="rz-color-warning"
          @onmouseenter="@(args => ShowTooltip(_serviceConnectedIcon.Element, "Connected to Service but not Device"))" />
      }
      else if (ViewModel.ConnectionStatus == ConnectionStatus.Disconnected)
      {
        <RadzenIcon @ref="_disconnectedIcon" Icon="link_off" class="rz-color-danger"
          @onmouseenter="@(args => ShowTooltip(_disconnectedIcon.Element, "Disconnected"))" />
      }
    </RadzenStack>
  </HeaderTemplate>
  <ChildContent>
    @foreach (var field in ViewModel!.DeviceState.Fields)
    {
      <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
        <RadzenColumn Size="4" class="d-flex justify-content-end">
          <RadzenLabel Text="@field.Key" />
        </RadzenColumn>
        <RadzenColumn Size="8">
          <AresValueDisplay Value="@field.Value" />
        </RadzenColumn>
      </RadzenRow>
    }
  </ChildContent>
</RadzenFieldset>

@code {
  private RadzenIcon? _connectedIcon;
  private RadzenIcon? _serviceConnectedIcon;
  private RadzenIcon? _disconnectedIcon;

  void ShowTooltip(ElementReference elementReference, string text)
  {
    TooltipService.Open(elementReference, text, new TooltipOptions { Position = TooltipPosition.Top });
  }
}