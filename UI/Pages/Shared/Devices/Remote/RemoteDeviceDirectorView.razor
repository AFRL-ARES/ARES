@using UI.Backend.ViewModels.Devices.Remote
@using DynamicData.Binding

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<RemoteDeviceDirectorViewModel>

@foreach(var deviceVm in ViewModel!.RemoteDeviceUnitViewModels)
{
  <div class="d-flex flex-wrap">
    <DashboardWidget>
      <RemoteDeviceUnitView ViewModel="@deviceVm" />
    </DashboardWidget>
  </div>
}

@code {
  protected override Task OnInitializedAsync()
  {
    ViewModel!.RemoteDeviceUnitViewModels.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    // ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }
}
