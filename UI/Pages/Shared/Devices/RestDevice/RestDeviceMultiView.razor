@using DynamicData.Binding;
@using UI.Backend.ViewModels.Devices.RestDevice;
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<RestDeviceMultiViewModel>

@foreach (var device in ViewModel!.ConnectedUsbDeviceUnitControlVms)
{
	<div class="d-flex flex-wrap">
		<DashboardWidget>
			<RestDeviceUnitControl ViewModel="@device" />
		</DashboardWidget>
	</div>
}

@code {
	protected override Task OnInitializedAsync()
	{
		ViewModel!.ConnectedUsbDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
		ViewModel.Start(TimeSpan.FromSeconds(5));
		return base.OnInitializedAsync();
	}
}
