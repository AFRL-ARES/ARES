@using UI.Backend.ViewModels.Devices.VerdiLaser
@inherits ReactiveUI.Blazor.ReactiveComponentBase<VerdiLaserUnitControlViewModel>
@inject TooltipService tooltipService
@inject NotificationService notificationService

<RadzenText Text="@ViewModel!.DeviceName" TextAlign="TextAlign.Center" TextStyle="TextStyle.DisplayH6"/>

<RadzenRow>
	<RadzenColumn>
		<RadzenStack Orientation="Orientation.Vertical" Gap="10px" AlignItems="AlignItems.Stretch">
			<RadzenFormField Text="Laser Power" Variant="Variant.Outlined">
				<RadzenNumeric @bind-Value="ViewModel!.DesiredLaserPower" ShowUpDown="false"/>
			</RadzenFormField>
			<RadzenButton Icon="save" BusyText="Saving ..." Text="Save Laser Power" IsBusy=ViewModel!.IsSavingPowerLevel Click=ViewModel!.SetLaserPower />
		</RadzenStack>
	</RadzenColumn>

	<RadzenColumn>
		<RadzenStack Orientation="Orientation.Vertical" Gap="10px" AlignItems="AlignItems.Stretch" Style="min-width: 200px">
			<RadzenFormField>
				<RadzenToggleButton Text="Activate Laser" ButtonStyle="ButtonStyle.Success" ToggleButtonStyle="ButtonStyle.Danger" @bind-Value="ViewModel!.LaserOn" Click="NotifyLaserActivated"/>
			</RadzenFormField>
			<RadzenToggleButton Text="Toggle Shutter" ButtonStyle="ButtonStyle.Primary" ToggleShade="Shade.Light" @bind-Value="ViewModel!.IsLaserShutterOn"/>
		</RadzenStack>
	</RadzenColumn>
</RadzenRow>

@code {
	private void NotifyLaserActivated()
	{
		var notification = new NotificationMessage();
		notification.Duration = 5000;
		notification.CloseOnClick = true;

		if(!ViewModel!.LaserOn)
		{
			notification.Severity = NotificationSeverity.Error;
			notification.Detail = "The Verdi V6 Laser has been activated! Ensure proper safety measures are taken!";
			notification.Summary = "LASER ACTIVATED!";
		}

		else
		{
			notification.Severity = NotificationSeverity.Success;
			notification.Detail = "The Verdi V6 Laser has been deactivated.";
			notification.Summary = "Laser Deactivated";
		}

		notificationService.Notify(notification);
	}
}
