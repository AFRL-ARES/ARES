@using UI.Backend.ViewModels.Devices.HerkulexDRS
@inherits ReactiveUI.Blazor.ReactiveComponentBase<ServoUnitControlViewModel>
@inject TooltipService tooltipService

<RadzenRow>
  <RadzenColumn>
    <RadzenText TextStyle="TextStyle.H6"> Servo Controls </RadzenText>
  </RadzenColumn>

  <RadzenColumn>
    <RadzenButton Click="@(args => ViewModel!.PistonUp())" Icon="arrow_upward" MouseEnter="@(args => ShowRaiseServotip(args) )" Size="ButtonSize.Large" />
  </RadzenColumn>

  <RadzenColumn>
    <RadzenButton Click=@(args => ViewModel!.PistonDown()) Icon="arrow_downward" MouseEnter="@(args => ShowLowerServotip(args) )" Size="ButtonSize.Large" />
  </RadzenColumn>

  <RadzenColumn>
    <RadzenButton Click=@(args => ViewModel!.ServoReset()) Icon="restart_alt" MouseEnter="@(args => ShowResetServotip(args) )" Size="ButtonSize.Large" />
  </RadzenColumn>
</RadzenRow>


@code {
  void ShowRaiseServotip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Raise Servo", options);
  void ShowLowerServotip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Lower Servo", options);
  void ShowResetServotip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Reset Servo", options);
}