@using DynamicData.Binding
@using UI.Backend.Devices
@using UI.Backend.ViewModels.Devices.Mfc

@implements IDashboardControlWidget
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<MfcDirectorControlViewModel>

@if (ViewModel!.ConnectedSerialDeviceUnitControlVms.Any())
{
  <div class="d-flex gap-2 overflow-auto">
  @foreach (var mfcControlVm in ViewModel!.ConnectedSerialDeviceUnitControlVms)
  {
    <div class="flex-shrink-0">
      <DashboardWidget>
        <MfcUnitControl ViewModel="mfcControlVm"></MfcUnitControl>
      </DashboardWidget>
    </div>
  }
  </div>
}

@code {
  protected override Task OnInitializedAsync()
  {
    ViewModel!.ConnectedSerialDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }

  public int DefaultWidth => 20;
  public int DefaultHeight => 35;
}
