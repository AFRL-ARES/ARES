@using DynamicData.Binding;
@using UI.Backend.ViewModels.Devices.CM3Camera;
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<CM3CameraMultiViewModel>


@foreach (var device in ViewModel!.ConnectedUsbDeviceUnitControlVms)
{
  <div class="d-flex flex-wrap">
    <DashboardWidget>
      <CM3CameraControlWidgetView ViewModel="@device" />
    </DashboardWidget>
  </div>
}

@code {
  protected override Task OnInitializedAsync()
  {
    ViewModel!.ConnectedUsbDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }

}
