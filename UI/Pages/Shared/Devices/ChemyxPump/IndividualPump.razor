@using UI.Backend.ViewModels.Devices.ChemyxPump
@using ChemyxPumpPlugin.Services
@using System.Reactive.Linq
@inherits ReactiveUI.Blazor.ReactiveComponentBase<IndividualPumpViewModel>
@implements IAsyncDisposable

@if(ViewModel == null)
{
  <p><em>Loading Pump...</em></p>
}
else
{
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="m-0">💉 Pump #@ViewModel.PumpNumber</h5>
    </div>

    <div class="card-body">
      <div class="row mb-4">
        <div class="col-12">
          <div class="d-flex justify-content-between mb-1">
            <span><strong>Dispensed:</strong> @ViewModel.Dispensed.ToString("F2") / @ViewModel.Volume.ToString("F2")</span>
            <span><strong>Elapsed:</strong> @ViewModel.Elapsed.ToString(@"hh\:mm\:ss")</span>
          </div>

          <div class="progress" style="height: 25px;">
            <div class="progress-bar progress-bar-striped @(ViewModel.Status != ChemyxPumpPlugin.PumpStatus.Stopped ? "progress-bar-animated" : "") @GetProgressColor()"
                 role="progressbar"
                 style="width: @(CalculateProgress())%;"
                 aria-valuenow="@ViewModel.Dispensed"
                 aria-valuemin="0"
                 aria-valuemax="@ViewModel.Volume">
              @CalculateProgress().ToString("F0")%
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-center gap-2 mb-4">
        <button class="btn btn-success btn-lg" @onclick="ViewModel.StartPump">
          <i class="oi oi-play-circle"></i> Start
        </button>
        <button class="btn btn-warning btn-lg" @onclick="ViewModel.PausePump">
          <i class="oi oi-media-pause"></i> Pause
        </button>
        <button class="btn btn-danger btn-lg" @onclick="ViewModel.StopPump">
          <i class="oi oi-media-stop"></i> Stop
        </button>
      </div>

      <hr />

      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Rate</label>
          <div class="input-group">
            <input type="number" step="0.01"
                   class="form-control"
                   value="@ViewModel.Rate"
                   @onchange="@(e => UpdateRate(e.Value))" />
            <span class="input-group-text">Rate</span>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label">Units</label>
          <select class="form-select" value="@ViewModel.PumpUnit" @onchange="@(e => UpdateUnit(e.Value))">
            @foreach(var unit in IndividualPumpViewModel.AvailableUnits)
            {
              <option value="@unit">@unit</option>
            }
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Target Volume</label>
          <div class="input-group">
            <input type="number" step="0.1"
                   class="form-control"
                   value="@ViewModel.Volume"
                   @onchange="@(e => UpdateVolume(e.Value))" />
            <span class="input-group-text">Vol</span>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Delay (HH:MM:SS)</label>
          <input type="text"
                 class="form-control"
                 value="@ViewModel.Delay.ToString()"
                 @onchange="@(e => UpdateDelay(e.Value))"
                 placeholder="00:00:00" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Target Time (HH:MM:SS)</label>
          <input type="text"
                 class="form-control"
                 value="@ViewModel.Time.ToString()"
                 @onchange="@(e => UpdateTime(e.Value))"
                 placeholder="00:00:00" />
        </div>
      </div>

      <div class="mt-3 text-end">
        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewModel.ForceUpdate()">
          <i class="oi oi-reload"></i> Refresh Params
        </button>
      </div>
    </div>
  </div>
}

@code {
  double CalculateProgress()
  {
    if(ViewModel!.Volume <= 0) return 0;
    var percent = (ViewModel.Dispensed / ViewModel.Volume) * 100;
    percent = Math.Round(percent, 1);
    return Math.Clamp(percent, 0, 100);
  }

  // Dynamic color based on completion
  private string GetProgressColor()
  {
    var p = CalculateProgress();
    if(ViewModel!.Status == ChemyxPumpPlugin.PumpStatus.Paused) return "bg-warning";
    if(p >= 100) return "bg-success";
    if(p > 0) return "bg-primary";
    return "bg-secondary";
  }

  // --- Interaction Handlers ---
  // We use @onchange (trigger on blur/enter) rather than @bind-value:event="oninput"
  // to avoid sending an RPC command to the hardware on every single keystroke.

  private async Task UpdateRate(object? value)
  {
    if(double.TryParse(value?.ToString(), out double result))
    {
      await ViewModel!.SetRate(result);
    }
  }

  private async Task UpdateVolume(object? value)
  {
    if(double.TryParse(value?.ToString(), out double result))
    {
      await ViewModel!.SetVolume(result);
    }
  }

  private async Task UpdateUnit(object? value)
  {
    if(Enum.TryParse<Units>(value?.ToString(), out var result))
    {
      await ViewModel!.SetUnit(result);
    }
  }

  private async Task UpdateDelay(object? value)
  {
    if(TimeSpan.TryParse(value?.ToString(), out var result))
    {
      await ViewModel!.SetDelay(result);
    }
  }

  private async Task UpdateTime(object? value)
  {
    if(TimeSpan.TryParse(value?.ToString(), out var result))
    {
      await ViewModel!.SetTime(result);
    }
  }

  public ValueTask DisposeAsync()
  {
    return ViewModel!.DisposeAsync();
  }

  protected override void OnInitialized()
  {
    ViewModel!.Start();
    base.OnInitialized();
  }
}
