@using DynamicData.Binding
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<UI.Backend.ViewModels.SyringePump.SyringePumpWorkspaceControlViewModel>

@if (ViewModel!.ConnectedSerialDeviceUnitControlVms.Any())
{
  <div class="d-flex gap-2 flex-wrap">
    @foreach (var syringePumpUnitControlVm in @ViewModel!.ConnectedSerialDeviceUnitControlVms)
    {
      <DashboardWidget>
        <SyringePumpUnitControl ViewModel="syringePumpUnitControlVm" ></SyringePumpUnitControl>
      </DashboardWidget>
    }
  </div>
}

@code {

  protected override Task OnInitializedAsync()
  {
    ViewModel!.ConnectedSerialDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }

}