@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using Ares.SyringePump.Ne1000.Messaging
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.SyringePump.SyringePumpUnitControlViewModel>

<div class="d-block container m-0 p-0">
  <h2 class="text-center">@ViewModel.DeviceName</h2>
  <div class="text-center">
    <h3>@ViewModel.Status</h3>
  </div>
  <div class="d-flex">
    <table class="d-table my-2 table-bordered table-dark">
      <tbody class="d-block">
      <tr class="d-table-row">
        <td class="d-table-cell">Address</td>
        <td class="d-table-cell">@ViewModel!.CurrentState.Address</td>
        <td class="d-table-cell">
          <div class="d-flex">
            <input type="number" class="input-group bg-dark" @bind="ViewModel.TargetAddress"/>
            <input class="btn-secondary" type="submit" @onclick="ViewModel.SetAddress" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
        <td class="d-table-cell">Diameter</td>
        <td class="d-table-cell">@ViewModel.CurrentState.DiameterMm</td>
        <td>
          <div class="d-flex">
            <input class="input-group bg-dark d-inline-flex" type="number" @bind="ViewModel.TargetDiameterMm"/>
            <input class="btn-secondary d-inline-flex" type="submit" @onclick="ViewModel.SetDiameter" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
        <td class="d-table-cell">Phase</td>
        <td class="d-table-cell ">@ViewModel.CurrentState.Phase?.Number</td>
        <td class="d-table-cell">
          <div class="d-flex">
            <input type="number" class="input-group bg-dark" @bind="ViewModel.TargetPhase"/>
            <input class="btn-secondary" type="submit" @onclick="ViewModel.SetPhase" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
        <td class="d-table-cell">Function</td>
        <td class="d-table-cell">@ViewModel.CurrentState.Phase?.Function</td>
        <td class="d-table-cell">
          <div class="d-flex">
            <select @bind="ViewModel.TargetFunction" class="form-select bg-dark text-light">
              @foreach (var function in Enum.GetValues<Commands>().Skip(1))
              {
                <option value="@function">@($"{function:G}".ToUpperInvariant())</option>
              }
            </select>
            <input class="btn-secondary d-inline-flex" type="submit" @onclick="ViewModel.SetPhaseFunction" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
        <td class="d-table-cell">Rate (@($"{ViewModel.CurrentState.RateUnits:G}"))</td>
        <td class="d-table-cell">@ViewModel.CurrentState.Phase?.Rate</td>
        <td class="d-table-cell">

          <div class="d-flex">
            <input type="number" class="input-group bg-dark" @bind="ViewModel.TargetRateMmpm"/>
            <input class="btn-secondary" type="submit" @onclick="ViewModel.SetPhaseFunctionRate" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
          <td class="d-table-cell">Volume (@($"{ ViewModel.CurrentState.VolumeUnits:G}"))</td>
        <td class="d-table-cell">@ViewModel.CurrentState.Phase?.Volume</td>
        <td class="d-table-cell">

          <div class="d-flex">
            <input type="number" class="input-group bg-dark" @bind="ViewModel.TargetVolumeMl"/>
            <input class="btn-secondary" type="submit" @onclick="ViewModel.SetPhaseFunctionVolume" value="Set"/>
          </div>
        </td>
      </tr>
      <tr class="d-table-row">
        <td class="d-table-cell">Direction</td>
        <td class="d-table-cell">@($"{ViewModel.CurrentState.Phase?.Direction}" ?? "")</td>
        <td class="d-table-cell">
          <div class="d-flex">
            <select @bind="ViewModel.TargetDirection" class="form-select bg-dark text-light">
              @foreach (var direction in Enum.GetValues<Direction>().Skip(1))
              {
                <option value="@direction">@($"{direction:G}".ToUpperInvariant())</option>
              }
            </select>
            <input class="btn-secondary d-inline-flex" type="submit" @onclick="ViewModel.SetPhaseFunctionDirection" value="Set"/>
          </div>
        </td>
      </tr>
      </tbody>
    </table>
  </div>
  <div class="d-flex">
    <div class="d-block m-2">
      <p>Infused: @ViewModel.CurrentState.DispensedVolume</p>
    </div>
    <div class="d-block m-2">
      <p>Withdrawn: @ViewModel.CurrentState.WithdrawnVolume</p>
    </div>
    <div class="d-block m-2">
      <input type="submit" class="btn-secondary w-100" value="Purge" @onclick="ViewModel.Purge" />
      <input type="submit" class="btn-secondary w-100" value="Clear" @onclick="ViewModel.ClearVolumeDispensed" />
    </div>
  </div>
  <div class="d-flex m-1">
    <input type="submit" class="btn-secondary w-100" value="Start" @onclick="ViewModel.Start" />
    <input type="submit" class="btn-secondary w-100" value="Stop/Pause" @onclick="ViewModel.Stop"/>
  </div>
</div>


@code {

}
