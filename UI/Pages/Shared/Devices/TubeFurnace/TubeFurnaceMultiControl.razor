@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using DynamicData.Binding
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<UI.Backend.ViewModels.TubeFurnace.TubeFurnaceMultiViewModel>


<div>
  <div class="d-flex flex-wrap">
    @foreach (var tubeFurnaceControlVm in @ViewModel!.ConnectedSerialDeviceUnitControlVms)
    {
      <DashboardWidget>
        <TubeFurnaceControl ViewModel="tubeFurnaceControlVm" ></TubeFurnaceControl>
      </DashboardWidget>
    }
  </div>
</div>

@code {

  protected override Task OnInitializedAsync()
  {
    ViewModel!.ConnectedSerialDeviceUnitControlVms.ObserveCollectionChanges().Subscribe(_ => InvokeAsync(StateHasChanged));
    ViewModel.Start(TimeSpan.FromSeconds(5));
    return base.OnInitializedAsync();
  }

}