@page "/automation/execution"
@inject ContextMenuService ContextMenuService
@inject AresAutomation.AresAutomationClient AutomationClient
@using Ares.Messaging
@using System.Collections.ObjectModel
@using Google.Protobuf.WellKnownTypes
@using UI.Backend.Extensions
@using UI.Pages.Shared.CampaignEdit
@implements IDisposable
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<UI.Backend.ViewModels.Automation.ExecutionViewModel>

<PageTitle>Execution</PageTitle>

<h4 class="mb-4">Selected Template: @(ViewModel!.CampaignTemplate?.Name ?? "None")</h4>
<div class="d-flex gap-2 w-100">
  <div class="d-flex flex-fill flex-column gap-2">
    <div>
      <RadzenDropDown AllowClear="true" TValue="CampaignTemplate" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" Class="w-100"
                      Placeholder="Select..." Data="campaigns" TextProperty="Name" SelectedItem="ViewModel!.CampaignTemplate" Change=@(args => ViewModel!.SelectCampaignTemplate(args)) />
    </div>
    @if (ViewModel!.PlannerInfos.Any(p => p is not null))
    {
      <div class="border border-1 rounded-2 p-2">
        <div>Planners</div>
        @foreach (var planner in ViewModel!.PlannerInfos.Where(info => info is not null))
        {
          <DynamicComponent Type="GetTypeFromString(planner?.Type)"></DynamicComponent>
        }
      </div>
    }

    <div class="d-flex flex-column">
      @if (ViewModel!.CampaignTemplate is not null)
      {
        <div class="border border-1 rounded-2 p-2">
          <div class="d-flex flex-column">
            <h4>Campaign Preview</h4>
            @foreach (var experimentTemplate in ViewModel!.CampaignTemplate.ExperimentTemplates)
            {
              <ExperimentViewer ExperimentTemplate="@experimentTemplate" />
            }
          </div>
        </div>
      }
    </div>
  </div>
  <div class="d-flex flex-column gap-2">
    <div class="d-flex">
      <button class="btn btn-outline-info execution-button" disabled="@(CampaignActive || ViewModel!.CampaignTemplate is null)" @onclick="StartCampaign">
        <RadzenIcon Icon="play_arrow" />
      </button>
      <button class="btn btn-outline-info execution-button" disabled="@(CampaignPaused || !CampaignActive)" @onclick="ViewModel!.PauseCampaign">
        <RadzenIcon Icon="pause" />
      </button>
      <button class="btn btn-outline-info execution-button" disabled="@(!CampaignPaused)" @onclick="ViewModel!.ResumeCampaign">
        <RadzenIcon Icon="resume" />
      </button>
      <button class="btn btn-outline-info execution-button" disabled="@(!CampaignActive)" @onclick="ViewModel!.StopCampaign">
        <RadzenIcon Icon="stop" />
      </button>
    </div>

    @if (ViewModel!.CurrentStopCondition is not null)
    {
      <div class="border border-1 rounded-2 p-2">
        <div class="d-flex flex-column">
          <div>
            Condition: @ViewModel!.CurrentStopCondition.ActiveCondition
          </div>
          <div>@ViewModel!.CurrentStopCondition.Description</div>
        </div>
      </div>
    }
  
    <div class="d-flex flex-column">
      <h6>Desired number of experiments</h6>
      <input type="number" class="form-control" @bind="ViewModel!.ExperimentsToRun" />
      <button class="btn btn-outline-info" @onclick="ViewModel!.SetExperimentsToRun">SET</button>
    </div>

    <div class="d-flex flex-column">
      <h6>Desired experiment result</h6>
      <div class="d-flex gap-2">
        <input type="number" class="form-control" @bind="ViewModel!.DesiredResult" />
        <span>±</span>
        <input type="number" class="form-control" @bind="ViewModel!.DesiredLeeway" />
      </div>
      <button class="btn btn-outline-info" @onclick="ViewModel!.SetDesiredAnalysis">SET</button>
    </div>

    @if (ExperimentExecutionStatuses.Any())
    {
      <div class="border border-1 rounded-2 p-2">
        <div class="d-flex flex-column">
          <h4>Experiment Status</h4>
          @for (var i = 0; i < ExperimentExecutionStatuses.Count; i++)
          {
            var experimentStatus = ExperimentExecutionStatuses[i];
            var latestExperiment = i == ExperimentExecutionStatuses.Count - 1;

            <ul class="tree">
              <li>
                <details open="@latestExperiment">
                  <summary>Experiment: @experimentStatus.ExperimentId</summary>
                  <ul>
                    @foreach (var stepStatus in experimentStatus.StepExecutionStatuses)
                    {
                      <li>
                        <details open="@latestExperiment">
                          <summary>Step: @stepStatus.StepId</summary>
                          <ul>
                            @foreach (var commandStatus in stepStatus.CommandExecutionStatuses)
                            {
                              <li>
                                <div>Command: @commandStatus.CommandId -- @commandStatus.State</div>
                              </li>
                            }
                          </ul>
                        </details>
                      </li>
                    }
                  </ul>
                </details>
              </li>
            </ul>
          }
        </div>
      </div>
    }
  </div>

</div>
@code {
  List<CampaignTemplate> campaigns = new();
  Task? _statusStreamWatcher;
  CancellationTokenSource? _statusStreamWatcherCancellationTokenSource;
  ObservableCollection<ExperimentExecutionStatus> ExperimentExecutionStatuses { get; } = new ObservableCollection<ExperimentExecutionStatus>();

  protected override async Task OnInitializedAsync()
  {
    await ViewModel!.RefreshCampaigns();
    await ViewModel!.UpdateCurrentTemplate();
    campaigns = ViewModel!.Templates.ToList();

    var currentStatus = await ViewModel!.GetCampaignExecutionStatus();
    if (currentStatus is not null)
    {
      foreach (var experimentStatus in currentStatus.ExperimentExecutionStatuses)
      {
        ExperimentExecutionStatuses.Add(experimentStatus);
      }
    }
    _statusStreamWatcherCancellationTokenSource = new CancellationTokenSource();
    _statusStreamWatcher = SetupStreamWatch(_statusStreamWatcherCancellationTokenSource.Token);
  }

  protected override void Dispose(bool disposing)
  {
    _statusStreamWatcherCancellationTokenSource?.Cancel();
    base.Dispose(disposing);
  }

  public bool CampaignActive { get; set; }
  public bool CampaignPaused { get; set; }

  protected Task SetupStreamWatch(CancellationToken token)
  {
    return Task.Run(async () =>
    {
      var stream = AutomationClient.GetExecutionStatusStream(new Empty());
      while (await stream.ResponseStream.MoveNext(token) && !token.IsCancellationRequested)
      {
        var status = stream.ResponseStream.Current;
        CampaignActive = status.IsActive();
        CampaignPaused = status.IsPaused();
        var existingStatus = ExperimentExecutionStatuses.FirstOrDefault(s => s.ExperimentId == status.ExperimentId);
        if (existingStatus is null)
        {
          ExperimentExecutionStatuses.Add(status);
          existingStatus = status;
          continue;
        }

        var incomingCommands = status.GetCommandExecutionStatuses();
        var existingCommands = existingStatus.GetCommandExecutionStatuses();

        foreach (var existingCommand in existingCommands)
        {
          var newCommand = incomingCommands.FirstOrDefault(c => c.CommandId == existingCommand.CommandId);
          existingCommand.State = newCommand?.State ?? ExecutionState.Undefined;
        }

        await InvokeAsync(() => StateHasChanged());
      }
    });
  }

  protected void StartCampaign()
  {
    ExperimentExecutionStatuses.Clear();
    AutomationClient.StartExecution(new Empty());
  }

  System.Type? GetTypeFromString(string? type)
  {
    return type is null ? null : System.Type.GetType($"UI.Pages.Shared.Execution.Planning.{type}");
  }
}