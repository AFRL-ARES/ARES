@page "/automation/campaignlist"
@using UI.Backend.ViewModels.Automation.CampaignEdit
@inject DialogService DialogService
@using Ares.Messaging
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<CampaignListViewModel>

<div class="d-flex flex-column align-content-stretch">
    <div class="d-flex justify-content-evenly">
        <h2>Campaigns</h2>
        <div class="d-flex flex-fill justify-content-end">
            <a type="button" class="m-1 d-flex align-items-center btn btn-outline-light" href="automation/campaigndesigner">
                <RadzenIcon Icon="add"/>
            </a>
            <button class="m-1 btn btn-outline-light">
                <RadzenIcon Icon="refresh" />
            </button>
        </div>
    </div>
    <table class="table table-hover">
        <thead>
        <tr>
            <th>Campaign Name</th>
            <th>Campaign ID</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var template in ViewModel!.Templates)
        {
            <tr>
                <td style="padding: 10px; vertical-align: middle">
                    @template.Name
                </td>
                <td style="padding: 10px;vertical-align: middle">@template.UniqueId</td>
                <td style="width: 12%;vertical-align: middle">
                    <div class="d-flex justify-content-end">
                        <a type="button" class="mx-1 btn btn-outline-light" href="automation/campaigndesigner/@template.UniqueId">
                            <RadzenIcon Icon="edit"/>
                        </a>
                        <button class="mx-1 btn btn-outline-light" @onclick="() => DeleteClick(template)">
                            <RadzenIcon Icon="delete"></RadzenIcon>
                        </button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel!.RefreshCampaigns();
    }

    private async void DeleteClick(CampaignTemplate template)
    {
        var result = await DialogService.OpenAsync($"Delete campaign {template.Name}?", ds =>
            @<div class="d-flex flex-column">
                <div class="d-flex">
                    <button class="btn btn-danger btn-outline-light" @onclick="() => ds.Close(true)">Delete</button>
                    <button class="btn btn-secondary btn-outline-light" @onclick="() => ds.Close(false)">Cancel</button>
                </div>
            </div>
            );
        if (!result)
            return;

        await ViewModel!.DeleteCampaign(Guid.Parse(template.UniqueId));
        StateHasChanged();
    }

}
