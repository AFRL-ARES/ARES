@page "/visualization"
@using UI.Backend.ViewModels
@using UI.Pages.Shared.Components

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<VisualizationViewModel>
@inject IJSRuntime JS
<div class="grid-stack" id="visualization-board">
  <div class="grid-stack-item" gs-w="25" gs-size-to-content="true">
    <div class="grid-stack-item-content">
      <RadzenButton Variant="Variant.Outlined" Text="Add Chart" ButtonStyle="ButtonStyle.Primary"/>
    </div>
  </div>
</div>

<RightSidebar />


@code {
  private IJSObjectReference? _module;
  private DotNetObjectReference<Visualization>? _objRef;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      _objRef = DotNetObjectReference.Create(this);
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Visualization.razor.js");
      await _module.InvokeVoidAsync("initDashboard", "visualization-board", _objRef);
    }

    else
    {
      if(_module is not null)
      {
        await _module.InvokeVoidAsync("refreshGrid", "visualization-board");
        await _module.InvokeVoidAsync("resizeToContent", "visualization-board");
      }
    }

    //await base.OnAfterRenderAsync(firstRender);
  }
}
