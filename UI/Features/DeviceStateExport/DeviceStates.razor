@page "/device_states"
@using Ares.Services
@using Ares.Core.Grpc.Services
@inject DialogService DialogService
@inject AutomationService AutomationClient


@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<DeviceStatesViewModel>

<button class="btn btn-outline-primary" @onclick="OpenExporter">
  Export Device States
</button>

@code {
  private async Task OpenExporter()
  {
    await DialogService.OpenAsync("State Export", dialog =>
      @<DeviceStateExporter />
    );
  }
}
