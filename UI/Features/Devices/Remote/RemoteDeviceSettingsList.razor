@page "/settings/device/remote"
@layout DeviceSettingsLayout
@using Ares.Services
@using Google.Protobuf.WellKnownTypes
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<RemoteDeviceSettingsListViewModel>

@inject DialogService DialogService

@if (ViewModel!.SettingsViewModels is null)
{
  <LoadingSpinner />
}
else
{
  <div class="d-flex flex-column">
    @foreach (var vm in ViewModel!.SettingsViewModels)
    {
      <div class="m-2">
        <RemoteDeviceSettingsView ViewModel="vm"/>
      </div>
    }
    <button class="m-2 align-self-end btn btn-outline-light" disabled="@SavingInProgress" @onclick="AddDeviceClick">
      @if (SavingInProgress)
      {
        <LoadingSpinner SpinnerSize="SpinnerSize.Small" />
      }
      else
      {
        <RadzenIcon Icon="add"/> 
      }
    </button>
  </div>
}

@code {
  private async Task AddDeviceClick()
  {
    var viewModel = ViewModel!.GetNewConfigEditViewModel();
    var result = await DialogService.OpenAsync("New Device", ds =>
      @<RemoteDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    var notification = new UiNotificationMessage();

    if (result is true)
    {
      SavingInProgress = true;
      StateHasChanged();
      try
      {
        await ViewModel!.AddNewRemoteDevice(viewModel.Save());
      }
      catch (Grpc.Core.RpcException e)
      {
        notification.Summary = $"Failed to add Device {viewModel.Name}";
        notification.Detail = $"ARES was unable to add {viewModel.Name} as an available device. {e.Message}";
        notification.Severity = UiNotificationSeverity.Error;

        ViewModel!.PushNotification(notification);
      }
      finally
      {
        SavingInProgress = false;
        StateHasChanged();
      }
    }
  }

  private bool SavingInProgress { get; set; }
}