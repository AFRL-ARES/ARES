@page "/settings/device/remote"
@layout DeviceSettingsLayout
@using Ares.Core
@using Ares.Services
@using Grpc.Core
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<RemoteDeviceSettingsListViewModel>

@inject DialogService DialogService

@if (ViewModel!.SettingsViewModels is null)
{
  <LoadingSpinner />
}
else
{
  <div class="d-flex flex-column">
    @foreach (var vm in ViewModel!.SettingsViewModels)
    {
      <div class="m-2">
        <RemoteDeviceSettingsView ViewModel="vm"/>
      </div>
    }
    <button class="m-2 align-self-end btn btn-outline-light" disabled="@IsAddDisabled" @onclick="AddDeviceClick">
      @if (SavingInProgress)
      {
        <LoadingSpinner SpinnerSize="SpinnerSize.Small" />
      }
      else
      {
        <RadzenIcon Icon="add"/> 
      }
    </button>
  </div>
}

@code {
  private async Task AddDeviceClick()
  {
    if(IsAddDisabled)
      return;

    var viewModel = ViewModel!.GetNewConfigEditViewModel();
    var result = await DialogService.OpenAsync("New Device", ds => @<RemoteDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    if(result is true)
    {
      SavingInProgress = true;
      StateHasChanged();
      try
      {
        await ViewModel!.AddNewRemoteDevice(viewModel.Save());
      }
      catch(RpcException e)
      {
        var notification = new AresNotification()
        {
          Title = $"Failed to add Device {viewModel.Name}",
          Message = $"ARES was unable to add {viewModel.Name} as an available device. {e.Message}",
          NotificationSeverity = Severity.Error
        };

        ViewModel!.PushNotification(notification);
      }
      finally
      {
        SavingInProgress = false;
        StateHasChanged();
      }
    }
  }

  private bool SavingInProgress { get; set; }

  private bool IsAddDisabled => AresConfig.DemoMode || SavingInProgress;
}