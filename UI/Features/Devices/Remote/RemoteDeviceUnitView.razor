@using UI.Application.Devices
@using Ares.Datamodel.Device
@inherits ReactiveUI.Blazor.ReactiveComponentBase<RemoteDeviceUnitViewModel>
<RadzenFieldset class="device-fieldset remote-device-unit">
  <HeaderTemplate>
    <div class="remote-device__header">
      <div class="remote-device__identity">
        <div class="remote-device__identity-copy">
          <RadzenText Text="@ViewModel!.DeviceName" TextStyle="TextStyle.H6" TItem="string" />
        </div>
      </div>
      <span class="remote-device__status @GetStatusClass(ViewModel.ConnectionStatus)" title="@GetStatusDescription(ViewModel.ConnectionStatus)">
        <span class="remote-device__status-dot"></span>
        @GetStatusLabel(ViewModel.ConnectionStatus)
      </span>
    </div>
  </HeaderTemplate>
  <ChildContent>
    @if(ViewModel!.DeviceState?.Fields.Count > 0)
    {
      <section class="remote-device__state" aria-label="Live device state">
        <div class="remote-device__section-heading">
          <div>
            <span class="remote-device__section-kicker">Live state</span>
          </div>
          <span class="remote-device__section-count">@ViewModel.DeviceState.Fields.Count values</span>
        </div>
        <div class="remote-device__state-grid" style="--remote-device-state-columns: @ViewModel.StateColumnCount">
          @foreach(var field in ViewModel.DeviceState.Fields)
          {
            @if(ViewModel!.ShouldDisplay(field.Key))
            {
              <div class="remote-device__state-item">
                <span class="remote-device__state-label" title="@field.Key">@field.Key</span>
                <div class="remote-device__state-value">
                  <AresValueDisplay Value="@field.Value" />
                </div>
              </div>
            }
          }
        </div>
      </section>
    }
    else
    {
      <div class="remote-device__empty-state">
        <RadzenIcon Icon="hourglass_empty" />
        <span>Waiting for live device state</span>
      </div>
    }

    @{ var displayCommands = GetDisplayCommands(); }

    @if(displayCommands.Length > 0)
    {
      <section class="remote-device__commands" aria-label="Device commands">
        <div class="remote-device__section-heading">
          <div>
            <span class="remote-device__section-kicker">Device commands</span>
          </div>
          <span class="remote-device__section-count">@displayCommands.Length available</span>
        </div>
        <div class="remote-device__command-picker">
          <RadzenDropDown TValue="string"
                          Data="@displayCommands"
                          TextProperty="@nameof(DeviceCommandDescriptor.Name)"
                          ValueProperty="@nameof(DeviceCommandDescriptor.Name)"
                          Value="@_selectedCommandName"
                          Change="OnCommandChanged"
                          Placeholder="Select a command"
                          AllowClear="true"
                          Class="remote-device__command-select" />
        </div>
        @if(SelectedCommand is not null)
        {
          <div class="remote-device__selected-command">
            <DeviceCommandInvocationView Command="@SelectedCommand"
                                         DeviceAdapter="@ViewModel.DeviceAdapter"
                                         DisplayOnlyWidgetDescriptors="true"
                                         ShowCommandHeader="true"
                                         ShowCloseButton="false"
                                         CanInvoke="@(ViewModel.ConnectionStatus == ConnectionStatus.ConnectedToDevice)" />
          </div>
        }
      </section>
    }
  </ChildContent>
</RadzenFieldset>

@code {
  private string? _selectedCommandName;

  private DeviceCommandDescriptor? SelectedCommand
    => GetDisplayCommands().FirstOrDefault(command => command.Name == _selectedCommandName);

  protected override void OnParametersSet()
  {
    var displayCommands = GetDisplayCommands();
    if(_selectedCommandName is not null && displayCommands.All(command => command.Name != _selectedCommandName))
      _selectedCommandName = null;
  }

  private DeviceCommandDescriptor[] GetDisplayCommands()
  {
    return ViewModel?.DeviceCommands
      .Where(command => command.WidgetDescriptors.Any(widget => command.InputSchema.Fields.ContainsKey(widget.AssociatedInput)))
      .ToArray() ?? [];
  }

  private void OnCommandChanged(object? value)
  {
    _selectedCommandName = value?.ToString();
  }

  private static string GetStatusLabel(ConnectionStatus status)
  {
    return status switch
    {
      ConnectionStatus.Undefined => "Connecting",
      ConnectionStatus.Disconnected => "Offline",
      ConnectionStatus.ConnectedToService => "Service only",
      ConnectionStatus.ConnectedToDevice => "Online",
      _ => "Unknown"
    };
  }

  private static string GetStatusClass(ConnectionStatus status)
  {
    return status switch
    {
      ConnectionStatus.Undefined => "remote-device__status--pending",
      ConnectionStatus.Disconnected => "remote-device__status--offline",
      ConnectionStatus.ConnectedToService => "remote-device__status--partial",
      ConnectionStatus.ConnectedToDevice => "remote-device__status--online",
      _ => "remote-device__status--unknown"
    };
  }

  private static string GetStatusDescription(ConnectionStatus status)
  {
    return status switch
    {
      ConnectionStatus.Undefined => "Connecting to the ARES service and device",
      ConnectionStatus.Disconnected => "The device is currently disconnected",
      ConnectionStatus.ConnectedToService => "Connected to ARES, but the device is unavailable",
      ConnectionStatus.ConnectedToDevice => "Connected to ARES and the device is ready",
      _ => "The device connection status is unknown"
    };
  }
}
