@using UI.Infrastructure.Interfaces
@inherits ReactiveUI.Blazor.ReactiveComponentBase<Tc0304SettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService

<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus"
                         EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate"
                         Name="@ViewModel!.DataloggerConfig.Name">
  <div>
    @if (ViewModel!.DataloggerConfig.Simulated)
    {
      <span>Simulated -- </span>
    }
    <span>@ViewModel!.DataloggerConfig.Name</span>
    <span>@ViewModel!.DataloggerConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Datalogger", ds =>
      @<Tc0304ConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

}
@code {
  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.DataloggerConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}