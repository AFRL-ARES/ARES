@inherits ReactiveUI.Blazor.ReactiveComponentBase<MfcConfigEditViewModel>
@using UI.Backend.ViewModels.Settings.Device.Mfc;
@using Ares.Alicat.Mfc.Config;
@using UI.Components

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <div class="mfc-property-grid">
    <input type="text" placeholder="@(ViewModel!.Port is null ? "Port" : ViewModel!.Port)" list="port-list" @onchange="PortChanged" class="form-select mfc-port" />
    <datalist id="port-list">
      @if (ViewModel!.AvailablePorts is not null)
      {
        @foreach (var port in ViewModel!.AvailablePorts)
        {
        <option value="@port">@port</option>
        }
      }
    </datalist>
    
    <select disabled="@IdsLoading" @bind="ViewModel!.Id" class="form-select mfc-id">
      @if (ViewModel!.Id is not null)
      {
        <option selected>@ViewModel!.Id</option>
      }
      else
      {
        <option selected>Select an Id</option>
      }
      @if (ViewModel!.AvailableIds is not null)
        {
          var ids = ViewModel!.AvailableIds;
          @foreach (var id in ids)
          {
            <option value="@id">@id</option>
          }
        }
    </select>

    <select @bind="ViewModel!.SelectedMfcType" class="form-select mfc-type">
      @foreach(var mfcType in ViewModel!.AvailableMfcTypes.Where(t => t != MfcType.None))
      {
        <option value="@mfcType">@mfcType</option>
      }
    </select>
    @if (IdsLoading)
    {
      <div class="pt-1 mfc-spinner">
        <LoadingSpinner SpinnerSize="SpinnerSize.Small"/>
      </div>
    }
    <input type="text" class="form-control mfc-name" disabled="@(!ViewModel!.NewConfig)" placeholder="Name" @bind="@ViewModel!.Name"/>
    <div class="mfc-simulated d-flex align-items-center">
      <label class="flex-fill" for="simulated-switch">Simulated</label>
      <RadzenSwitch id="simulated-switch" @bind-value="@ViewModel!.Simulated" Change="SimulatedChanged">Simulated</RadzenSwitch>
    </div>
    <div class="mfc-valve d-flex align-items-center">
      <label class="flex-fill" for="valve-switch">Has Valve</label>
      <RadzenSwitch id="valve-switch" @bind-value="@ViewModel!.HasValve">Has Valve</RadzenSwitch>
    </div>
  </div>
  <ValidationSummary/>
  <DataAnnotationsValidator/>
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>
@code {

  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate {
  };

  private bool IdsLoading { get; set; }

  private async Task SimulatedChanged(bool val)
  {
    await ReloadIds();
  }

  private async Task PortChanged(ChangeEventArgs obj)
  {
    if (obj.Value is not string stringValue)
      throw new InvalidOperationException($"{obj.Value} is not a string and cannot be used as a port name.");
    ViewModel!.Port = stringValue;
    await ReloadIds();
  }

  private async Task ReloadIds()
  {
    IdsLoading = true;
    StateHasChanged();
    await ViewModel!.UpdateAvailableIds();
    IdsLoading = false;
    StateHasChanged();
  }
}
