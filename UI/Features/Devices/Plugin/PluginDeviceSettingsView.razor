@using System.Reactive.Linq
@using UI.Features.Devices.Plugin.Factories
@using UI.Features.Devices.Shared.Settings
@inherits ReactiveUI.Blazor.ReactiveComponentBase<PluginDeviceSettingsViewModel>
@inject DialogService DialogService
@inject IPluginViewModelFactory ViewModelFactory

<DeviceSettingsContainer 
  Name="@ViewModel!.Name"
  EditCallback="EditCallback"
  RemoveCallback="RemoveCallback"
  SettingsCallback="SettingsCallback">
  <div style="display: flex; flex-direction: column">
    <span>Name: @ViewModel.Name</span>
    <span>ID: @ViewModel.Id</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Device", ds => @<PluginDeviceConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel!.Modified)
    {
      await ViewModel!.SaveCommand.Execute();
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Name}?");
    if (result is true)
    {
      await ViewModel!.RemoveCommand.Execute();
    }    
  }

  private Task SettingsCallback()
  {
    // TODO
    return Task.CompletedTask;
  }

  private bool IsResolving { get; set; }
}
