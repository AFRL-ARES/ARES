@using UI.Application.Devices
@inherits ReactiveUI.Blazor.ReactiveComponentBase<PluginDeviceUnitViewModel>
@inject TooltipService TooltipService

<RadzenFieldset class="device-fieldset">
  <HeaderTemplate>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
      <RadzenText Text="@ViewModel!.DeviceName" TItem="string" />
        <RadzenIcon @ref="_connectedIcon" Icon="link" class="rz-color-success"
          @onmouseenter="@(args => ShowTooltip(_connectedIcon!.Element, "Connected to Service and Device"))" />
    </RadzenStack>
  </HeaderTemplate>
  <ChildContent>
    @if(ViewModel!.DeviceState is not null)
    {
      @foreach(var field in ViewModel!.DeviceState.Fields)
      {
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
          <RadzenColumn Size="4" class="d-flex justify-content-end">
            <RadzenLabel Text="@field.Key" />
          </RadzenColumn>
          <RadzenColumn Size="8">
            <AresValueDisplay Value="@field.Value" />
          </RadzenColumn>
        </RadzenRow>
      }
    }
  </ChildContent>
</RadzenFieldset>

@code {
  private RadzenIcon? _connectedIcon;
  private RadzenIcon? _serviceConnectedIcon;
  private RadzenIcon? _disconnectedIcon;

  void ShowTooltip(ElementReference elementReference, string text)
  {
    TooltipService.Open(elementReference, text, new TooltipOptions { Position = TooltipPosition.Top });
  }
}
