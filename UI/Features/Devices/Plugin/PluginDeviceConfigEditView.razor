@using Ares.Core.Resources
@using Ares.Datamodel
@inherits ReactiveUI.Blazor.ReactiveComponentBase<PluginDeviceConfigEditViewModel>

<RadzenTemplateForm TItem="PluginDeviceConfigEditViewModel" Data="@ViewModel" Submit="@OnValidSubmit">
  <div class="d-flex flex-column gap-3">
  <RadzenFormField Text="Device Name" Variant="Variant.Flat">
          <RadzenTextBox @bind-Value="ViewModel!.Name" Disabled="@(!ViewModel!.NewConfig)"/>
      </RadzenFormField>

    @if(ViewModel!.ConnectionType == ConnectionType.Serial)
    {
      <input type="text" placeholder="@(ViewModel!.SelectedSerialPort is null ? "Port" : ViewModel!.SelectedSerialPort)" list="port-list" @onchange="PortChanged" class="form-select mfc-port" disabled="@(!ViewModel!.NewConfig)" />
      <datalist id="port-list">
        @if(ViewModel!.AvailableSerialPorts is not null)
        {
          @foreach(var port in ViewModel!.AvailableSerialPorts)
          {
            <option value="@port">@port</option>
          }
        }
      </datalist>

      if(ViewModel!.BaudRateOptions.Any())
      {
        <RadzenLabel Text="Baud Rate" Component="BaudRateDropdown" Style="margin-right: 8px;" />
    
        <RadzenDropDown TValue="int" 
          Data="@ViewModel!.BaudRateOptions" 
          @bind-Value="ViewModel!.SelectedBaudRate"
          Style="width: 100%; max-width: 200px;" 
          Name="BaudRateDropdown" />
      }

      if(ViewModel!.RequiresId)
      {
        <div class="rz-p-sm-4">
            <RadzenLabel Text="Unit ID" Component="UnitIdInput" Style="display: block; margin-bottom: 4px;" />
    
            <RadzenTextBox @bind-Value="ViewModel!.SerialUnitId" 
                           Name="UnitIdInput" 
                           Style="width: 100%; max-width: 200px;" />

            <RadzenRegexValidator Component="UnitIdInput" 
                                  Text="@ViewModel!.UnitIdHint" 
                                  Pattern="@ViewModel!.IdRegex" 
                                  Style="display: block; margin-top: 4px; font-size: 0.8em;" />
        </div>
      }
    }

    @foreach (var prop in ViewModel!.DriverSettingsSchema.Fields)
    {
      <AresValueDesigner Name="@prop.Key"
      Value="@ViewModel!.GetMatchingSettingValue(prop.Key)"
      Schema="prop.Value"
      ValueEditCallback="@(value => ValueEditCallback(prop.Key, value))"/>
    }

    <div style="display: flex; align-items: center; gap: 8px;" class="rz-p-sm-4">
      <RadzenSwitch @bind-Value="ViewModel!.IsSimulated" Name="SimulatedDeviceSwitch" />
      <RadzenLabel Text="Run as Simulated Device" Component="SimulatedDeviceSwitch" />
    </div>
  </div>
  <button type="submit" class="btn my-3 btn-outline-primary">Save Device</button>
</RadzenTemplateForm>

@code
{
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate { };

  private Task ValueEditCallback(string name, AresValue value)
  {
    ViewModel!.DeviceSettings.Fields[name] = value;
    return Task.CompletedTask;
  }

  private async Task PortChanged(ChangeEventArgs obj)
  {
    if(obj.Value is not string stringValue)
      throw new InvalidOperationException($"{obj.Value} is not a string and cannot be used as a port name.");
    ViewModel!.SelectedSerialPort = stringValue;
  }
}