@inherits ReactiveUI.Blazor.ReactiveComponentBase<RestDeviceUnitControlViewModel>
@inject TooltipService tooltipService

<RadzenCard Style="align-items: center; gap: 0.5rem; row-gap: 1rem; width: fit-content">
	<RadzenRow>
		<RadzenStack Orientation="Orientation.Vertical">
			<RadzenRow>
				<RadzenText TextStyle="TextStyle.DisplayH6"> @ViewModel!.DeviceName </RadzenText>
			</RadzenRow>

			@foreach(var item in ViewModel!.DeviceMethods.Keys)
			{
				<RadzenRow>
					<RadzenButton Text="@item" Click="@(args => ViewModel!.HandleDeviceCommand(item))" Style="min-width: 8rem; min-height: 2rem;"/>

					@foreach(var param in ViewModel!.DeviceMethods.GetValueOrDefault(item) ?? new List<string>())
					{
						<RadzenFormField Text="@param" Style="width: auto">
							<RadzenTextBox Change="@(args => ParameterUpdated(param, args))"/>
						</RadzenFormField>
					}
				</RadzenRow>
			}
		</RadzenStack>
	</RadzenRow>
</RadzenCard>

@code {
	private void ParameterUpdated(string param, string value)
	{
		if(param is null)
			return;

		if(ViewModel!.MethodParameters.ContainsKey(param))
			ViewModel!.MethodParameters[param] = value;
	}

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		await ViewModel!.UpdateDeviceCapabilities();
	}
}
