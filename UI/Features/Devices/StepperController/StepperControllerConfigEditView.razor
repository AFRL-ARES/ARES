@using TicStepperController.Messaging;
@using UI.Backend.ViewModels.Settings.Device.StepperController

@inherits ReactiveUI.Blazor.ReactiveComponentBase<StepperControllerConfigEditViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
    <RadzenFormField Text="Device Name" Variant="Variant.Flat">
      <RadzenTextBox Placeholder="Name" @bind-Value="ViewModel!.Name"/>
    </RadzenFormField>

    <RadzenFormField Text="Port" Variant="Variant.Flat">
      <RadzenAutoComplete @bind-Value=ViewModel!.Port Data=ViewModel!.AvailablePorts OpenOnFocus=true/>
    </RadzenFormField>

    <RadzenFormField Text="Max Acceleration" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.MaxAcceleration" ShowUpDown=false/>
    </RadzenFormField>

    <RadzenFormField Text="Max Deceleration" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.MaxDeceleration" ShowUpDown=false />
    </RadzenFormField>

    <RadzenFormField Text="Starting Speed" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.StartingSpeed" ShowUpDown=false />
    </RadzenFormField>

    <RadzenFormField Text="Max Speed" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.MaxSpeed" ShowUpDown=false />
    </RadzenFormField>

    <RadzenFormField Text="Current Limit" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.CurrentLimit" ShowUpDown=false />
    </RadzenFormField>

    <RadzenFormField Text="Custom Step Size" Variant="Variant.Flat">
      <RadzenNumeric @bind-Value="ViewModel!.CustomStepSize" ShowUpDown=false/>
    </RadzenFormField>

    <RadzenFormField Text="Step Mode" Variant="Variant.Flat">
      <RadzenDropDown @bind-Value="ViewModel!.StepMode" Data="@(Enum.GetValues(typeof(StepMode)).Cast<Enum>())"/>
    </RadzenFormField>

    @if(ViewModel!.DynamicStepCalculation)
    {
      <RadzenFormField Text="Step Angle" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.StepAngle TValue="double?" ShowUpDown=false/>
      </RadzenFormField>

      <RadzenFormField Text="Ideal Linear Step Size" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.LinearStepSize TValue="double?" ShowUpDown=false/>
      </RadzenFormField>

      <RadzenFormField Text="Filter Paper Thickness" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.FilterPaperThickness TValue="double?" ShowUpDown=false/>
      </RadzenFormField>

      <RadzenFormField Text="Initial Spool Radius" Variant="Variant.Flat">
        <RadzenNumeric @bind-Value=ViewModel!.InitialSpoolRadius TValue="double?" ShowUpDown=false/>
      </RadzenFormField>
    }

    <RadzenRow Gap="1rem" Style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
      <RadzenLabel Text="Simulated" Component="simulated-switch" />
      <RadzenSwitch id="simulated-switch" @bind-Value="@ViewModel!.Simulated"/>
    </RadzenRow>

    <RadzenRow Gap="1rem" Style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
      <RadzenLabel Text="Dynamic Step Calculation" Component="dynamic-switch" />
      <RadzenSwitch id="dynamic-switch" @bind-Value="@ViewModel!.DynamicStepCalculation"/>
    </RadzenRow>


  </RadzenStack>

  <ValidationSummary />
  <DataAnnotationsValidator />
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>



@code {
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate
  {
  };
}
