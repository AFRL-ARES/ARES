@using UI.Infrastructure.Interfaces
@inherits ReactiveUI.Blazor.ReactiveComponentBase<SyringePumpSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService

<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus"
                         EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="@ViewModel.Activate"
                         Name="@ViewModel!.SyringePumpConfig.Name">
  <div>
    @if (ViewModel!.SyringePumpConfig.Simulated)
    {
      <span>Simulated -- </span>
    }
    <span>@ViewModel!.SyringePumpConfig.Name</span>
    <span>@ViewModel!.SyringePumpConfig.PortName</span>
    <span>@($" Address: {ViewModel!.SyringePumpConfig.Address}")</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Syringe Pump", ds =>
      @<SyringePumpConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)" />);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.SyringePumpConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}