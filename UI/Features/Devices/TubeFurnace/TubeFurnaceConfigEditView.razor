
@inherits ReactiveUI.Blazor.ReactiveComponentBase<TubeFurnaceConfigEditViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <div class="furnace-config-grid">
    <input type="text" class="form-control furnace-name" disabled="@(!ViewModel!.NewConfig)" placeholder="Name" @bind="@ViewModel!.Name" />
    <input type="text" placeholder="@(ViewModel!.Port is null ? "Port" : ViewModel!.Port)" list="port-list" @bind="ViewModel!.Port" class="form-select furnace-port" />
    <datalist id="port-list">
      @if (ViewModel!.AvailablePorts is not null)
      {
        @foreach (var port in ViewModel!.AvailablePorts)
        {
          <option value="@port">@port</option>
        }
      }
    </datalist>
    <div class="furnace-simulated d-flex">
      <label class="flex-fill" for="simulated-switch">Simulated</label>
      <RadzenSwitch id="simulated-switch" @bind-Value="@ViewModel!.Simulated">Simulated</RadzenSwitch>
    </div>
    <input class="furnace-address form-control" type="number" placeholder="@(ViewModel!.Address is null ? "Address" : ViewModel!.Address)" @bind="ViewModel!.Address" />
  </div>
  <ValidationSummary />
  <DataAnnotationsValidator />
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>

@code {
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate
  {
  };
}
