@inherits ReactiveUI.Blazor.ReactiveComponentBase<CM3CameraUnitControlViewModel>
@inject TooltipService tooltipService
@inject IJSRuntime JS


<RadzenCard Style="align-items: center; gap: 0.5rem; row-gap: 1rem; width: fit-content">
  <RadzenRow JustifyContent="JustifyContent.Left">
    <RadzenStack Orientation="Orientation.Vertical">
      <RadzenRow>
        <RadzenText TextStyle="TextStyle.DisplayH6"> @ViewModel!.DeviceName </RadzenText>
      </RadzenRow>

      <RadzenRow>
        @if(ViewModel!.DisplayData is not null)
        {
          <RadzenImage Path="@($"data:image/png;base64,{Convert.ToBase64String(ViewModel!.DisplayData)}")" AlternateText="Example Camera Image" Style="width: 400px" />
        }

        else
        {
          <RadzenText Text="Try taking a picture!"/>
        }
      </RadzenRow>
        
      <RadzenRow>
        <RadzenButton Click="@(args => ViewModel!.CaptureImage())" Icon="camera" MouseEnter="@(args => ShowCaptureImageTip(args) )" Size="ButtonSize.Large" />
        <RadzenButton Click="@(args => ExportImage(args))" Icon="download" Size="ButtonSize.Large" MouseEnter="@(args => ShowDownloadPhotoCommandTip(args))" />
        <RadzenButton Click=@(args => ViewModel!.SetExposureTime()) Icon="exposure" MouseEnter="@(args => ShowSetExposureTip(args) )" Size="ButtonSize.Large" />
        <RadzenFormField Text="Exposure Time (Milliseconds)" Style="width: auto;">
          <RadzenNumeric ShowUpDown="false" TValue="double" @bind-Value="ViewModel!.ExposureTime" Min="10" Max="30291" Name="ExposureUpDown" />
        </RadzenFormField>
      </RadzenRow>
    </RadzenStack>
  </RadzenRow>
</RadzenCard>

@code {
  void ShowCaptureImageTip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Capture Image", options);
  void ShowSetExposureTip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Set Exposure Time", options);
  void ShowDownloadPhotoCommandTip(ElementReference elementReference, TooltipOptions? options = null) => tooltipService.Open(elementReference, "Download Image", options);

  private async void ExportImage(MouseEventArgs args)
  {
    if(ViewModel!.ImageData is null)
      return;

    var fileName = "AresImage.tif";
    await JS.InvokeVoidAsync("downloadByteArray", fileName, ViewModel!.ImageData);
  }
}
