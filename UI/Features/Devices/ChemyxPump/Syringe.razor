@using System.Globalization

@* Syringe.razor
   Parameters:
     - Progress: double (0.0 .. 1.0) controls fill amount
     - InnerText: string shown inside the syringe body
     - Width, Height: CSS sizes (optional) - default 120x360
     - FillColor, BorderColor, BackgroundColor: optional CSS color strings
*@

@code {
  [Parameter]
  public double Progress { get; set; } = 0.0; // 0..1

  [Parameter]
  public string InnerText { get; set; } = string.Empty;

  [Parameter]
  public string Width { get; set; } = "80px";

  [Parameter]
  public string Height { get; set; } = "320px";

  [Parameter]
  public string FillColor { get; set; } = "#4aa3ff";

  [Parameter]
  public string BorderColor { get; set; } = "#333";

  [Parameter]
  public string BackgroundColor { get; set; } = "#f6f6f6";

  [Parameter]
  public double Rotation { get; set; } = 0.0; // degrees set;

  // internal computed values for the svg body
  private double _clampedProgress;

  protected override void OnParametersSet()
  {
    _clampedProgress = Math.Max(0.0, Math.Min(1.0, Progress));
  }

  // Helpers to output numbers in invariant culture for SVG attributes
  private string F(double v) => v.ToString(CultureInfo.InvariantCulture);
}

<style>
  .syringe-root {
    display: inline-block;
    vertical-align: middle;
  }

  .syringe-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .syringe-text {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    font-weight: 600;
    user-select: none;
    pointer-events: none;
  }
</style>

<div class="syringe-root" style="width:@Width; height:@Height; transform: rotate(@(Rotation)deg); --fill:@FillColor; --border:@BorderColor; --bg:@BackgroundColor">
  @* A vertically oriented syringe drawn in SVG. The visible fill is implemented with a clipPath whose height is controlled by Progress. *@
  <svg class="syringe-svg" viewBox="0 0 60 240" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Syringe progress">
    @* Outer elements: needle & plunger *@
    <g transform="translate(0,0)">
      <!-- needle -->
      <rect x="28" y="0" width="4" height="20" fill="var(--border)"></rect>

      <!-- plunger head (top) -->
      <rect x="14" y="18" width="32" height="8" rx="2" fill="var(--border)"></rect>

      <!-- body outline -->
      <rect x="12" y="30" width="36" height="170" rx="8" fill="none" stroke="var(--border)" stroke-width="2"></rect>

      <!-- inner background (syringe empty background) -->
      <rect x="14" y="32" width="32" height="166" rx="6" fill="var(--bg)"></rect>

      @* Clip path area that will reveal the fill from bottom to top. We'll compute the rect 'y' so that it covers only the portion that should be filled. *@
      <defs>
        <clipPath id="bodyClip">
          @* The filled area rect's y will be computed via a small inline calc in the SVG using Progress parameter from code below. *@
          @{
            // body inner box dimensions in SVG coordinates
            const double innerX = 14.0;
            const double innerY = 32.0;
            const double innerW = 32.0;
            const double innerH = 166.0;

            // how many SVG units should be filled (from bottom)
            var fillUnits = innerH * _clampedProgress;
            // y coordinate of the top of the filled rect
            var fillY = innerY + (innerH - fillUnits);
          }
          <rect x="14" y="@F(fillY)" width="32" height="@F(fillUnits)" rx="6"></rect>
        </clipPath>
      </defs>

      <!-- the actual fill (uses the clipPath to only show the correct amount) -->
      <g clip-path="url(#bodyClip)">
        <rect x="14" y="32" width="32" height="166" rx="6" fill="var(--fill)"></rect>
      </g>

      <!-- small graduated marks on the side (optional) -->
      <g stroke="var(--border)" stroke-width="0.6">
        @for(int i = 0; i <= 10; i++)
        {
          var y = 32 + i * (166.0 / 10.0);
          <line x1="47.5" y1="@F(y)" x2="53" y2="@F(y)" />
        }
      </g>

      <!-- text inside syringe (centered) -->
      <text x="30" y="120" text-anchor="middle" alignment-baseline="middle" class="syringe-text" font-size="20" fill="#ffffff">
        @if(!string.IsNullOrEmpty(InnerText))
        {
          @InnerText
        }
      </text>

      <!-- plunger rod extending into body (visual) -->
      <rect x="28" y="200" width="4" height="22" fill="var(--border)"></rect>
      <rect x="20" y="214" width="20" height="12" rx="3" fill="var(--border)"></rect>
    </g>
  </svg>
</div>

@* Usage example (place in a page or another component):
   <Syringe Progress="0.45" InnerText="45%" Width="100px" Height="360px" FillColor="#00c853" />
*@
