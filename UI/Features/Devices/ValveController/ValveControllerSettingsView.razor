@using UI.Application.Notifications
@inherits ReactiveUI.Blazor.ReactiveComponentBase<ValveControllerSettingsViewModel>
@inject DialogService DialogService
@inject IUiNotificationService NotificationService


<DeviceSettingsContainer DeviceOperationalStatusGetter="ViewModel!.GetDeviceOperationalStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.ValveControllerConfig.Name">
  <div>
    @if (ViewModel!.ValveControllerConfig.Simulated)
    {
      <span> Simulated Valve Controller -- </span>
    }

    <span>@ViewModel!.ValveControllerConfig.Name</span>
    <span>@ViewModel!.ValveControllerConfig.PortName</span>
  </div>
</DeviceSettingsContainer>

@code {
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Valve Controller", ds =>
      @<ValveControllerConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      NotificationService.Success("Config has been saved");
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.ValveControllerConfig.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}


