@using Ares.Datamodel
@using Ares.Datamodel.Device
@using Ares.Datamodel.Extensions

<RadzenStack Gap="1rem" Style="padding: 20px;">

  <!-- Header -->
  <RadzenCard Variant="Variant.Outlined">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
      <RadzenIcon Icon="router" Style="font-size: 3rem; color: var(--rz-primary);" />
      <RadzenStack Gap="0">
        <RadzenText TextStyle="TextStyle.H4" Style="margin: 0; padding-bottom: 0.5rem;">@DeviceName</RadzenText>
        @if(OperationalState == OperationalState.Active)
        {
          <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary);">
            Status: <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Online" />
          </RadzenText>
        }

        else
        {
          <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary);">
            Status: <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Offline" />
          </RadzenText>
        }

      </RadzenStack>
    </RadzenStack>
  </RadzenCard>

  <RadzenText TextStyle="TextStyle.H5">Exposed Commands</RadzenText>

  <!-- Main Command Grid -->
  <RadzenDataGrid Data="@DeviceCommands" TItem="DeviceCommandDescriptor" AllowSorting="true" AllowFiltering="true" ExpandMode="DataGridExpandMode.Single">
    <Columns>
      <RadzenDataGridColumn TItem="DeviceCommandDescriptor" Property="Name" Title="Command" Width="150px">
        <Template Context="cmd">
          <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <strong>@cmd.Name</strong>
          </RadzenStack>
        </Template>
      </RadzenDataGridColumn>

      <RadzenDataGridColumn TItem="DeviceCommandDescriptor" Property="Description" Title="Description" />

      <RadzenDataGridColumn TItem="DeviceCommandDescriptor" Title="Return Type" Width="150px">
        <Template Context="cmd">
          <RadzenBadge BadgeStyle="BadgeStyle.Info" IsPill="true" Text="@GetReturnTypeDisplay(cmd.OutputSchema)" />
        </Template>
      </RadzenDataGridColumn>
    </Columns>

    <!-- Expansion: Input Schema (Parameters) -->
    <Template Context="cmd">
      <RadzenCard Variant="Variant.Flat" Style="margin-left: 20px;">
        <RadzenText TextStyle="TextStyle.Subtitle2">Input Parameters</RadzenText>

        @if(cmd.InputSchema == null || cmd.InputSchema.Fields == null || !cmd.InputSchema.Fields.Any())
        {
          <RadzenText TextStyle="TextStyle.Caption" Style="font-style: italic;">No parameters required.</RadzenText>
        }
        else
        {
          <!-- Iterate over the Map<string, AresValueSchema> -->
          <RadzenDataGrid Data="@cmd.InputSchema.Fields" TItem="KeyValuePair<string, AresValueSchema>" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal">
            <Columns>
              <RadzenDataGridColumn TItem="KeyValuePair<string, AresValueSchema>" Title="Name" Width="200px">
                <Template Context="kvp">
                  <span style="font-weight: 500;">@kvp.Key</span>
                </Template>
              </RadzenDataGridColumn>

              <RadzenDataGridColumn TItem="KeyValuePair<string, AresValueSchema>" Title="Type" Width="200px">
                <Template Context="kvp">
                  <code style="color: var(--rz-secondary);">@FormatDataType(kvp.Value)</code>
                </Template>
              </RadzenDataGridColumn>

              <RadzenDataGridColumn TItem="KeyValuePair<string, AresValueSchema>" Title="Required" Width="100px">
                <Template Context="kvp">
                  @if(!kvp.Value.Optional)
                  {
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Req" />
                  }
                  else
                  {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Opt" />
                  }
                </Template>
              </RadzenDataGridColumn>

              <RadzenDataGridColumn TItem="KeyValuePair<string, AresValueSchema>" Title="Description">
                <Template Context="kvp">
                  @kvp.Value.Description
                </Template>
              </RadzenDataGridColumn>
            </Columns>
          </RadzenDataGrid>
        }
      </RadzenCard>
    </Template>
  </RadzenDataGrid>
</RadzenStack>

@code {
  [Parameter] 
  public string DeviceName { get; set; } = "";

  [Parameter]
  public DeviceCommandDescriptor[] DeviceCommands { get; set; } = [];

  [Parameter]
  public OperationalState OperationalState { get; set; } = new();


  private void OpenInvokeDialog(DeviceCommandDescriptor cmd)
  {
    Console.WriteLine($"Opening dialog for {cmd.Name}");
  }

  // --- Format Helpers ---

  private string GetReturnTypeDisplay(AresValueSchema outputSchema)
  {
    if(outputSchema == null)
      return "Void";

    return outputSchema.Type.ToString();
  }
    

  private string FormatDataType(AresValueSchema entry) => entry.Stringify();
}