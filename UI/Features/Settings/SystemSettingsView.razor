@page "/settings/system"
@using Ares.Datamodel
@using Radzen
@using Radzen.Blazor
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<SystemSettingsViewModel>
@layout SettingsLayout
@inject TooltipService tooltipService

<div class="card flex-fill d-flex flex-column">

  <RadzenStack Gap="1.5rem" Class="rz-p-6">
    <RadzenTabs RenderMode="TabRenderMode.Client">
      <Tabs>
        <RadzenTabsItem Text="Experiment Settings" Icon="biotech">
          <RadzenCard Variant="Variant.Flat">
            <RadzenStack Gap="1rem" Orientation="Orientation.Horizontal">
              <RadzenFormField Text="Experiment Retry Limit">
                <RadzenNumeric @bind-Value="ViewModel!.ExperimentRetryLimit" />
              </RadzenFormField>
              <RadzenIcon Icon="help_outline" MouseEnter="@(args => ShowRetryLimitTooltip(args))" Style="padding-top: 1.5rem"/>
            </RadzenStack>
          </RadzenCard>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Error Handling" Icon="error_outline">
          <RadzenCard Variant="Variant.Flat">
            <RadzenStack Gap="1rem">
              <RadzenFieldset Text="Configure Error Handling">
                <RadzenStack Gap="1rem">
                  @foreach(var error in GetFilteredValues())
                  {
                    <RadzenFormField Text="@(error.ToString())" Variant="Variant.Outlined" Style="width: 100%;">
                      <RadzenDropDown @bind-Value="ViewModel!.CurrentErrorHandlingSettings[error]"
                                      Data="@(Enum.GetValues<ErrorHandling>().Where(v => v != ErrorHandling.UnknownHandling))"
                                      Style="width: 100%;" />
                    </RadzenFormField>
                  }
                </RadzenStack>
              </RadzenFieldset>
            </RadzenStack>
          </RadzenCard>
        </RadzenTabsItem>

      </Tabs>
    </RadzenTabs>

  </RadzenStack>

  <RadzenButton Click=@ViewModel!.PushUpdatedSettings Text="Save All Changes" Icon="save" ButtonStyle="ButtonStyle.Primary" Style="max-width: 175px; margin-left: 10px; margin-top: 10px"/>
</div>



@code {
  protected override async Task OnInitializedAsync()
  {
    if(ViewModel is not null)
      await ViewModel!.GetUpdatedSettings();
  }

  private IEnumerable<CommandStatusCode> GetFilteredValues()
  {
    var values = Enum.GetValues<CommandStatusCode>()
    .Where(c => c != CommandStatusCode.StatusUnspecified && c != CommandStatusCode.CommandSuccess && c != CommandStatusCode.SuccessWithWarnings);

    return values;
  }

  void ShowRetryLimitTooltip(ElementReference elementReference, TooltipOptions options = null) => tooltipService.Open(elementReference, "Sets the max times ARES will retry a failing command or experiment", options);
}