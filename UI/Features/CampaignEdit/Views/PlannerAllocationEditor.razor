@using Ares.Datamodel.Planning;
@using UI.Features.Planning.Settings
@inject DialogService DialogService
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Features.CampaignEdit.ViewModels.PlannerAllocationEditorViewModel>

<div class="card border-primary rounded-1 p-2 m-1">
  <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0.5rem">
    <RadzenColumn>
      <RadzenRow Style="padding-bottom: 0.5rem">
        @ViewModel!.ParameterMetadata.Name
      </RadzenRow>
      <RadzenRow AlignItems="AlignItems.Center">
        <RadzenLabel Text="Select Service:" Component="PlannerServiceDropDown" Style="min-width: 115px"/>
        <RadzenDropDown TValue="PlannerServiceInfo" 
          Data="@ViewModel!.PlannerServices" 
          @bind-Value="@ViewModel!.SelectedService"
          Change="@OnSelectionChanged"
          Name="PlannerServiceDropDown" 
          Style="min-width: 15rem">
            
          <Template>
            @context.Name (@context.Version)
          </Template>
          </RadzenDropDown>

        @if(ViewModel!.SelectedService is not null)
        {
          <button class="btn btn-sm btn-outline-primary rounded-2 analyzer-action-button" type="button" disabled="@(ViewModel!.SelectedService is null)" @onclick="SettingsClicked"><RadzenIcon Icon="settings" /></button>
        }
      </RadzenRow>

      <RadzenRow AlignItems="AlignItems.Center">
        @if(ViewModel!.PlannerOptions.Count() > 1)
        {
          <RadzenLabel Text="Select Planner:" Component="PlannerOptionDropDown" Style="min-width: 115px" />
          <RadzenDropDown TValue="Planner" 
            Data="@ViewModel!.PlannerOptions" 
            @bind-Value="@ViewModel!.SelectedPlannerOption" 
            Change="@OnSelectionChanged"
            Name="PlannerOptionDropDown" 
            Style="min-width: 15rem">
            <Template>
              @context.PlannerName
            </Template>

            <ValueTemplate>
              @context.PlannerName
            </ValueTemplate>
          </RadzenDropDown>
          <RadzenButton Click="@ShowPlannerOptionTip" Icon="help" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Shade="Shade.Lighter" Size="ButtonSize.ExtraSmall" />
        }
      </RadzenRow>

      <RadzenRow style="padding-top: 0.5rem">
        Planner Description:
        @(ViewModel!.SelectedPlannerOption?.Description ?? ViewModel!.SelectedService?.Description ?? string.Empty)
      </RadzenRow>
    </RadzenColumn>
  </RadzenStack>
</div>

@code {

  [Parameter]
  public EventCallback OnPlannerChanged { get; set; }

  private async Task OnSelectionChanged()
  {
    if(OnPlannerChanged.HasDelegate)
    {
      await OnPlannerChanged.InvokeAsync();
    }
  }

  private async Task ShowPlannerOptionTip()
  {
    await DialogService.OpenAsync("Planner Selection", ds =>
      @<div>
        In ARES, some planner services report the capability of using multiple types of planners. 
        In this scenario, a seperate dropdown allows you to choose what planning method to use from the services advertised options.
      </div>
    , new DialogOptions() { CloseDialogOnOverlayClick = true });
  }

  private async Task SettingsClicked()
  {
    if(ViewModel!.SelectedService is not null)
    {
      var result = await DialogService.OpenAsync("Planner Settings", ds =>
        @<PlannerSettingsEditorView ViewModel="ViewModel!.SettingsViewModel" OnValidSubmit="() => ds.Close(true)"/>);

      if(result is true && ViewModel!.SettingsViewModel.Modified)
      {
        await ViewModel!.SaveSettingsChanges();
        StateHasChanged();
        var notification = new UiNotificationMessage();
        notification.Detail = $"ARES successfully saved the request changes to {ViewModel!.SelectedPlannerOption.PlannerName}'s settings.";
        notification.Summary = "Successfully Updated Planner Settings";
        notification.Severity = UiNotificationSeverity.Success;

        ViewModel!.PushNotification(notification);
      }
    }
  }
}
