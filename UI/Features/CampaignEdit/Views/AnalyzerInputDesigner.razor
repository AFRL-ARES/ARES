@using UI.Backend.ViewModels.Automation.CampaignEdit

@inherits ReactiveUI.Blazor.ReactiveComponentBase<AnalyzerDesignerViewModel>

@if(DesignerLoading)
{
  <div>Loading...</div>
}
else
{
  <div class="d-flex flex-column h-100">
    <div class="d-flex flex-column">
      <select class="form-select" @bind="ViewModel!.AnalyzerId">
        @if(ViewModel!.AvailableAnalyzers is not null)
        {
          <option value="" selected="@(ViewModel!.Analyzer is null)" disabled>Select analyzer</option>
          @foreach(var analyzer in ViewModel!.AvailableAnalyzers)
          {
            <option value="@analyzer.UniqueId" selected="@(ViewModel!.Analyzer?.Equals(analyzer) ?? false)">@analyzer.Name</option>
          }
        }
      </select>
    </div>
    <RadzenDataGrid TItem="ExperimentOutputAnalyzerInputMapping" Data="@ViewModel!.OutputInputMappings" Editable="true" EditMode="DataGridEditMode.Single" ColumnWidth="200px">
      <Columns>
        <RadzenDataGridColumn Property="@(nameof(ExperimentOutputAnalyzerInputMapping.AnalyzerInputKey))" Title="Analyzer input" />
        <RadzenDataGridColumn Property="@(nameof(ExperimentOutputAnalyzerInputMapping.InputType))" Title="Input Type" />
        <RadzenDataGridColumn Property="@(nameof(ExperimentOutputAnalyzerInputMapping.Required))" Title="Required" />
        <RadzenDataGridColumn Property="@(nameof(ExperimentOutputAnalyzerInputMapping.ExperimentOutput))" Title="Experiment Output">
          <Template Context="item">
            <RadzenDropDown @bind-Value="item.ExperimentOutput" Data="item.MatchingOutputs" />
          </Template>
        </RadzenDataGridColumn>
      </Columns>
    </RadzenDataGrid>
  </div>
}

@code {
  protected bool DesignerLoading { get; set; } = false;

  protected override async Task OnInitializedAsync()
  {
    DesignerLoading = true;
    await ViewModel!.UpdateAvailableAnalyzers();
    await ViewModel!.UpdateMappings();
    DesignerLoading = false;
    StateHasChanged();
  }
}
