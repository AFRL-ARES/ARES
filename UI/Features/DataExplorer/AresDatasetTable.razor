@using Ares.Datamodel
@using Ares.Datamodel.Extensions

@if (Dataset is null)
{
    <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-secondary">No dataset selected.</RadzenText>
}
else if (Dataset.Columns.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body2" Class="rz-color-secondary">Dataset has no columns.</RadzenText>
}
else
{
    <div class="dataset-table">
        <div class="dataset-table-toolbar">
            <span>@Dataset.Rows.Count row@(Dataset.Rows.Count == 1 ? string.Empty : "s")</span>
            <label>
                <span>Page size</span>
                <RadzenDropDown Data="@_pageSizeOptions"
                                TValue="int"
                                @bind-Value="_selectedPageSize"
                                Style="width: 6rem;" />
            </label>
        </div>

        <div class="dataset-grid-scroll">
            <RadzenDataGrid TItem="AresDataRow"
                            @key="Dataset"
                            Data="@Rows"
                            AllowPaging="true"
                            AllowColumnResize="true"
                            PageSize="@_selectedPageSize"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal">
                <Columns>
                    @if (_showRowIds)
                    {
                        <RadzenDataGridColumn TItem="AresDataRow" Title="Row ID" Width="180px" Sortable="false" Filterable="false">
                            <Template Context="row">
                                @row.UniqueId
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    @foreach (var column in Dataset.Columns)
                    {
                        <RadzenDataGridColumn TItem="AresDataRow" Title="@GetColumnTitle(column)" Width="12rem" Sortable="false" Filterable="false">
                            <Template Context="row">
                                @GetCellDisplayValue(row, column)
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
}

@code {
    private static readonly int[] _pageSizeOptions = [10, 20, 50, 100, 250];

    private int _configuredPageSize;
    private int _selectedPageSize = 20;
    private bool _configuredShowRowIds;
    private bool _showRowIds;
    private AresDataset? _configuredDataset;

    [Parameter]
    public AresDataset? Dataset { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public bool ShowRowIds { get; set; } = true;

    private IEnumerable<AresDataRow> Rows => Dataset?.Rows ?? Enumerable.Empty<AresDataRow>();

    protected override void OnParametersSet()
    {
        if (_configuredPageSize != PageSize)
        {
            _configuredPageSize = PageSize;
            _selectedPageSize = _pageSizeOptions.Contains(PageSize) ? PageSize : _pageSizeOptions[1];
        }

        if (ReferenceEquals(_configuredDataset, Dataset) && _configuredShowRowIds == ShowRowIds)
        {
            return;
        }

        _configuredDataset = Dataset;
        _configuredShowRowIds = ShowRowIds;
        _showRowIds = ShowRowIds && Dataset?.Rows.Any(row => row.HasUniqueId) == true;
    }

    private static string GetColumnTitle(AresDataColumn column)
    {
        return column.HasDisplayName && !string.IsNullOrWhiteSpace(column.DisplayName)
            ? column.DisplayName
            : column.Name;
    }

    private static string GetCellDisplayValue(AresDataRow row, AresDataColumn column)
    {
        if (row.Data?.Fields.TryGetValue(column.Name, out var value) != true)
        {
            return string.Empty;
        }

        return value.Stringify();
    }
}
