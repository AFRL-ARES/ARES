@using System.Linq
@using System.Globalization
@using Ares.Core
@using Ares.Core.DataManagement.DataMappers
@using Ares.Core.Device.Repos
@using Ares.Core.Grpc.Services
@using Ares.Datamodel
@using Ares.Datamodel.Device
@using Ares.Services
@using Google.Protobuf.WellKnownTypes
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using UI.Components.Formatting
@implements IDisposable
@inject IDbContextFactory<CoreDatabaseContext> DbContextFactory
@inject IAresDeviceRepo DeviceRepo
@inject AutomationService AutomationClient
@inject DeviceStateDatasetGenerator DatasetGenerator
@inject IJSRuntime JS

<section class="device-state-explorer">
  <div class="explorer-header">
    <div>
      <h3>Device State Explorer</h3>
      <p>Select devices with logged state data to inspect their captured values.</p>
    </div>

    <div class="state-summary" aria-label="Device state summary">
      <div>
        <span class="summary-value">@DeviceCount</span>
        <span class="summary-label">Devices</span>
      </div>
      <div>
        <span class="summary-value">@_selectedDeviceIds.Count</span>
        <span class="summary-label">Selected</span>
      </div>
    </div>
  </div>

  <div class="device-state-grid">
    <aside class="device-panel" aria-label="Devices with state data">
      <div class="panel-toolbar">
        <div>
          <h4>Devices</h4>
          <span>@FilteredDeviceCount shown</span>
        </div>

        <button type="button" class="clear-button" @onclick="ClearSelection" disabled="@(!_selectedDeviceIds.Any() || _loadingDatasets)">
          Clear
        </button>
      </div>

      <label class="search-field">
        <RadzenIcon Icon="search" />
        <input type="search" placeholder="Filter devices" disabled="@_loadingDatasets" @bind="_filterText" @bind:event="oninput" />
      </label>

      @if (_devices == null)
      {
        <div class="empty-state compact">
          <RadzenIcon Icon="hourglass_empty" />
          <span>Loading devices...</span>
        </div>
      }
      else if (!_devices.Any())
      {
        <div class="empty-state compact">
          <RadzenIcon Icon="devices" />
          <span>No device state data found.</span>
        </div>
      }
      else if (!FilteredDevices.Any())
      {
        <div class="empty-state compact">
          <RadzenIcon Icon="search_off" />
          <span>No devices match this filter.</span>
        </div>
      }
      else
      {
        <ul class="device-list">
          @foreach (var device in FilteredDevices)
          {
            var isSelected = _selectedDeviceIds.Contains(device.Id);

            <li class="@(isSelected ? "selected" : null)">
              <label>
                <input type="checkbox" checked="@isSelected" disabled="@_loadingDatasets" @onchange="args => ToggleDevice(device.Id, args)" />
                <span class="device-marker" aria-hidden="true"></span>
                <span class="device-text">
                  <span class="device-name">@device.Name</span>
                  <span class="device-id">@device.Type</span>
                </span>
              </label>
            </li>
          }
        </ul>
      }

      <section class="filter-panel" aria-label="Device state filters">
        <div class="filter-panel-header">
          <h4>Filters</h4>
          <button type="button" class="clear-button" @onclick="ClearFilters" disabled="@(!HasActiveFilters || _loadingDatasets)">
            Reset
          </button>
        </div>

        <div class="filter-stack">
          <div class="filter-row">
            <label class="filter-toggle">
              <input type="checkbox" disabled="@_loadingDatasets" @bind="_useStartTime" />
              <span>Start</span>
            </label>
            <RadzenDatePicker @bind-Value="_startTime" TValue="DateTime" ShowTime="true" HourFormat="24"
                              DateFormat="MM/dd/yyyy HH:mm" Disabled="@(!_useStartTime || _loadingDatasets)" Style="width: 100%;" />
          </div>

          <div class="filter-row">
            <label class="filter-toggle">
              <input type="checkbox" disabled="@_loadingDatasets" @bind="_useEndTime" />
              <span>End</span>
            </label>
            <RadzenDatePicker @bind-Value="_endTime" TValue="DateTime" ShowTime="true" HourFormat="24"
                              DateFormat="MM/dd/yyyy HH:mm" Disabled="@(!_useEndTime || _loadingDatasets)" Style="width: 100%;" />
          </div>

          <label class="filter-field">
            <span>Minimum Sample Interval</span>
            <RadzenTimeSpanPicker @bind-Value="_minimumSampleInterval" TValue="TimeSpan"
                                  Min="@TimeSpan.Zero" FieldPrecision="TimeSpanUnit.Millisecond"
                                  Disabled="@_loadingDatasets" Placeholder="Minimum elapsed time"
                                  Style="width: 100%;" />
          </label>

          <label class="filter-toggle">
            <input type="checkbox" disabled="@_loadingDatasets" @bind="_useCampaign" />
            <span>Campaign</span>
          </label>

          @if (_campaigns == null)
          {
            <div class="filter-loading">Loading campaigns...</div>
          }
          else
          {
            <RadzenDropDown Data="@_campaigns" TValue="string"
                            TextProperty="@nameof(CampaignDisplayItem.CampaignName)"
                            ValueProperty="@nameof(CampaignDisplayItem.SummaryId)" @bind-Value="_selectedCampaignId"
                            Change="@OnCampaignChanged" Disabled="@(!_useCampaign || _loadingDatasets)" AllowClear="true" Placeholder="Select campaign"
                            Style="width: 100%;">
              <Template Context="campaign">
                <div class="campaign-option">
                  <span class="campaign-option-name">@campaign.CampaignName</span>
                  <span class="campaign-option-meta">@campaign.TimeStartedDisplay</span>
                  <span class="campaign-option-meta">@campaign.Timezone</span>
                </div>
              </Template>
              <ValueTemplate Context="campaign">
                <div class="campaign-option selected-value">
                  <span class="campaign-option-name">@campaign.CampaignName</span>
                  <span class="campaign-option-meta">@campaign.TimeStartedDisplay · @campaign.Timezone</span>
                </div>
              </ValueTemplate>
            </RadzenDropDown>
          }

          <RadzenDropDown Data="@_experiments" TValue="string" TextProperty="@nameof(ExperimentDisplayItem.Name)"
                          ValueProperty="@nameof(ExperimentDisplayItem.Id)" @bind-Value="_selectedExperimentId"
                          Disabled="@(!_useCampaign || _experiments.Count == 0 || _loadingDatasets)" AllowClear="true"
                          Placeholder="@ExperimentPlaceholder" Style="width: 100%;" />

          <div class="filter-actions">
            <button type="button" class="apply-button" @onclick="ApplyFiltersAsync" disabled="@(!CanApply)">
              Apply
            </button>

            @if (_loadingDatasets)
            {
              <button type="button" class="cancel-button" @onclick="CancelDatasetLoad" disabled="@_cancelingDatasetLoad">
                @(_cancelingDatasetLoad ? "Canceling..." : "Cancel")
              </button>
            }
          </div>
        </div>
      </section>
    </aside>

    <div class="state-workspace">
      <section class="display-mode-panel" aria-label="Device state display mode">
        <label class="display-mode-field">
          <span>Display Mode</span>
          <RadzenDropDown Data="@_displayModes"
                          TValue="string"
                          @bind-Value="_selectedDisplayMode"
                          Change="@OnDisplayModeChanged"
                          Disabled="@_loadingDatasets"
                          Style="width: 12rem;" />
        </label>
      </section>

      <section class="state-panel" aria-label="Selected device state details">
        @if (_loadingDatasets)
        {
          <div class="loading-status">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" ShowValue="false" />
            <div>
              <strong>@(_cancelingDatasetLoad ? "Canceling..." : "Generating datasets...")</strong>
              <span>@(_hasApplied ? "Current results remain available until the new data is ready." : "Loading state data for the selected devices.")</span>
            </div>
            <button type="button" class="cancel-button compact" @onclick="CancelDatasetLoad" disabled="@_cancelingDatasetLoad">
              @(_cancelingDatasetLoad ? "Canceling..." : "Cancel")
            </button>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(_exportError))
        {
          <div class="export-error">
            <RadzenIcon Icon="error" />
            <span>@_exportError</span>
          </div>
        }

        @if (!_selectedDeviceIds.Any())
        {
          <div class="empty-state">
            <RadzenIcon Icon="query_stats" />
            <h4>No devices selected</h4>
            <p>Choose one or more devices.</p>
          </div>
        }
        else if (_loadingDatasets && !_hasApplied)
        {
          <div class="empty-state">
            <RadzenIcon Icon="hourglass_empty" />
            <h4>Loading device state data</h4>
            <p>Generating datasets for the selected devices and filters.</p>
          </div>
        }
        else if (!string.IsNullOrWhiteSpace(_datasetError))
        {
          <div class="empty-state error">
            <RadzenIcon Icon="error" />
            <h4>Unable to load data</h4>
            <p>@_datasetError</p>
          </div>
        }
        else if (!_hasApplied)
        {
          <div class="empty-state">
            <RadzenIcon Icon="table_view" />
            <h4>Apply filters to load data</h4>
            <p>Use Apply to generate tables for the selected devices.</p>
          </div>
        }
        else if (_appliedDisplayMode == "Wide")
        {
          @if (_wideDataset is null || _wideDataset.Rows.Count == 0)
          {
            <div class="empty-state">
              <RadzenIcon Icon="filter_alt_off" />
              <h4>No state data matched</h4>
              <p>No state data matched the selected devices and filters.</p>
            </div>
          }
          else
          {
            <div class="state-panel-header">
              <div>
                <h4>Wide Device State Table</h4>
                <span>@_wideDataset.Rows.Count timestamp row@(_wideDataset.Rows.Count == 1 ? string.Empty : "s") loaded</span>
              </div>
              <button type="button" class="export-button" @onclick="ExportCurrentViewAsync" disabled="@(!CanExport)">
                <RadzenIcon Icon="download" />
                <span>@(_exportingDataset ? "Exporting..." : "Export")</span>
              </button>
            </div>

            <div class="wide-dataset-table">
              <AresDatasetTable @key="_wideDataset" Dataset="@_wideDataset" />
            </div>
          }
        }
        else if (_appliedDisplayMode == "Long" && (_longDataset is null || _longDataset.Rows.Count == 0))
        {
          <div class="empty-state">
            <RadzenIcon Icon="filter_alt_off" />
            <h4>No state data matched</h4>
            <p>No state data matched the selected devices and filters.</p>
          </div>
        }
        else if (_appliedDisplayMode == "Long" && _longDataset is not null)
        {
          <div class="state-panel-header">
            <div>
              <h4>Long Device State Table</h4>
              <span>@_longDataset.Rows.Count state value@(_longDataset.Rows.Count == 1 ? string.Empty : "s") loaded</span>
            </div>
            <button type="button" class="export-button" @onclick="ExportCurrentViewAsync" disabled="@(!CanExport)">
              <RadzenIcon Icon="download" />
              <span>@(_exportingDataset ? "Exporting..." : "Export")</span>
            </button>
          </div>

          <div class="long-dataset-table">
            <AresDatasetTable @key="_longDataset" Dataset="@_longDataset" />
          </div>
        }
        else if (_deviceDatasets is null || _deviceDatasets.Length == 0)
        {
          <div class="empty-state">
            <RadzenIcon Icon="filter_alt_off" />
            <h4>No state data matched</h4>
            <p>No state data matched the selected devices and filters.</p>
          </div>
        }
        else
        {
          <div class="state-panel-header">
            <div>
              <h4>Device State Tables</h4>
              <span>@_deviceDatasets.Length device dataset@(_deviceDatasets.Length == 1 ? string.Empty : "s") loaded</span>
            </div>
            <button type="button" class="export-button" @onclick="ExportCurrentViewAsync" disabled="@(!CanExport)">
              <RadzenIcon Icon="download" />
              <span>@(_exportingDataset ? "Exporting..." : "Export")</span>
            </button>
          </div>

          <RadzenTabs Class="dataset-tabs" RenderMode="TabRenderMode.Server" @bind-SelectedIndex="_selectedDatasetTabIndex">
            <Tabs>
              @foreach (var dataset in _deviceDatasets)
              {
                <RadzenTabsItem Text="@dataset.Name">
                  <AresDatasetTable @key="dataset" Dataset="@dataset" />
                </RadzenTabsItem>
              }
            </Tabs>
          </RadzenTabs>
        }
      </section>
    </div>
    </div>
  </section>

@code {
  private static readonly string[] _displayModes = ["Separate", "Wide", "Long"];
  private List<DeviceDisplayItem>? _devices;
  private List<CampaignDisplayItem>? _campaigns;
  private List<ExperimentDisplayItem> _experiments = new();
  private AresDataset[]? _deviceDatasets;
  private AresDataset? _wideDataset;
  private AresDataset? _longDataset;
  private CancellationTokenSource? _datasetLoadCancellation;
  private readonly HashSet<string> _selectedDeviceIds = new();
  private string? _filterText;
  private string _selectedDisplayMode = _displayModes[0];
  private string _appliedDisplayMode = _displayModes[0];
  private string? _appliedFilterSignature;
  private string? _datasetError;
  private string? _exportError;
  private string? _selectedCampaignId;
  private string? _selectedExperimentId;
  private DateTime _startTime;
  private DateTime _endTime;
  private TimeSpan _minimumSampleInterval;
  private int _selectedDatasetTabIndex;
  private bool _useStartTime;
  private bool _useEndTime;
  private bool _useCampaign;
  private bool _loadingDatasets;
  private bool _cancelingDatasetLoad;
  private bool _exportingDataset;
  private bool _hasApplied;

  private int DeviceCount => _devices?.Count ?? 0;

  private bool CanApply => _selectedDeviceIds.Any() && !_loadingDatasets && !_exportingDataset;

  private bool CanExport =>
      !_loadingDatasets &&
      !_exportingDataset &&
      _appliedDisplayMode switch
      {
        "Long" => (_longDataset?.Rows.Count ?? 0) > 0,
        "Wide" => (_wideDataset?.Rows.Count ?? 0) > 0,
        "Separate" => _deviceDatasets?.Any(dataset => dataset.Rows.Count > 0) == true,
        _ => false
      };

  private bool HasActiveFilters =>
      _useStartTime ||
      _useEndTime ||
      _useCampaign ||
      _minimumSampleInterval > TimeSpan.Zero ||
      !string.IsNullOrWhiteSpace(_selectedCampaignId) ||
      !string.IsNullOrWhiteSpace(_selectedExperimentId);

  private string ExperimentPlaceholder =>
      string.IsNullOrWhiteSpace(_selectedCampaignId) ? "Select campaign first" : "Select experiment";

  private IEnumerable<DeviceDisplayItem> FilteredDevices
  {
    get
    {
      if (_devices is null)
      {
        return Enumerable.Empty<DeviceDisplayItem>();
      }

      if (string.IsNullOrWhiteSpace(_filterText))
      {
        return _devices;
      }

      return _devices.Where(device =>
          device.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
          device.Id.Contains(_filterText, StringComparison.OrdinalIgnoreCase));
    }
  }

  private int FilteredDeviceCount => FilteredDevices.Count();

  private IEnumerable<DeviceDisplayItem> SelectedDevices =>
      _devices?.Where(device => _selectedDeviceIds.Contains(device.Id)) ?? Enumerable.Empty<DeviceDisplayItem>();

  protected override async Task OnInitializedAsync()
  {
    SetDefaultFilterTimes();

    using var context = await DbContextFactory.CreateDbContextAsync();

    var deviceIds = await context.Set<DeviceState>()
        .Select(s => s.DeviceId)
        .Distinct()
        .ToListAsync();

    _devices = deviceIds
        .Select(id =>
        {
          var device = DeviceRepo.FirstOrDefault(d => d.UniqueId == id);
          return new DeviceDisplayItem(id, device?.Name ?? id, device?.Type ?? "Unknown");
        })
        .OrderBy(device => device.Name)
        .ThenBy(device => device.Id)
        .ToList();

    var campaignResponse = await AutomationClient.GetAvailableCampaignExecutionSummaries(new Empty(), null);
    var campaigns = await Task.WhenAll(campaignResponse.AvailableCampaignSummaries
        .Select(async campaignMetadata =>
        {
          var campaign = await AutomationClient.GetCampaignSummary(
              new CampaignExecutionSummaryRequest { SummaryId = campaignMetadata.SummaryId },
              null);

          return new CampaignDisplayItem(
              campaignMetadata.SummaryId,
              campaign.CampaignName,
              GetCampaignStartTime(campaign),
              GetCampaignTimezone(campaign),
              GetCampaignStartSortTime(campaign));
        }));

    _campaigns = campaigns
        .OrderByDescending(campaign => campaign.TimeStarted)
        .ToList();
  }

  private void ToggleDevice(string deviceId, ChangeEventArgs args)
  {
    if (_loadingDatasets)
    {
      return;
    }

    if (args.Value is true)
    {
      _selectedDeviceIds.Add(deviceId);
      return;
    }

    _selectedDeviceIds.Remove(deviceId);
  }

  private void ClearSelection()
  {
    if (_loadingDatasets)
    {
      return;
    }

    _selectedDeviceIds.Clear();
  }

  private async Task ApplyFiltersAsync()
  {
    if (!CanApply)
    {
      return;
    }

    _datasetLoadCancellation?.Cancel();
    _datasetLoadCancellation?.Dispose();
    _datasetLoadCancellation = new CancellationTokenSource();
    var cancellationToken = _datasetLoadCancellation.Token;

    _loadingDatasets = true;
    _cancelingDatasetLoad = false;
    _datasetError = null;
    _exportError = null;
    var pendingDisplayMode = _selectedDisplayMode;
    var pendingFilterSignature = CreateFilterSignature();

    StateHasChanged();
    await Task.Yield();

    try
    {
      var filter = CreateStateRequestFilter();
      var deviceDatasets = await Task.Run(
          async () => await DatasetGenerator.GenerateAsync(filter, cancellationToken).ConfigureAwait(false),
          cancellationToken);

      AresDataset? longDataset = null;
      AresDataset? wideDataset = null;
      if (pendingDisplayMode == "Long")
      {
        longDataset = await DeviceStateLongDatasetProjector.ProjectAsync(deviceDatasets, cancellationToken);
      }
      else if (pendingDisplayMode == "Wide")
      {
        wideDataset = await DeviceStateWideDatasetProjector.ProjectAsync(deviceDatasets, cancellationToken);
      }

      cancellationToken.ThrowIfCancellationRequested();
      _deviceDatasets = deviceDatasets;
      _wideDataset = wideDataset;
      _longDataset = longDataset;
      _appliedDisplayMode = pendingDisplayMode;
      _appliedFilterSignature = pendingFilterSignature;
      _selectedDatasetTabIndex = 0;
      _hasApplied = true;
    }
    catch (OperationCanceledException)
    {
      _datasetError = null;
    }
    catch (Exception ex)
    {
      _datasetError = ex.Message;
    }
    finally
    {
      _loadingDatasets = false;
      _cancelingDatasetLoad = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private void CancelDatasetLoad()
  {
    if (!_loadingDatasets || _cancelingDatasetLoad)
    {
      return;
    }

    _cancelingDatasetLoad = true;
    _datasetLoadCancellation?.Cancel();
  }

  private async Task ExportCurrentViewAsync()
  {
    if (!CanExport)
    {
      return;
    }

    _exportingDataset = true;
    _exportError = null;
    await InvokeAsync(StateHasChanged);
    await Task.Delay(50);

    try
    {
      var export = await Task.Run(CreateCurrentExport);

      await DatasetExportHelper.DownloadAsync(JS, export);
    }
    catch (Exception ex)
    {
      _exportError = $"Unable to export dataset: {ex.Message}";
    }
    finally
    {
      _exportingDataset = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private DatasetExport CreateCurrentExport()
  {
    return _appliedDisplayMode switch
    {
      "Long" when _longDataset is not null => DatasetExportHelper.CreateCsv(_longDataset, "device-state-long"),
      "Wide" when _wideDataset is not null => DatasetExportHelper.CreateCsv(_wideDataset, "device-state-wide"),
      "Separate" when _deviceDatasets is not null => DatasetExportHelper.CreateZip(_deviceDatasets, "device-state-separate"),
      _ => throw new InvalidOperationException("The current display mode does not have exportable data.")
    };
  }

  private async Task OnDisplayModeChanged(object? value)
  {
    if (value is string displayMode)
    {
      _selectedDisplayMode = displayMode;
    }

    if (_hasApplied && _deviceDatasets is not null && _appliedFilterSignature == CreateFilterSignature())
    {
      if (_selectedDisplayMode == "Long" && _longDataset is null)
      {
        await ProjectLongDatasetAsync();
        return;
      }

      if (_selectedDisplayMode == "Wide" && _wideDataset is null)
      {
        await ProjectWideDatasetAsync();
        return;
      }

      _appliedDisplayMode = _selectedDisplayMode;
      return;
    }

    if (CanApply)
    {
      await ApplyFiltersAsync();
    }
  }

  private DeviceStateRequestFilter CreateStateRequestFilter()
  {
    var filter = new DeviceStateRequestFilter();
    filter.DeviceIds.AddRange(_selectedDeviceIds);

    if (_useStartTime)
    {
      filter.Start = Timestamp.FromDateTime(_startTime.ToUniversalTime());
    }

    if (_useEndTime)
    {
      filter.End = Timestamp.FromDateTime(_endTime.ToUniversalTime());
    }

    if (_minimumSampleInterval > TimeSpan.Zero)
    {
      filter.Interval = Duration.FromTimeSpan(_minimumSampleInterval);
    }

    if (_useCampaign && !string.IsNullOrWhiteSpace(_selectedCampaignId))
    {
      filter.CompletedCampaignId = _selectedCampaignId;
    }

    if (_useCampaign && !string.IsNullOrWhiteSpace(_selectedExperimentId))
    {
      filter.CompletedExperimentId = _selectedExperimentId;
    }

    return filter;
  }

  private string CreateFilterSignature()
  {
    var signatureParts = new List<string>
    {
      string.Join(',', _selectedDeviceIds.OrderBy(id => id)),
      _useStartTime ? _startTime.ToUniversalTime().Ticks.ToString(CultureInfo.InvariantCulture) : string.Empty,
      _useEndTime ? _endTime.ToUniversalTime().Ticks.ToString(CultureInfo.InvariantCulture) : string.Empty,
      _minimumSampleInterval > TimeSpan.Zero ? _minimumSampleInterval.Ticks.ToString(CultureInfo.InvariantCulture) : string.Empty,
      _useCampaign ? _selectedCampaignId ?? string.Empty : string.Empty,
      _useCampaign ? _selectedExperimentId ?? string.Empty : string.Empty
    };

    return string.Join('|', signatureParts);
  }

  private async Task ProjectLongDatasetAsync()
  {
    if (_deviceDatasets is null || _longDataset is not null || _loadingDatasets)
    {
      return;
    }

    _datasetLoadCancellation?.Cancel();
    _datasetLoadCancellation?.Dispose();
    _datasetLoadCancellation = new CancellationTokenSource();
    var cancellationToken = _datasetLoadCancellation.Token;

    _loadingDatasets = true;
    _cancelingDatasetLoad = false;
    _datasetError = null;

    StateHasChanged();
    await Task.Yield();

    try
    {
      var longDataset = await DeviceStateLongDatasetProjector.ProjectAsync(_deviceDatasets, cancellationToken);

      cancellationToken.ThrowIfCancellationRequested();
      _longDataset = longDataset;
      _appliedDisplayMode = "Long";
    }
    catch (OperationCanceledException)
    {
      _datasetError = null;
      _selectedDisplayMode = _appliedDisplayMode;
    }
    catch (Exception ex)
    {
      _datasetError = ex.Message;
      _selectedDisplayMode = _appliedDisplayMode;
    }
    finally
    {
      _loadingDatasets = false;
      _cancelingDatasetLoad = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task ProjectWideDatasetAsync()
  {
    if (_deviceDatasets is null || _wideDataset is not null || _loadingDatasets)
    {
      return;
    }

    _datasetLoadCancellation?.Cancel();
    _datasetLoadCancellation?.Dispose();
    _datasetLoadCancellation = new CancellationTokenSource();
    var cancellationToken = _datasetLoadCancellation.Token;

    _loadingDatasets = true;
    _cancelingDatasetLoad = false;
    _datasetError = null;

    StateHasChanged();
    await Task.Yield();

    try
    {
      var wideDataset = await DeviceStateWideDatasetProjector.ProjectAsync(_deviceDatasets, cancellationToken);

      cancellationToken.ThrowIfCancellationRequested();
      _wideDataset = wideDataset;
      _appliedDisplayMode = "Wide";
    }
    catch (OperationCanceledException)
    {
      _datasetError = null;
      _selectedDisplayMode = _appliedDisplayMode;
    }
    catch (Exception ex)
    {
      _datasetError = ex.Message;
      _selectedDisplayMode = _appliedDisplayMode;
    }
    finally
    {
      _loadingDatasets = false;
      _cancelingDatasetLoad = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task OnCampaignChanged(object? value)
  {
    if (_loadingDatasets)
    {
      return;
    }

    _selectedExperimentId = null;
    _experiments = new List<ExperimentDisplayItem>();

    var campaignId = value?.ToString();
    if (string.IsNullOrWhiteSpace(campaignId))
    {
      return;
    }

    var campaign = await AutomationClient.GetCampaignSummary(
        new CampaignExecutionSummaryRequest { SummaryId = campaignId },
        null);
    _experiments = campaign.ExperimentSummaries
        .Select((experiment, index) => new ExperimentDisplayItem(
            GetExperimentId(experiment, index),
            GetExperimentName(experiment, index)))
        .ToList();
  }

  private void ClearFilters()
  {
    if (_loadingDatasets)
    {
      return;
    }

    _useStartTime = false;
    _useEndTime = false;
    _useCampaign = false;
    _minimumSampleInterval = TimeSpan.Zero;
    _selectedCampaignId = null;
    _selectedExperimentId = null;
    _experiments.Clear();
    SetDefaultFilterTimes();
  }

  private void SetDefaultFilterTimes()
  {
    var currentTime = DateTime.Now;
    var truncatedTime = new DateTime(currentTime.Ticks - currentTime.Ticks % TimeSpan.TicksPerMinute);
    _startTime = truncatedTime - TimeSpan.FromHours(1);
    _endTime = truncatedTime;
  }

  private static string GetExperimentId(ExperimentExecutionSummary experiment, int index)
  {
    if (experiment.ExperimentOverview?.HasUniqueId == true)
    {
      return experiment.ExperimentOverview.UniqueId;
    }

    if (experiment.HasUniqueId)
    {
      return experiment.UniqueId;
    }

    return !string.IsNullOrWhiteSpace(experiment.ExperimentId)
        ? experiment.ExperimentId
        : index.ToString();
  }

  private static string GetExperimentName(ExperimentExecutionSummary experiment, int index)
  {
    var templateName = experiment.ExperimentOverview?.Template?.Name;
    return !string.IsNullOrWhiteSpace(templateName)
        ? templateName
        : $"Experiment {index + 1}";
  }

  private static string GetCampaignStartTime(CampaignExecutionSummary campaign)
  {
    return campaign.ExecutionInfo?.TimeStarted is { } timeStarted
        ? timeStarted.ToReadableTimestamp()
        : "Unknown start";
  }

  private static string GetCampaignTimezone(CampaignExecutionSummary campaign)
  {
    return !string.IsNullOrWhiteSpace(campaign.ExecutionInfo?.Timezone)
        ? campaign.ExecutionInfo.Timezone
        : "Unknown timezone";
  }

  private static DateTime GetCampaignStartSortTime(CampaignExecutionSummary campaign)
  {
    return campaign.ExecutionInfo?.TimeStarted?.ToDateTime() ?? DateTime.MinValue;
  }

  public void Dispose()
  {
    _datasetLoadCancellation?.Cancel();
    _datasetLoadCancellation?.Dispose();
  }

  private record DeviceDisplayItem(string Id, string Name, string Type);

  private record CampaignDisplayItem(
      string SummaryId,
      string CampaignName,
      string TimeStartedDisplay,
      string Timezone,
      DateTime TimeStarted);

  private record ExperimentDisplayItem(string Id, string Name);

}
