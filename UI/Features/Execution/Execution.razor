@page "/automation/execution"
@using System.Collections.ObjectModel
@using Ares.Datamodel
@using Ares.Services
@using Ares.Core.Grpc.Services
@using Google.Protobuf.WellKnownTypes
@using UI.Domain.Execution
@using UI.Application.Notifications
@using UI.Features.Execution.Components
@using UI.Features.Execution.Planning
@using UI.Infrastructure.Grpc
@inject ContextMenuService ContextMenuService
@inject AutomationService AutomationClient
@inject Radzen.DialogService DialogService
@implements IDisposable
@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<ExecutionViewModel>
@rendermode InteractiveServer

<PageTitle>Execution</PageTitle>

<RadzenSplitter Orientation="Orientation.Horizontal" style="height: 100%; border: 1px solid #444;"> 
    <RadzenSplitterPane Size="30%" Min="20%" Max="50%">
        <RadzenSplitter Orientation="Orientation.Vertical">
            <div class="rounded-2 p-2 padded-item">
              <div class="d-flex flex-row">
                <RadzenLabel Text="@(ViewModel!.DisplayExecutionSummary ? "Experiment Status" : "Campaign Setup")" Component="PreviewDisplayToggle" Style="font-size: larger;" />
                <RadzenSwitch @bind-Value="ViewModel!.DisplayExecutionSummary" Name="PreviewDisplayToggle" Style="margin-left: 1rem; align-items: center" />
              </div>
            </div>

            @if(ViewModel!.DisplayExecutionSummary)
            {
              <div class="p-3" style="overflow-y: auto; height: 100%;">
                <ExperimentTree ViewModel="@ViewModel" />
              </div>
            }

            else
            {
              <div class="p-3">
                <ExecutionControls ViewModel="@ViewModel" />
                <hr />
                <CampaignConfig ViewModel="@ViewModel" />
              </div>
            }
        </RadzenSplitter>
    </RadzenSplitterPane>

    <RadzenSplitterPane Size="70%">
        <div class="p-3 d-flex flex-column" style="height: 100%;">
            @if(ViewModel!.CampaignExecutionState == ExecutionState.WaitingForUserDecision)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Medium" Style="margin-bottom: 1rem;">
                    <ChildContent>
                        <div class="d-flex flex-row align-items-center justify-content-between">
                            <div style="flex-grow: 1;">
                                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H4" Style="margin: 0;"><strong>Action Required:</strong></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2">An error occurred during execution. Please select how you would like to proceed.</RadzenText>
                            </div>
                            <div class="d-flex flex-row gap-2">
                                <RadzenButton Text="Retry" Icon="replay" Click="@(() => ViewModel.SubmitUserDecision(ErrorHandling.RetryExperiment))" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
                                <RadzenButton Text="Replan" Icon="psychology" Click="@(() => ViewModel.SubmitUserDecision(ErrorHandling.Replan))" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Medium" />
                                <RadzenButton Text="Safe Mode" Icon="security" Click="@(() => ViewModel.SubmitUserDecision(ErrorHandling.EnterSafeMode))" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Medium" />
                                <RadzenButton Text="Stop" Icon="stop" Click="@(() => ViewModel.SubmitUserDecision(ErrorHandling.StopAndCloseout))" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Medium" />
                            </div>
                        </div>
                    </ChildContent>
                </RadzenAlert>
            }
            <h3>Live Execution Data</h3>
            <div style="flex-grow: 1; min-height: 0; overflow: hidden;">
                <ExecutionChart ViewModel="@ViewModel" />
            </div>
        </div>
    </RadzenSplitterPane>

  <div class="side-drawer @(ViewModel!.CampaignExecutionState == ExecutionState.AwaitingUser ? "drawer-open" : "")">
    <!-- Inner wrapper with fixed width prevents text wrapping during animation -->
    <div class="drawer-content col-lg">
      <RadzenCard Class="drawer-inner-card" Style="height: inherit">
        <RadzenStack Gap="1rem">
          <RadzenText TextStyle="TextStyle.H5">User Confirmation Required</RadzenText>

          <RadzenAlert Severity="Severity.Info" ShowIcon="true" Variant="Variant.Flat">
            ARES requires user approval to continue experimenting. Continue by hitting "Confirm" or play. You can also stop your experiment by hitting the stop button.
          </RadzenAlert>

          <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Class="mt-4">
            <RadzenButton Text="Confirm" ButtonStyle="ButtonStyle.Success" Click="@ViewModel.ResumeCampaign" />
          </RadzenStack>
        </RadzenStack>
      </RadzenCard>
    </div>
  </div>

</RadzenSplitter>

@code {
  protected override async Task OnInitializedAsync()
  {
    ViewModel!.StateChanged += InvokeStateHasChanged;
    await ViewModel!.RefreshCampaigns();
    await ViewModel!.SelectCampaignTemplate(ViewModel!.SelectedTemplateSummary);
    await ViewModel!.UpdateCurrentTemplate();
    await ViewModel!.GetAllTags();
    ViewModel!.StartWatchingTelemetry();
    await ViewModel!.RefreshExecutionContext();
  }

  private void InvokeStateHasChanged()
  {
    InvokeAsync(StateHasChanged);
  }
}






