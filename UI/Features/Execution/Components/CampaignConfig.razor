@using Ares.Datamodel
@rendermode InteractiveServer

<div class="d-flex flex-column gap-3" style="color: #fff;">
    
  <div>
    <RadzenLabel Text="Desired Number of Experiments" Component="experimentsInput" Style="margin-bottom: 5px; display: block;" />
    <div class="d-flex gap-2">
      <RadzenNumeric @bind-Value="ViewModel!.ExperimentsToRun" Name="experimentsInput" class="w-100" />
      <RadzenButton Text="SET" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="ViewModel!.SetExperimentsToRun"/>
    </div>
  </div>

  <div>
    <RadzenLabel Text="Desired Result" Component="desiredResultInput" Style="margin-bottom: 5px; display: block;" />
    <div class="d-flex gap-2">
      <RadzenNumeric @bind-Value="ViewModel!.DesiredResult" Name="desiredResultInput" class="w-50" />
      <span>±</span>
      <RadzenNumeric @bind-Value="ViewModel!.DesiredLeeway" class="w-50" />
    </div>
  </div>

  <div>
    <RadzenLabel Text="Re-Planning Rate" Component="replanningInput" Style="margin-bottom: 5px; display: block;" />
    <div class="d-flex gap-2">
      <RadzenNumeric @bind-Value="ViewModel!.DesiredReplicationRate" Name="replanningInput" class="w-100" />
      <RadzenButton Text="SET" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="ViewModel!.SetReplanRate"/>
    </div>
  </div>

  <div>
    <RadzenLabel Text="Experiment Notes" Style="margin-bottom: 5px; display: block;" />
    <RadzenTextArea @bind-Value="ViewModel!.ExecutionNotes" class="w-100" Rows="4" />
    <RadzenButton Text="Upload Notes" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" class="mt-2" />
  </div>
  <div>
    <h6>Experiment Tags</h6>
    <RadzenDropDown Data="ViewModel!.AvailableTags" 
                    @bind-Value="ViewModel!.SelectedTags"
                    Multiple=true 
                    Placeholder="Select Experiment Tags" 
                    AllowClear=true 
                    Style="width: 100%;" 
                    Chips=true 
                    AllowSelectAll=false>
      <ValueTemplate>
        @((context.TagName as string))
      </ValueTemplate>
      <Template>
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
          @((context.TagName as string))
          <RadzenButton Click="@(() => ViewModel!.RemoveTag((context as AresCampaignTag)))" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" @onclick:stopPropagation=true />
        </div>
      </Template>
    </RadzenDropDown>
  </div>

  <div class="d-flex align-items-center mt-2" style="width: 100%">
    <RadzenTextBox @bind-Value="ViewModel!.NewTagName"
                   Placeholder="Add new tag"
                   Style="flex-grow: 1; margin-right: 8px;" />

    <RadzenButton Icon="add" Text="Add" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                  Click="@ViewModel!.AddTag" />
  </div>

</div>

@code {
  [Parameter]
  public ExecutionViewModel? ViewModel { get; set; }

  public void Test()
  {
    Console.WriteLine("Hello :)");
  }
}