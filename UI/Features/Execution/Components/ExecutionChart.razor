@using Ares.Datamodel.Visualizing.Local
@using UI.Features.Execution.Planning
@using UI.Features.Visualization.ViewModels
@using UI.Features.Visualization.Views
@rendermode InteractiveServer

@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 100%; height: 100%; overflow-y: auto; padding-right: 10px;">
  <RadzenCard Variant="Variant.Outlined" Style="flex: 1 1 auto; min-height: 450px; display: flex; flex-direction: column;">
    <RadzenColumn Style="flex: 1; display: flex; flex-direction: column;">
      <RadzenText TextStyle="TextStyle.H6" Class="rz-mb-4">Planner Data</RadzenText>
      
      @if(ViewModel!.PlannerAdapterInfos.Any(p => p.Name == "Manual Planner"))
      {
        <ManualPlanner />
      }

      else
      {
        <RadzenChart Style="flex: 1; width: 100%;">
          <RadzenChartTooltipOptions Shared="false" />
          @foreach (var plannerSeries in ViewModel!.PlannerMetricsMap)
          {
            var currentSeries = plannerSeries;
            <RadzenLineSeries Data="@currentSeries.Value"
            TItem="ChartMetricPoint"
            CategoryProperty="ExecutionIndex"
            ValueProperty="PlotValue"
            Title="@($"Planner: {currentSeries.Key}")">
              <ChildContent>
                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Size="6" />
              </ChildContent>

              <TooltipTemplate Context="data">
                <div style="background-color: #333; border: 1px solid #555; padding: 8px; border-radius: 4px;">
                  <span style="color: #aaa;">@currentSeries.Key: </span>
                  <strong style="color: #fff;">@data.RawValue</strong>
                </div>
              </TooltipTemplate>
            </RadzenLineSeries>
          }
          <RadzenCategoryAxis Step="1">
          </RadzenCategoryAxis>

          <RadzenValueAxis Min="0" Max="100" Step="25">
            <RadzenGridLines Visible="false" />
          </RadzenValueAxis>
        </RadzenChart>
      }

      <RadzenText TextStyle="TextStyle.H6" class="rz-mb-4" Style="padding-top: 1rem">Objective Score</RadzenText>
      <RadzenChart Style="height: 200px; width: 100%;">
        @if (ViewModel?.AnalyzerMetrics != null)
        {
          <RadzenLineSeries Data="@ViewModel.AnalyzerMetrics"
                            CategoryProperty="ExecutionIndex"
                            ValueProperty="RawValue"
                            Title="Analyzer Output"
                            Stroke="#FFC0CB">
            <RadzenMarkers MarkerType="MarkerType.Square" />
          </RadzenLineSeries>
        }

        <RadzenCategoryAxis Step="1">
        </RadzenCategoryAxis>
      </RadzenChart>

            
    </RadzenColumn>
  </RadzenCard>

  <RadzenCard Variant="Variant.Outlined" Style="height: 55%">
        
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
      <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Device Monitoring</RadzenText>
            
      <RadzenSelectBar @bind-Value="ViewMode" Size="ButtonSize.Small">
        <Items>
          <RadzenSelectBarItem Value="1" Text="Single View" Icon="crop_square" />
          <RadzenSelectBarItem Value="2" Text="Dual View" Icon="view_column" />
        </Items>
      </RadzenSelectBar>
    </RadzenStack>

    <RadzenRow Gap="1rem">
      <RadzenColumn Size="12" SizeMD="@(ViewMode == 1 ? 12 : 6)">
        @if(ViewModel!.ChartA is not null)
        {
          <VisualizationItem ViewModel="ViewModel!.ChartA" />
        }
        else
        {
          <RadzenCard Variant="Variant.Outlined" Style="display: flex; align-items: center; justify-content: center; border-style: dashed;">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
              <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">Empty Chart Slot</RadzenText>
              <RadzenButton Icon="add" Text="Add Chart" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenChartSelector("A"))" />
            </RadzenStack>
          </RadzenCard>
        }
      </RadzenColumn>

      @if(ViewMode == 2)
      {
        <RadzenColumn Size="12" SizeMD="6">
          @if(ViewModel!.ChartB is not null)
          {
            <VisualizationItem ViewModel="ViewModel!.ChartB" />
          }
          else
          {
            <RadzenCard Variant="Variant.Outlined" Style="display: flex; align-items: center; justify-content: center; border-style: dashed;">
              <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color);">Empty Chart Slot</RadzenText>
                <RadzenButton Icon="add" Text="Add Chart" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenChartSelector("B"))" />
              </RadzenStack>
            </RadzenCard>
          }
        </RadzenColumn>
      }

    </RadzenRow>
  </RadzenCard>

</RadzenStack>

@code {
  [Parameter]
  public ExecutionViewModel? ViewModel { get; set; }
  public int ViewMode { get; set; } = 1;

  private async Task OpenChartSelector(string slotId)
  {
    var result = await DialogService.OpenAsync<AddChartDialog>("Configure Visualization", new Dictionary<string, object?>(), new DialogOptions()
      {
        Width = "900px",
        Height = "850px",
        Resizable = true,
        Draggable = true
      });

    if(result is not null && result is DeviceVisualizationConfig dvc)
    {
      if(slotId == "A")
      {
        ViewModel!.ChartConfigA = dvc;
        await ViewModel!.UpdateDeviceChartA();
      }

      if(slotId == "B")
      {
        ViewModel!.ChartConfigB = dvc;
        await ViewModel!.UpdateDeviceChartB();
      }
    }

    StateHasChanged();
  }
}