@page "/automation/custom-commands"
@using Ares.Core.CustomCommands
@using Ares.Core.CustomCommands.Exchange
@using Ares.Services
@inject DialogService DialogService
@using Microsoft.AspNetCore.Components.Forms
@using UI.Application.Notifications
@inject ICustomCommandPersistenceService CustomCommandService
@inject ICustomCommandTransferService CustomCommandTransferService
@inject IAresUINotificationService NotificationService
@inject IJSRuntime JS

<PageTitle>Custom Commands</PageTitle>

<section class="custom-command-list">
  <div class="custom-command-list__header">
    <div>
      <h3 class="custom-command-list__title">Custom Commands</h3>
      <p class="custom-command-list__subtitle">Select a custom command to edit or start a new definition.</p>
    </div>

    <div class="custom-command-list__actions">
      <a class="m-1 d-flex align-items-center btn btn-outline-light" href="automation/custom-command-builder" title="New custom command">
        <RadzenIcon Icon="add" />
      </a>
      <InputFile id="custom-command-import" class="d-none" accept=".json,.arescommand.json,application/json" OnChange="ImportCommandAsync" />
      <label class="m-1 d-flex align-items-center btn btn-outline-light" for="custom-command-import" title="Import custom command">
        <RadzenIcon Icon="upload" />
      </label>
      <button class="m-1 btn btn-outline-light" type="button" title="Refresh custom commands" disabled="@_isLoading" @onclick="LoadCommandsAsync">
        <RadzenIcon Icon="refresh" />
      </button>
    </div>
  </div>

  @if(_isLoading)
  {
    <div class="custom-command-list__state">Loading custom commands...</div>
  }
  else if(!string.IsNullOrWhiteSpace(_loadError))
  {
    <div class="custom-command-list__state custom-command-list__state--error">@_loadError</div>
  }
  else if(_commands.Count == 0)
  {
    <div class="custom-command-list__state">No custom commands have been saved yet.</div>
  }
  else
  {
    <div class="custom-command-list__table-wrapper">
      <table class="custom-command-list__table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Inputs</th>
            <th>Output</th>
            <th aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody>
          @foreach(var command in _commands)
          {
            <tr>
              <td>
                <a class="custom-command-list__name-link" href="@($"automation/custom-command-builder/{command.Id}")">
                  @command.Name
                </a>
              </td>
              <td>@command.Description</td>
              <td>@command.InputSummary</td>
              <td>@command.OutputSummary</td>
              <td>
                <div class="custom-command-list__row-actions">
                  <a class="mx-1 btn btn-outline-light" href="@($"automation/custom-command-builder/{command.Id}")" title="@($"Edit {command.Name}")">
                    <RadzenIcon Icon="edit" />
                  </a>
                  <button class="mx-1 btn btn-outline-light" type="button" title="@($"Export {command.Name}")" @onclick="() => ExportCommandAsync(command)">
                    <RadzenIcon Icon="download" />
                  </button>
                  <button class="mx-1 btn btn-outline-light"
                          type="button"
                          title="@($"Delete {command.Name}")"
                          disabled="@_isDeleting"
                          @onclick="() => DeleteCommandAsync(command)">
                    <RadzenIcon Icon="delete" />
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>

@code {
  private IReadOnlyList<CustomCommandSummary> _commands = [];
  private bool _isLoading;
  private bool _isDeleting;
  private bool _isImporting;
  private string? _loadError;
  private const long MaximumImportFileSize = 5 * 1024 * 1024;

  protected override async Task OnInitializedAsync()
  {
    await LoadCommandsAsync();
  }

  private async Task LoadCommandsAsync()
  {
    _isLoading = true;
    _loadError = null;

    try
    {
      _commands = await CustomCommandService.GetSummariesAsync();
    }
    catch(Exception ex)
    {
      _loadError = $"Failed to load custom commands. {ex.Message}";
      NotificationService.PushNotification(new AresNotification 
      { 
        Title = "Error Loading Custom Command", 
        Message = _loadError, 
        NotificationSeverity = Severity.Error 
      });
    }
    finally
    {
      _isLoading = false;
    }
  }

  private async Task ExportCommandAsync(CustomCommandSummary command)
  {
    try
    {
      var export = await CustomCommandTransferService.ExportAsync(command.Id);
      if(export is null)
        throw new InvalidOperationException($"Custom command '{command.Name}' could not be found.");

      await JS.InvokeVoidAsync("downloadJsonFile", export.SuggestedFileName, export.Json);
    }
    catch(Exception ex)
    {
      NotificationService.PushNotification(new AresNotification
      {
        Title = "Failed to Export Custom Command",
        Message = ex.Message,
        NotificationSeverity = Severity.Error
      });
    }
  }

  private async Task ImportCommandAsync(InputFileChangeEventArgs args)
  {
    if(_isImporting || args.File is null)
      return;

    _isImporting = true;
    try
    {
      if(args.File.Size > MaximumImportFileSize)
        throw new CustomCommandImportException("Custom command files must be 5 MiB or smaller.");

      await using var stream = args.File.OpenReadStream(MaximumImportFileSize);
      using var reader = new StreamReader(stream);
      var result = await DialogService.OpenAsync<CustomCommandImportWizard>("Import Custom Command", new Dictionary<string, object?>
      {
        [nameof(CustomCommandImportWizard.Json)] = await reader.ReadToEndAsync()
      }, new DialogOptions
      {
        Width = "800px",
        Height = "85vh",
        Resizable = true,
        Draggable = true,
        ShowClose = false,
        ShowTitle = false
      });
      if(result is not CustomCommandImportResult importedResult)
        return;

      NotificationService.PushNotification(new AresNotification
      {
        Title = "Custom Command Imported",
        Message = $"Imported '{importedResult.CommandName}' as a new custom command.",
        NotificationSeverity = Severity.Success
      });
      await LoadCommandsAsync();
    }
    catch(Exception ex)
    {
      NotificationService.PushNotification(new AresNotification
      {
        Title = "Failed to Import Custom Command",
        Message = ex.Message,
        NotificationSeverity = Severity.Error
      });
    }
    finally
    {
      _isImporting = false;
    }
  }

  private async Task DeleteCommandAsync(CustomCommandSummary command)
  {
    _isDeleting = true;

    try
    {
      await CustomCommandService.DeleteAsync(command.Id);
      NotificationService.PushNotification(new AresNotification
      {
        Title = "Custom Command Deleted",
        Message = $"Deleted custom command '{command.Name}'.",
        NotificationSeverity = Severity.Success
      });
      await LoadCommandsAsync();
    }
    catch(Exception ex)
    {
      NotificationService.PushNotification(new AresNotification
      {
        Title = $"Failed to delete custom command '{command.Name}'.",
        Message = ex.Message,
        NotificationSeverity = Severity.Error
      });
    }
    finally
    {
      _isDeleting = false;
    }
  }
}
