<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE0305;IDE0290;3270;CA1860</NoWarn>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalAresDatamodel)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\ARES-datamodel\dotnet\ARES.Datamodel\ARES.Datamodel.csproj"
                      Condition="'@(PackageReference->AnyHaveMetadataValue('Identity', 'ARES.Datamodel'))' == 'true'" />
    <PackageReference Remove="ARES.Datamodel" />
  </ItemGroup>
</Project>
