<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\demo_planner.proto" />
  </ItemGroup>

  <PropertyGroup>
    <DataModelProtoPath>$(PkgAres_DataModel_dll)\Proto\</DataModelProtoPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ares.Core" Version="2024.6.14.134311" />
    <PackageReference Include="Ares.DataModel.dll" Version="2024.6.14.134141" GeneratePathProperty="True" />
    <PackageReference Include="Grpc.Net.Client" Version="2.61.0" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\demo_planner.proto" GrpcServices="Client">
      <AdditionalImportDirs>$(DataModelProtoPath)</AdditionalImportDirs>
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
  </ItemGroup>

</Project>
